# Copy this file to .env only when the future backend is initialized.
# Never commit the real .env file or add real credentials here.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001

# Proposed by ADR 0002. Use a dedicated local development database.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=competence_hub
DB_USER=competence_hub_app
DB_PASSWORD=
DB_SSL_MODE=disable

# Generate real values interactively for each environment. Never reuse them.
AUTH_IDENTIFIER_HMAC_KEY=
AUTH_TOTP_ENCRYPTION_KEY=
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
