---
import BaseLayout from "../layouts/BaseLayout.astro";
import { coaches } from "virtual:coach-projection";
import { categoryLabels } from "../../config/coach-projection.mjs";
import "../styles/global.css";
import "./projection.css";
const url = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
const topics = [...new Set(coaches.flatMap((coach) => coach.topics.map((topic) => topic.name)))];
---
<BaseLayout title="Coach-Netzwerk | Competence Hub" noindex={true} canonical={false}>
  <main class="subpage projection" data-projection-directory>
    <header class="projection-heading"><p class="eyebrow">Competence Hub</p><h1>Coach-Netzwerk</h1></header>
    <div class="projection-filters" data-filters>
      <label>Kategorie<select name="category" aria-controls="projection-results"><option value="">Alle Kategorien</option>
        {Object.entries(categoryLabels).map(([id, label]) => <option value={id}>{label}</option>)}
      </select></label>
      <label>Thema<select name="topic" aria-controls="projection-results"><option value="">Alle Themen</option>
        {topics.map((topic) => <option value={topic}>{topic}</option>)}
      </select></label>
    </div>
    <p role="status" aria-live="polite" aria-atomic="true" data-results-status>{coaches.length} Coach-Profile</p>
    <section class="projection-grid" id="projection-results" aria-label="Coach-Profile">
      {coaches.map((coach) => <article class="projection-card" data-projected-coach data-topics={JSON.stringify(coach.topics)}>
        <div class="projection-card-media">
          {coach.assets[0] ? <img src={url(coach.assets[0].reference)} alt={coach.assets[0].alt_text} width={coach.presentation?.portrait_width ?? 400} height={coach.presentation?.portrait_height ?? 500} />
            : <span class="projection-monogram" role="img" aria-label={`Kein Porträt: ${coach.display_name}`}>{coach.initials}</span>}
        </div>
        <div><h2>{coach.display_name}{coach.academic_suffix && `, ${coach.academic_suffix}`}</h2>
          {(coach.roles?.length ?? 0) > 0 && <p data-roles>{coach.roles?.map((role) => role.label).join(" · ")}</p>}
          <p>{coach.presentation?.teaser || coach.short_intro}</p>
          <ul class="tag-list">{coach.topics.map((topic) => <li>{topic.name}</li>)}</ul>
          <a class="button button--ghost" href={url(coach.route)}>Profil ansehen<span class="projection-sr-only">: {coach.display_name}</span></a>
        </div>
      </article>)}
    </section>
    <p data-empty hidden={coaches.length > 0}>Keine Coach-Profile für diese Auswahl.</p>
  </main>
</BaseLayout>
<script is:inline>
  (() => {
    const root = document.querySelector('[data-projection-directory]');
    if (!root) return;
    const category = root.querySelector('[name=category]');
    const topic = root.querySelector('[name=topic]');
    const cards = [...root.querySelectorAll('[data-projected-coach]')];
    const apply = () => {
      let count = 0;
      for (const card of cards) {
        const topics = JSON.parse(card.dataset.topics);
        const visible = (!category.value && !topic.value) || topics.some(item =>
          (!category.value || item.categories.includes(category.value)) && (!topic.value || item.name === topic.value));
        card.hidden = !visible;
        if (visible) count++;
      }
      root.querySelector('[data-results-status]').textContent = `${count} Coach-Profile`;
      root.querySelector('[data-empty]').hidden = count > 0;
    };
    category.addEventListener('change', apply);
    topic.addEventListener('change', apply);
  })();
</script>
