---
import Icon from "./Icon.astro";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const steps = [
  {
    number: "01",
    node: "Anliegen",
    eyebrow: "Ihr Ausgangspunkt",
    title: "Wir beginnen mit dem, was Sie wirklich beschäftigt.",
    text: "Führung, Zusammenarbeit, Gesundheit oder Personalentwicklung: Zuerst klären wir Anlass, Zielgruppe und gewünschte Wirkung.",
    compactText: "Wir klären, was Sie erreichen möchten und für wen.",
    href: "unternehmen",
    link: "Anliegen einordnen",
    icon: "building" as const,
    x: 50,
    y: 10,
  },
  {
    number: "02",
    node: "Expertise",
    eyebrow: "Ausgewähltes Netzwerk",
    title: "Das Anliegen führt zur passenden Expertise.",
    text: "Nicht jedes Thema braucht dieselbe Perspektive. Der Hub verbindet Ihren Bedarf mit qualifizierten Coaches und nachvollziehbaren Schwerpunkten.",
    compactText: "Wir finden Coaches mit dem passenden Schwerpunkt.",
    href: "coaches",
    link: "Coaches kennenlernen",
    icon: "users" as const,
    x: 88,
    y: 50,
  },
  {
    number: "03",
    node: "Format",
    eyebrow: "Passender Rahmen",
    title: "Expertise wird zum passenden Format.",
    text: "Beratungsgespräch, Businesscoaching oder Gruppenformat werden so gewählt, dass sie zu Zielgruppe, Situation und Zielsetzung passen.",
    compactText: "Ob Beratung, Coaching oder Workshop: Ihr Ziel bestimmt den Rahmen.",
    href: "leistungen",
    link: "Formate ansehen",
    icon: "briefcase" as const,
    x: 50,
    y: 90,
  },
  {
    number: "04",
    node: "Begleitung",
    eyebrow: "Persönliche Verbindung",
    title: "Eine Ansprechpartnerin hält den Weg zusammen.",
    text: "Frau Rappelt begleitet die Abstimmung zwischen Unternehmen und Coaches und bleibt für den nächsten Schritt persönlich ansprechbar.",
    compactText: "Frau Rappelt begleitet die Abstimmung und bleibt ansprechbar.",
    href: "kontakt",
    link: "Bedarf besprechen",
    icon: "message-circle" as const,
    x: 12,
    y: 50,
  },
];

const connections = [
  "M300 300 Q300 190 300 76",
  "M300 300 Q410 300 524 300",
  "M300 300 Q300 410 300 524",
  "M300 300 Q190 300 76 300",
];
---

<section
  class:list={["hub-journey", { "hub-journey--compact": compact }]}
  id="so-funktioniert-der-hub"
  data-hub-journey
  aria-labelledby="hub-journey-title"
>
  <header class="hub-journey__heading">
    <p class="eyebrow">So wächst die Verbindung</p>
    <h2 id="hub-journey-title">Vom ersten Anliegen zur passenden Begleitung.</h2>
    {!compact && <p>
      Der Competence Hub macht aus vielen Möglichkeiten einen nachvollziehbaren
      Weg mit persönlicher Verantwortung.
    </p>}
  </header>

  <div class="hub-journey__layout">
    {!compact && <div class="hub-journey__visual">
      <div class="hub-journey__stage">
        <svg viewBox="0 0 600 600" focusable="false" aria-hidden="true">
          <circle class="hub-journey__orbit" cx="300" cy="300" r="214" />
          {connections.map((connection, index) => (
            <path
              class="hub-journey__connection"
              d={connection}
              pathLength="1"
              data-journey-connection={index + 1}
            />
          ))}
        </svg>

        <div class="hub-journey__core" aria-hidden="true">
          <span>Competence</span>
          <strong>Hub</strong>
        </div>

        {steps.map((step, index) => (
          <a
            class="hub-journey__node"
            href={`#hub-journey-step-${index + 1}`}
            aria-label={`Zum Schritt ${step.number} ${step.node} springen`}
            style={__WEBSITE_V2_LOCAL__ ? undefined : `--journey-x: ${step.x}%; --journey-y: ${step.y}%;`}
            data-journey-node={index + 1}
          >
            <Icon name={step.icon} size={25} />
            <strong>{step.node}</strong>
          </a>
        ))}{__WEBSITE_V2_LOCAL__ && <style is:inline set:html={steps.map((step, index) =>
          `[data-journey-node="${index + 1}"] { --journey-x: ${step.x}%; --journey-y: ${step.y}%; }`
        ).join("\n")} />}
      </div>
    </div>}

    <ol class="hub-journey__steps" role={compact ? "list" : undefined}>
      {steps.map((step, index) => (
        <li
          id={`hub-journey-step-${index + 1}`}
          data-journey-step={index + 1}
          aria-current={!compact && index === 0 ? "step" : undefined}
        >
          {compact ? (
            <>
              {index < steps.length - 1 && (
                <span class="hub-journey__track" aria-hidden="true">
                  <span class="hub-journey__fill" data-journey-fill></span>
                </span>
              )}
              <span class="hub-journey__milestone" aria-hidden="true">{step.number}</span>
              <div class="hub-journey__summary">
                <h3>{step.node}</h3>
                <p>{step.compactText}</p>
                <a class="text-link" href={url(step.href)}>
                  {step.link}
                  <Icon name="arrow-right" size={18} />
                </a>
              </div>
            </>
          ) : (
            <>
              <span class="hub-journey__number">{step.number}</span>
              <Icon name={step.icon} size={30} />
              <p class="eyebrow">{step.eyebrow}</p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <a class="text-link" href={url(step.href)}>
                {step.link}
                <Icon name="arrow-right" size={18} />
              </a>
            </>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  function trackCompactJourney(journey: HTMLElement) {
    const steps = [...journey.querySelectorAll<HTMLElement>("[data-journey-step]")];
    const fills = [...journey.querySelectorAll<HTMLElement>("[data-journey-fill]")];
    const events = new AbortController();
    let frame = 0;
    let active: number | undefined;

    const update = () => {
      frame = 0;
      // Use each anchor's own scroll alignment. On desktop the markers share
      // one row but cross different viewport lines; on mobile they stack.
      const offsets = steps.map((step) =>
        step.getBoundingClientRect().top - parseFloat(getComputedStyle(step).scrollMarginTop),
      );
      const index = offsets.reduce((current, offset, i) => offset <= 1 ? i : current, -1);

      if (active !== index) {
        active = index;
        steps.forEach((step, i) => {
          if (i === index) step.setAttribute("aria-current", "step");
          else step.removeAttribute("aria-current");
        });
      }

      fills.forEach((fill, i) => {
        const distance = offsets[i + 1] - offsets[i];
        const value = distance > 0
          ? Math.max(0, Math.min(1, -offsets[i] / distance))
          : Number(i < index);
        fill.style.setProperty("--journey-fill", String(value));
      });
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const size = new ResizeObserver(schedule);
    size.observe(document.body);
    size.observe(journey);
    steps.forEach((step) => size.observe(step));
    const listening = { signal: events.signal, passive: true };
    window.addEventListener("scroll", schedule, listening);
    window.addEventListener("resize", schedule, listening);
    window.addEventListener("hashchange", schedule, listening);
    window.visualViewport?.addEventListener("resize", schedule, listening);
    window.addEventListener("pagehide", () => {
      events.abort();
      size.disconnect();
      cancelAnimationFrame(frame);
    }, { signal: events.signal, once: true });
    schedule();
  }

  const compactJourneys = document.querySelectorAll<HTMLElement>(".hub-journey--compact[data-hub-journey]");
  compactJourneys.forEach(trackCompactJourney);
  if (compactJourneys.length) {
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) compactJourneys.forEach(trackCompactJourney);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-hub-journey]:not(.hub-journey--compact)").forEach((journey) => {
    const steps = Array.from(
      journey.querySelectorAll<HTMLElement>("[data-journey-step]"),
    );
    const nodes = Array.from(
      journey.querySelectorAll<HTMLElement>("[data-journey-node]"),
    );
    const connections = Array.from(
      journey.querySelectorAll<SVGPathElement>("[data-journey-connection]"),
    );

    journey.classList.add("is-enhanced");

    const activate = (stepNumber: number) => {
      journey.dataset.activeStep = String(stepNumber);

      steps.forEach((step) => {
        const number = Number(step.dataset.journeyStep);
        if (number === stepNumber) {
          step.setAttribute("aria-current", "step");
        } else {
          step.removeAttribute("aria-current");
        }
      });

      nodes.forEach((node) => {
        const number = Number(node.dataset.journeyNode);
        node.classList.toggle("is-active", number === stepNumber);
        node.classList.toggle("is-complete", number < stepNumber);
      });

      connections.forEach((connection) => {
        const number = Number(connection.dataset.journeyConnection);
        connection.classList.toggle("is-active", number === stepNumber);
        connection.classList.toggle("is-complete", number < stepNumber);
      });
    };

    activate(1);

    if (!("IntersectionObserver" in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (!visible) return;
        const target = visible.target as HTMLElement;
        activate(Number(target.dataset.journeyStep) || 1);
      },
      {
        rootMargin: "-28% 0px -42% 0px",
        threshold: [0.2, 0.45, 0.7],
      },
    );

    steps.forEach((step) => observer.observe(step));
  });
</script>

<style>
  .hub-journey--compact {
    --journey-marker-size: 2.5rem;
    --journey-gap: 1.2rem;
    margin-bottom: 3.25rem;
    padding-top: 0;
    scroll-margin-top: 8rem;
  }

  .hub-journey--compact .hub-journey__heading {
    margin-bottom: 1.5rem;
  }

  .hub-journey--compact .hub-journey__heading .eyebrow {
    margin-bottom: 0.5rem;
    color: var(--color-pantone-deep);
    font-size: 0.78rem;
  }

  .hub-journey--compact .hub-journey__heading h2 {
    margin-bottom: 0;
    font-size: 1.7rem;
    text-wrap: balance;
  }

  .hub-journey--compact .hub-journey__layout {
    display: block;
  }

  .hub-journey--compact .hub-journey__steps {
    display: grid;
    gap: var(--journey-gap);
  }

  .hub-journey--compact .hub-journey__steps li {
    grid-template-columns: var(--journey-marker-size) minmax(0, 1fr);
    gap: 0.85rem;
    min-height: 0;
    align-content: start;
    align-items: start;
    padding: 0;
    border: 0;
    background: none;
    scroll-margin-top: 62dvh;
  }

  .hub-journey--compact .hub-journey__steps li::before {
    display: none;
  }

  .hub-journey__track {
    position: absolute;
    z-index: 0;
    inset: calc(var(--journey-marker-size) / 2) auto calc(-1 * (var(--journey-gap) + var(--journey-marker-size) / 2)) calc(var(--journey-marker-size) / 2 - 1px);
    width: 2px;
    background: var(--color-line);
    pointer-events: none;
  }

  .hub-journey__fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-pantone);
    transform: scaleY(var(--journey-fill, 0));
    transform-origin: top;
  }

  .hub-journey__milestone {
    position: relative;
    z-index: 1;
    display: grid;
    width: var(--journey-marker-size);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-pantone-deep);
    border-radius: 50%;
    background: var(--color-ice);
    color: var(--color-pantone-deep);
    font-size: 0.85rem;
    font-weight: 850;
    font-variant-numeric: tabular-nums;
  }

  .hub-journey--compact .hub-journey__steps li[aria-current="step"] .hub-journey__milestone {
    border-color: var(--color-red);
    background: var(--color-red);
    color: var(--color-dark);
    outline: 2px solid var(--color-dark);
    outline-offset: 2px;
  }

  .hub-journey--compact .hub-journey__summary h3 {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .hub-journey--compact .hub-journey__summary p {
    margin: 0;
    font-size: 0.95rem;
  }

  .hub-journey--compact .hub-journey__summary .text-link {
    min-height: 44px;
    font-size: 0.9rem;
  }

  @media (min-width: 48rem) {
    .hub-journey--compact {
      --journey-gap: clamp(1.2rem, 4vw, 3rem);
      margin-bottom: 4.5rem;
    }

    .hub-journey--compact .hub-journey__heading h2 {
      font-size: 2.4rem;
    }

    .hub-journey--compact .hub-journey__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .hub-journey--compact .hub-journey__steps li {
      grid-template-columns: minmax(0, 1fr);
      scroll-margin-top: 81dvh;
    }
    .hub-journey--compact .hub-journey__steps li:nth-child(2) { scroll-margin-top: 63dvh; }
    .hub-journey--compact .hub-journey__steps li:nth-child(3) { scroll-margin-top: 45dvh; }
    .hub-journey--compact .hub-journey__steps li:nth-child(4) { scroll-margin-top: 27dvh; }

    .hub-journey__track {
      inset: calc(var(--journey-marker-size) / 2 - 1px) calc(-1 * (var(--journey-gap) + var(--journey-marker-size) / 2)) auto calc(var(--journey-marker-size) / 2);
      width: auto;
      height: 2px;
    }

    .hub-journey__fill {
      transform: scaleX(var(--journey-fill, 0));
      transform-origin: left;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hub-journey__fill { transition: transform 120ms ease-out; }
    .hub-journey__milestone { transition: background-color 120ms ease-out, color 120ms ease-out; }
  }
</style>
