---
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const topics = [
  { id: "rhetorik", label: "Rhetorik & Vertrieb" },
  { id: "fuehrung", label: "Führung" },
  { id: "kommunikation", label: "Kommunikation" },
];
---

<main class="calendar-preview" data-calendar-preview data-base={base}>
  <header class="calendar-preview__intro">
    <div>
      <p class="eyebrow">Interne Vorschau · Beispieltermine</p>
      <h1>Termine und Gruppenangebote im Blick</h1>
    </div>
    <p>
      Verfügbare Formate lassen sich nach Thema und Monat sichten. Eine
      Vormerkung wird erst nach interner Prüfung zu einem verbindlichen Angebot.
    </p>
  </header>

  <p class="calendar-preview__scope">
    <strong>Geplante Vorträge und Gruppenangebote:</strong> Für individuelle
    Termine sprechen Sie uns bitte <a href={url("kontakt")}>direkt an</a>.
  </p>

  <section class="calendar-toolbar" aria-label="Kalender filtern und Monat auswählen">
    <div class="calendar-topic-filter" role="group" aria-label="Themenfilter">
      <button type="button" class="is-active" data-topic="all" aria-pressed="true">
        Alle Themen
      </button>
      {topics.map((topic) => (
        <button type="button" data-topic={topic.id} aria-pressed="false">
          <span class:list={["topic-dot", `topic-dot--${topic.id}`]} aria-hidden="true"></span>
          {topic.label}
        </button>
      ))}
    </div>

    <div class="calendar-month-switcher">
      <button type="button" class="calendar-icon-button calendar-icon-button--previous" data-previous-month aria-label="Vorheriger Monat">
        <Icon name="arrow-right" size={20} />
      </button>
      <strong data-month-label aria-live="polite"></strong>
      <button type="button" class="calendar-icon-button" data-next-month aria-label="Nächster Monat">
        <Icon name="arrow-right" size={20} />
      </button>
    </div>
  </section>

  <section class="calendar-workspace">
    <div class="calendar-board" aria-label="Monatskalender">
      <div class="calendar-weekdays" aria-hidden="true">
        {['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'].map((day) => <span>{day}</span>)}
      </div>
      <div class="calendar-grid" data-calendar-grid></div>
      <p class="calendar-empty" data-calendar-empty hidden>
        In diesem Monat gibt es für den gewählten Themenfilter keinen Beispieltermin.
      </p>
    </div>

    <aside class="calendar-detail">
      <div class="calendar-detail__empty" data-detail-empty>
        <span class="calendar-detail__icon"><Icon name="calendar" size={30} /></span>
        <h2>Termin auswählen</h2>
        <p>Die wichtigsten Angaben und der Vormerkungsstand erscheinen hier.</p>
      </div>

      <div class="calendar-detail__content" data-detail-content hidden>
        <div class="calendar-detail__heading">
          <div>
            <p class="eyebrow" data-detail-topic></p>
            <h2 data-detail-title></h2>
          </div>
          <span class="calendar-status" data-detail-status></span>
        </div>

        <dl class="calendar-meta">
          <div><dt>Coach</dt><dd><a data-detail-coach></a></dd></div>
          <div><dt>Termin</dt><dd data-detail-date></dd></div>
          <div><dt>Format</dt><dd data-detail-format></dd></div>
        </dl>

        <div class="calendar-capacity">
          <div>
            <strong data-capacity-copy></strong>
            <span>unverbindlich vorgemerkt</span>
          </div>
          <div class="calendar-capacity__track" aria-hidden="true">
            <span data-capacity-bar></span>
          </div>
        </div>

        <form class="calendar-reservation" data-reservation-form>
          <label for="prototype-seat-count">Gewünschte Plätze</label>
          <div>
            <input id="prototype-seat-count" name="seats" type="number" min="1" max="10" value="1" inputmode="numeric" />
            <button class="button" type="submit" data-reservation-submit>Vormerkung simulieren</button>
          </div>
          <p class="calendar-reservation__status" data-reservation-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </aside>
  </section>

  <footer class="calendar-preview__footer">
    <div class="calendar-legend" aria-label="Themenfarben">
      {topics.map((topic) => (
        <span><i class:list={["topic-dot", `topic-dot--${topic.id}`]}></i>{topic.label}</span>
      ))}
    </div>
    <p>Prototyp ohne Speicherung, Benachrichtigung oder echte Verfügbarkeit.</p>
  </footer>
</main>

<script>
  type PrototypeEvent = {
    id: string;
    offset: number;
    topic: "rhetorik" | "fuehrung" | "kommunikation";
    topicLabel: string;
    title: string;
    coach: string;
    profilePath: string;
    format: string;
    time: string;
    target: number;
    reserved: number;
    status: string;
  };

  const prototypes: PrototypeEvent[] = [
    { id: "sample-1", offset: 7, topic: "rhetorik", topicLabel: "Rhetorik & Vertrieb", title: "Beispieltermin Rhetorik", coach: "Herr Goran Celic", profilePath: "coaches/goran-celic", format: "Vortrag · Präsenz", time: "09:30–12:00 Uhr", target: 25, reserved: 12, status: "Offen für Vormerkungen" },
    { id: "sample-2", offset: 16, topic: "fuehrung", topicLabel: "Führung", title: "Beispieltermin Führung", coach: "Frau Dr. Stefanie Becker", profilePath: "coaches/stefanie-becker", format: "Workshop · Präsenz", time: "13:00–16:30 Uhr", target: 25, reserved: 21, status: "Offen für Vormerkungen" },
    { id: "sample-3", offset: 31, topic: "kommunikation", topicLabel: "Kommunikation", title: "Beispieltermin Kommunikation", coach: "Herr Christian Galvano", profilePath: "coaches/christian-galvano", format: "Workshop · Online", time: "10:00–12:00 Uhr", target: 25, reserved: 25, status: "Interne Prüfung" },
    { id: "sample-4", offset: 47, topic: "rhetorik", topicLabel: "Rhetorik & Vertrieb", title: "Beispieltermin Vertrieb", coach: "Herr Goran Celic", profilePath: "coaches/goran-celic", format: "Impuls · Online", time: "15:00–16:00 Uhr", target: 25, reserved: 8, status: "Offen für Vormerkungen" },
    { id: "sample-5", offset: 68, topic: "fuehrung", topicLabel: "Führung", title: "Beispieltermin Zusammenarbeit", coach: "Frau Dr. Stefanie Becker", profilePath: "coaches/stefanie-becker", format: "Workshop · Präsenz", time: "09:00–13:00 Uhr", target: 25, reserved: 17, status: "Offen für Vormerkungen" },
    { id: "sample-weekend-1", offset: -1, topic: "rhetorik", topicLabel: "Rhetorik & Vertrieb", title: "Beispieltermin Gesprächsführung", coach: "Herr Goran Celic", profilePath: "coaches/goran-celic", format: "Vortrag · Präsenz", time: "10:00–12:00 Uhr", target: 25, reserved: 9, status: "Offen für Vormerkungen" },
    { id: "sample-weekend-2", offset: -1, topic: "fuehrung", topicLabel: "Führung", title: "Beispieltermin Führungspraxis", coach: "Frau Dr. Stefanie Becker", profilePath: "coaches/stefanie-becker", format: "Workshop · Präsenz", time: "11:00–13:30 Uhr", target: 25, reserved: 14, status: "Offen für Vormerkungen" },
  ];

  const addDays = (date: Date, days: number) => {
    const next = new Date(date);
    next.setDate(next.getDate() + days);
    return next;
  };

  const startOfMonth = (date: Date, offset = 0) =>
    new Date(date.getFullYear(), date.getMonth() + offset, 1, 12);

  document.querySelectorAll<HTMLElement>("[data-calendar-preview]").forEach((root) => {
    const now = new Date();
    now.setHours(12, 0, 0, 0);
    const nextSaturday = ((6 - now.getDay() + 7) % 7 || 7) + 7;
    const events = prototypes.map((event) => ({
      ...event,
      date: addDays(now, event.offset === -1 ? nextSaturday : event.offset),
    }));
    const months = [0, 1, 2].map((offset) => startOfMonth(now, offset));
    let monthIndex = 0;
    let topic = "all";
    let selectedEvent: (PrototypeEvent & { date: Date }) | null = null;

    const grid = root.querySelector<HTMLElement>("[data-calendar-grid]");
    const monthLabel = root.querySelector<HTMLElement>("[data-month-label]");
    const empty = root.querySelector<HTMLElement>("[data-calendar-empty]");
    const previous = root.querySelector<HTMLButtonElement>("[data-previous-month]");
    const next = root.querySelector<HTMLButtonElement>("[data-next-month]");
    const detailEmpty = root.querySelector<HTMLElement>("[data-detail-empty]");
    const detailContent = root.querySelector<HTMLElement>("[data-detail-content]");
    const reservationForm = root.querySelector<HTMLFormElement>("[data-reservation-form]");
    const reservationStatus = root.querySelector<HTMLElement>("[data-reservation-status]");
    const reservationInput = root.querySelector<HTMLInputElement>("#prototype-seat-count");
    const reservationSubmit = root.querySelector<HTMLButtonElement>("[data-reservation-submit]");
    const detailCoach = root.querySelector<HTMLAnchorElement>("[data-detail-coach]");

    if (!grid || !monthLabel || !empty || !previous || !next || !detailEmpty || !detailContent || !reservationForm || !reservationStatus || !reservationInput || !reservationSubmit || !detailCoach) return;

    const formatMonth = new Intl.DateTimeFormat("de-DE", { month: "long", year: "numeric" });
    const formatDate = new Intl.DateTimeFormat("de-DE", { weekday: "long", day: "2-digit", month: "2-digit", year: "numeric" });
    const sameDay = (left: Date, right: Date) => left.toDateString() === right.toDateString();

    const setText = (selector: string, value: string) => {
      const element = root.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };

    const clearDetails = () => {
      selectedEvent = null;
      detailEmpty.hidden = false;
      detailContent.hidden = true;
      reservationStatus.textContent = "";
    };

    const showDetails = (event: PrototypeEvent & { date: Date }) => {
      selectedEvent = event;
      detailEmpty.hidden = true;
      detailContent.hidden = false;
      setText("[data-detail-topic]", event.topicLabel);
      setText("[data-detail-title]", event.title);
      detailCoach.textContent = event.coach;
      detailCoach.href = `${root.dataset.base || "/"}${event.profilePath}`;
      setText("[data-detail-date]", `${formatDate.format(event.date)}, ${event.time}`);
      setText("[data-detail-format]", event.format);
      setText("[data-detail-status]", event.status);
      setText("[data-capacity-copy]", `${event.reserved} von ${event.target} Plätzen`);
      const bar = root.querySelector<HTMLElement>("[data-capacity-bar]");
      if (bar) bar.style.width = `${Math.min(100, (event.reserved / event.target) * 100)}%`;
      const canReserve = event.status === "Offen für Vormerkungen";
      reservationInput.disabled = !canReserve;
      reservationSubmit.disabled = !canReserve;
      reservationStatus.textContent = canReserve
        ? ""
        : "Für diesen Beispieltermin sind keine weiteren Vormerkungen möglich.";
      root.querySelectorAll("[data-event-id]").forEach((button) => {
        button.toggleAttribute("aria-current", button.getAttribute("data-event-id") === event.id);
      });
    };

    const render = () => {
      const month = months[monthIndex];
      const daysInMonth = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
      const leadingDays = (month.getDay() + 6) % 7;
      const visibleEvents = events.filter((event) =>
        event.date.getFullYear() === month.getFullYear()
        && event.date.getMonth() === month.getMonth()
        && (topic === "all" || event.topic === topic),
      );

      monthLabel.textContent = formatMonth.format(month);
      previous.disabled = monthIndex === 0;
      next.disabled = monthIndex === months.length - 1;
      empty.hidden = visibleEvents.length > 0;
      grid.replaceChildren();

      for (let index = 0; index < leadingDays; index += 1) {
        const spacer = document.createElement("span");
        spacer.className = "calendar-day calendar-day--empty";
        spacer.setAttribute("aria-hidden", "true");
        grid.append(spacer);
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        const date = new Date(month.getFullYear(), month.getMonth(), day, 12);
        const cell = document.createElement("div");
        cell.className = "calendar-day";
        if (sameDay(date, now)) cell.classList.add("is-today");

        const number = document.createElement("span");
        number.className = "calendar-day__number";
        number.textContent = String(day);
        cell.append(number);

        visibleEvents.filter((event) => sameDay(event.date, date)).forEach((event) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = `calendar-event calendar-event--${event.topic}`;
          button.setAttribute("data-event-id", event.id);
          button.setAttribute("aria-label", `${event.title}, ${formatDate.format(event.date)}, ${event.status}`);
          const topicCopy = document.createElement("span");
          topicCopy.textContent = event.topicLabel;
          const statusCopy = document.createElement("small");
          statusCopy.textContent = event.status;
          button.append(topicCopy, statusCopy);
          button.addEventListener("click", () => showDetails(event));
          cell.append(button);
        });
        grid.append(cell);
      }
    };

    root.querySelectorAll<HTMLButtonElement>("[data-topic]").forEach((button) => {
      button.addEventListener("click", () => {
        topic = button.dataset.topic || "all";
        root.querySelectorAll<HTMLButtonElement>("[data-topic]").forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle("is-active", active);
          candidate.setAttribute("aria-pressed", String(active));
        });
        clearDetails();
        render();
      });
    });

    previous.addEventListener("click", () => {
      if (monthIndex > 0) monthIndex -= 1;
      clearDetails();
      render();
    });
    next.addEventListener("click", () => {
      if (monthIndex < months.length - 1) monthIndex += 1;
      clearDetails();
      render();
    });

    reservationForm.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!selectedEvent) return;
      const data = new FormData(reservationForm);
      const seats = Number(data.get("seats"));
      if (!Number.isInteger(seats) || seats < 1 || seats > 10) {
        reservationStatus.textContent = "Bitte wählen Sie zwischen 1 und 10 Plätzen.";
        return;
      }
      reservationStatus.textContent = `Vorschau: ${seats} ${seats === 1 ? "Platz würde" : "Plätze würden"} unverbindlich vorgemerkt.`;
    });

    render();
  });
</script>

<style>
  .calendar-preview {
    --topic-rhetorik: #c84d29;
    --topic-fuehrung: #007b80;
    --topic-kommunikation: #b58316;
    width: min(100% - 40px, 1320px);
    margin: 0 auto;
    padding: 54px 0 72px;
  }

  .calendar-preview__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.7fr);
    gap: 54px;
    align-items: end;
    padding: 0 0 34px;
    border-bottom: 1px solid var(--color-line);
  }

  .calendar-preview__intro h1 {
    max-width: 820px;
    margin: 8px 0 0;
    font-size: 3.25rem;
    line-height: 1.03;
  }

  .calendar-preview__intro > p {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .calendar-preview__scope {
    margin: 18px 0 0;
    padding: 14px 18px;
    border-left: 5px solid var(--color-red);
    background: var(--color-soft);
    color: var(--color-muted);
  }

  .calendar-preview__scope strong { color: var(--color-dark); }
  .calendar-preview__scope a,
  .calendar-meta a {
    color: var(--color-pantone-deep);
    font-weight: 850;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .calendar-toolbar {
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    padding: 26px 0;
  }

  .calendar-topic-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .calendar-topic-filter button,
  .calendar-icon-button {
    border: 1px solid var(--color-line-strong);
    background: var(--color-white);
    color: var(--color-dark);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 800;
    cursor: pointer;
  }

  .calendar-topic-filter button {
    display: inline-flex;
    min-width: 0;
    min-height: 42px;
    padding: 9px 14px;
    gap: 8px;
    align-items: center;
  }

  .calendar-topic-filter button > span:last-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .calendar-topic-filter button:hover,
  .calendar-topic-filter button:focus-visible,
  .calendar-topic-filter button.is-active,
  .calendar-icon-button:hover:not(:disabled),
  .calendar-icon-button:focus-visible {
    border-color: var(--color-pantone);
    outline: 3px solid rgba(0, 156, 166, 0.18);
    outline-offset: 2px;
  }

  .calendar-topic-filter button.is-active {
    background: var(--color-pantone-deep);
    color: var(--color-white);
  }

  .topic-dot {
    display: inline-block;
    width: 11px;
    height: 11px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-pantone);
  }

  .topic-dot--rhetorik { background: var(--topic-rhetorik); }
  .topic-dot--fuehrung { background: var(--topic-fuehrung); }
  .topic-dot--kommunikation { background: var(--topic-kommunikation); }

  .calendar-month-switcher {
    display: grid;
    grid-template-columns: 42px minmax(180px, auto) 42px;
    gap: 8px;
    align-items: center;
    text-align: center;
  }

  .calendar-month-switcher strong {
    text-transform: capitalize;
  }

  .calendar-icon-button {
    display: inline-grid;
    width: 42px;
    height: 42px;
    padding: 0;
    place-items: center;
  }

  .calendar-icon-button--previous :global(.icon) { transform: rotate(180deg); }
  .calendar-icon-button:disabled { opacity: 0.35; cursor: not-allowed; }

  .calendar-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.34fr);
    min-height: 680px;
    border: 1px solid var(--color-line);
    border-top: 8px solid var(--color-pantone);
    background: var(--color-white);
  }

  .calendar-board { min-width: 0; padding: 26px; }
  .calendar-weekdays,
  .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }

  .calendar-weekdays span {
    padding: 0 8px 12px;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 900;
    text-align: right;
    text-transform: uppercase;
  }

  .calendar-grid { border-top: 1px solid var(--color-line); border-left: 1px solid var(--color-line); }

  :global(.calendar-day) {
    min-width: 0;
    min-height: 112px;
    padding: 9px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: #fff;
  }

  :global(.calendar-day--empty) { background: var(--color-soft); }
  :global(.calendar-day.is-today) { box-shadow: inset 0 0 0 2px var(--color-pantone); }

  :global(.calendar-day__number) {
    display: block;
    margin-bottom: 8px;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 900;
    text-align: right;
  }

  :global(.calendar-event) {
    display: block;
    width: 100%;
    min-height: 62px;
    padding: 8px;
    border: 0;
    border-left: 5px solid currentColor;
    background: var(--color-soft);
    color: var(--color-dark);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  :global(.calendar-event:hover),
  :global(.calendar-event:focus-visible),
  :global(.calendar-event[aria-current]) {
    outline: 3px solid rgba(0, 156, 166, 0.25);
    outline-offset: 2px;
  }

  :global(.calendar-event--rhetorik) { border-left-color: var(--topic-rhetorik); }
  :global(.calendar-event--fuehrung) { border-left-color: var(--topic-fuehrung); }
  :global(.calendar-event--kommunikation) { border-left-color: var(--topic-kommunikation); }
  :global(.calendar-event span), :global(.calendar-event small) { display: block; }
  :global(.calendar-event span) { font-size: 0.78rem; font-weight: 900; line-height: 1.2; }
  :global(.calendar-event small) { margin-top: 5px; color: var(--color-muted); font-size: 0.68rem; }

  .calendar-empty { margin: 20px 0 0; padding: 18px; background: var(--color-soft); }

  .calendar-detail {
    min-width: 0;
    padding: 34px;
    border-left: 1px solid var(--color-line);
    background: var(--color-soft);
  }

  .calendar-detail__empty { max-width: 300px; }
  .calendar-detail__icon {
    display: inline-grid;
    width: 58px;
    height: 58px;
    margin-bottom: 20px;
    place-items: center;
    border: 2px solid var(--color-pantone);
    border-radius: 50%;
    color: var(--color-pantone);
  }

  .calendar-detail h2 { margin: 0; font-size: 1.75rem; line-height: 1.12; }
  .calendar-detail__empty p { color: var(--color-muted); }

  .calendar-detail__heading { display: grid; gap: 18px; }
  .calendar-detail__heading .eyebrow { margin-bottom: 9px; }

  .calendar-status {
    display: inline-flex;
    width: fit-content;
    padding: 7px 10px;
    border-left: 4px solid var(--color-pantone);
    background: var(--color-white);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .calendar-meta { display: grid; gap: 0; margin: 28px 0; }
  .calendar-meta div { padding: 12px 0; border-top: 1px solid var(--color-line); }
  .calendar-meta dt { color: var(--color-muted); font-size: 0.74rem; font-weight: 900; text-transform: uppercase; }
  .calendar-meta dd { margin: 3px 0 0; font-weight: 750; }

  .calendar-capacity { margin: 28px 0; }
  .calendar-capacity > div:first-child { display: flex; justify-content: space-between; gap: 12px; font-size: 0.82rem; }
  .calendar-capacity span { color: var(--color-muted); }
  .calendar-capacity__track { height: 10px; margin-top: 10px; background: var(--color-line); }
  .calendar-capacity__track span { display: block; height: 100%; background: var(--color-pantone); }

  .calendar-reservation { padding-top: 24px; border-top: 1px solid var(--color-line); }
  .calendar-reservation label { display: block; margin-bottom: 8px; font-size: 0.85rem; font-weight: 900; }
  .calendar-reservation > div { display: grid; grid-template-columns: 82px minmax(0, 1fr); gap: 10px; }
    .calendar-reservation input { min-width: 0; padding: 10px; border: 2px solid var(--color-line-strong); font: inherit; }
    .calendar-reservation input:disabled { background: var(--color-line); color: var(--color-muted); }
  .calendar-reservation .button { min-height: 48px; padding: 11px 14px; }
  .calendar-reservation__status { min-height: 2.8em; margin: 12px 0 0; color: var(--color-pantone-deep); font-size: 0.82rem; font-weight: 800; }

  .calendar-preview__footer {
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    color: var(--color-muted);
    font-size: 0.78rem;
