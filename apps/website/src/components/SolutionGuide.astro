---
import Icon from "./Icon.astro";
import { audiences, goals } from "../data/solution-guide.mjs";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="solution-guide" data-solution-guide data-base={base} hidden>
  <form method="dialog" aria-labelledby="solution-guide-title">
    <div><p class="eyebrow">Lösungsfinder</p><h3 id="solution-guide-title">Ihr Anliegen eingrenzen</h3></div>
    <label>Für wen?
      <select name="audience" required>
        <option value="">Bitte auswählen</option>
        {audiences.map(({ id, label }) => <option value={id}>{label}</option>)}
      </select>
    </label>
    <label>Was möchten Sie erreichen?
      <select name="goal" required>
        <option value="">Bitte auswählen</option>
        {goals.map(({ id, label }) => <option value={id}>{label}</option>)}
      </select>
    </label>
    <button class="button" type="submit">Passende Wege zeigen <Icon name="arrow-right" size={17} /></button>
  </form>
  <section class="solution-guide__result" aria-labelledby="solution-result-title" hidden>
    <h3 tabindex="-1" id="solution-result-title">Diese Wege könnten zu Ihrem Anliegen passen.</h3>
    <ol data-solution-results></ol>
    <div class="solution-guide__actions">
      <a class="button" data-solution-contact href={`${base}/kontakt/`}>Anliegen mit Frau Rappelt besprechen</a>
      <a class="text-link" href={`${base}/leistungen/#angebotsfinder`}>Weitere Angebote ansehen</a>
    </div>
  </section>
</div>

<script>
  import { suggestDirections } from "../data/solution-guide.mjs";

  for (const guide of document.querySelectorAll<HTMLElement>("[data-solution-guide]")) {
    const compass = guide.closest("[data-company-compass]");
    const form = guide.querySelector("form");
    const result = guide.querySelector<HTMLElement>(".solution-guide__result");
    const list = guide.querySelector("[data-solution-results]");
    const heading = guide.querySelector<HTMLElement>("#solution-result-title");
    const contact = guide.querySelector<HTMLAnchorElement>("[data-solution-contact]");
    if (!compass || !form || !result || !list || !heading || !contact) continue;

    const base = guide.dataset.base ?? "";
    const render = (focus: boolean) => {
      const current = compass.querySelector<HTMLElement>("[data-compass-tab][aria-selected=true]");
      const data = new FormData(form);
      const matches = suggestDirections(current?.dataset.topic, String(data.get("audience")), String(data.get("goal")));
      if (!matches.length) {
        result.hidden = true;
        list.replaceChildren();
        return;
      }
      const items = matches.map(({ title, reason, href }) => {
        const row = document.createElement("li");
        const link = document.createElement("a");
        const explanation = document.createElement("p");
        link.href = href.startsWith("unternehmen#")
          ? href.slice("unternehmen".length)
          : `${base}/${href.replace("#", "/#")}`;
        link.textContent = title;
        explanation.textContent = reason;
        row.append(link, explanation);
        return row;
      });
      list.replaceChildren(...items);
      contact.href = `${base}/kontakt/?thema=${matches[0].contact}`;
      result.hidden = false;
      if (focus) heading.focus();
    };
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      render(true);
    });
    form.addEventListener("change", () => {
      if (!result.hidden) render(false);
    });
    compass.addEventListener("company-compass:change", () => {
      if (!result.hidden) render(false);
    });
    guide.hidden = false;
  }
</script>

<style>
  .solution-guide { border-top: 1px solid var(--color-line); margin-top: 1rem; padding-top: 1.15rem; }
  .solution-guide form {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1.3fr) auto;
    gap: .75rem 1rem; align-items: end;
  }
  .solution-guide label { display: grid; gap: .3rem; color: var(--color-dark); font-weight: 650; }
  .solution-guide select {
    width: 100%; min-width: 0; min-height: 44px; padding: .45rem; font: inherit; font-weight: 500;
    background: var(--color-white); color: var(--color-dark); border: 1px solid var(--color-pantone-deep); border-radius: 4px;
  }
  .solution-guide .button { gap: .35rem; min-height: 44px; }
  .solution-guide__result { margin-top: 1rem; padding: 1.15rem; border-inline-start: 4px solid var(--color-pantone); background: var(--color-white); }
  .solution-guide__result h3 { scroll-margin-top: 10rem; }
  .solution-guide__result h3:focus-visible { outline: 2px solid var(--color-dark); outline-offset: 3px; }
  .solution-guide__result ol { margin: .75rem 0 1rem; padding-inline-start: 1.35rem; }
  .solution-guide__result :global(li + li) { margin-top: .65rem; }
  .solution-guide__result :global(li a) {
    color: var(--color-pantone-deep); text-decoration: underline; font-weight: 750; text-underline-offset: .18em;
  }
  .solution-guide__result :global(li p) { margin: .15rem 0 0; }
  .solution-guide__actions { display: flex; align-items: center; gap: .7rem 1.1rem; flex-wrap: wrap; }
  .solution-guide__actions .text-link { margin: 0; }
  @media (max-width: 67rem) {
    .solution-guide form { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .solution-guide form > div { grid-column: 1 / -1; }
    .solution-guide button { justify-self: start; grid-column: 1 / -1; }
  }
  @media (max-width: 34rem) {
    .solution-guide form { grid-template-columns: minmax(0, 1fr); }
    .solution-guide__result { padding: .85rem; }
  }
</style>
