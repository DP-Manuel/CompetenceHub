---
import CompetenceHubMap from "./CompetenceHubMap.astro";
import HubJourney from "./HubJourney.astro";
import Icon from "./Icon.astro";

type Variant = "a" | "b" | "c";

interface Props {
  variant: Variant;
  prototypeMode?: boolean;
}

const { variant, prototypeMode = true } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const variants = [
  {
    id: "a" as const,
    label: "A",
    name: "Zentrale Halle",
    href: "prototyp/living-hub-a",
  },
  {
    id: "b" as const,
    label: "B",
    name: "Orientierungsdocks",
    href: "prototyp/living-hub-b",
  },
  {
    id: "c" as const,
    label: "C",
    name: "Asymmetrischer Einstieg",
    href: "prototyp/living-hub-c",
  },
];
---

<main
  class:list={[
    "living-prototype",
    `living-prototype--${variant}`,
    { "living-prototype--production": !prototypeMode },
  ]}
  data-living-prototype
>
  {prototypeMode && (
    <nav class="prototype-switcher" aria-label="Living-Hub-Varianten">
      <span>Lokaler Living-Hub-Prototyp</span>
      <div>
        {variants.map((item) => (
          <a
            href={url(item.href)}
            aria-current={item.id === variant ? "page" : undefined}
            title={`Variante ${item.label}: ${item.name}`}
          >
            <strong>{item.label}</strong>
            <span>{item.name}</span>
          </a>
        ))}
        <a class="prototype-switcher__stable" href={url()}>
          Aktuelle Startseite
        </a>
      </div>
    </nav>
  )}

  <section
    class:list={["living-hero", `living-hero--${variant}`]}
    data-living-hero
    aria-label={
      prototypeMode
        ? `Living-Hub-Hero, Variante ${variant.toUpperCase()}`
        : "Competence Hub entdecken"
    }
  >
    <div class="living-hero__depth" aria-hidden="true">
      <span class="living-hero__contour living-hero__contour--outer"></span>
      <span class="living-hero__contour living-hero__contour--inner"></span>
      <span class="living-hero__signal"></span>
    </div>

    {variant === "a" && (
      <>
        <header class="living-hero__orientation living-hero__orientation--center">
          <p class="eyebrow">Variante A · Zentrale Halle</p>
          <p>Ein lebendiger Ausgangspunkt für Anliegen, Expertise und Formate.</p>
        </header>
        <div class="living-hero__space living-hero__space--central">
          <CompetenceHubMap presentation="living" />
        </div>
        <a class="living-hero__scroll-cue" href="#so-funktioniert-der-hub">
          <span>Verbindung verfolgen</span>
          <Icon name="arrow-right" size={18} />
        </a>
      </>
    )}

    {variant === "b" && (
      <>
        <header class="living-hero__orientation living-hero__orientation--center">
          <p class="eyebrow">Variante B · Orientierungsdocks</p>
          <p>Ein zentraler Core mit direkten Einstiegen für zwei Perspektiven.</p>
        </header>
        <div class="living-hero__docked-stage">
          <aside class="living-dock living-dock--business">
            <span>Für Organisationen</span>
            <strong>Unternehmen</strong>
            <p>Führung, Teams, Recruiting und Personalentwicklung verbinden.</p>
            <a href={url("unternehmen")}>
              Einstieg Unternehmen
              <Icon name="arrow-right" size={18} />
            </a>
          </aside>

          <div class="living-hero__space living-hero__space--docked">
            <CompetenceHubMap presentation="living" />
          </div>

          <aside class="living-dock living-dock--private">
            <span>Für Menschen</span>
            <strong>Mindforge</strong>
            <p>Life Coaching für Klarheit, Resilienz und persönliche Entwicklung.</p>
            <a href={url("mindforge")}>
              Einstieg Mindforge
              <Icon name="arrow-right" size={18} />
            </a>
          </aside>
        </div>
        <a class="living-hero__scroll-cue" href="#so-funktioniert-der-hub">
          <span>Vom Einstieg zur Verbindung</span>
          <Icon name="arrow-right" size={18} />
        </a>
      </>
    )}

    {variant === "c" && (
      prototypeMode ? (
        <div class="living-hero__asymmetric-stage">
          <div class="living-hero__copy">
            <p class="eyebrow">Variante C · Asymmetrischer Einstieg</p>
            <p class="living-hero__display">
              Wo Anliegen und passende Expertise
              <span class="living-hero__keep-together">zusammenfinden.</span>
            </p>
            <p class="living-hero__lead">
              Der Competence Hub verbindet Unternehmen und Privatpersonen mit
              ausgewählten Coaches, passenden Formaten und persönlicher Begleitung.
            </p>
            <div class="living-hero__actions">
              <a class="button" href={url("kontakt")}>Bedarf besprechen</a>
              <a class="button button--ghost" href="#so-funktioniert-der-hub">
                Hub erkunden
              </a>
            </div>
            <div class="living-hero__routes" aria-label="Direkte Einstiege">
              <a href={url("unternehmen")}>
                <Icon name="building" size={20} />
                Für Unternehmen
              </a>
              <a href={url("mindforge")}>
                <Icon name="sparkles" size={20} />
                Mindforge · Life Coaching
              </a>
            </div>
          </div>

          <div class="living-hero__space living-hero__space--asymmetric">
            <CompetenceHubMap presentation="living" layout="asymmetric" />
          </div>
        </div>
      ) : (
        <div class="living-hero__centered-stage">
          <div class="living-hero__copy living-hero__copy--centered">
            <p class="eyebrow">Coaching, Entwicklung und Beratung im Netzwerk</p>
            <p class="living-hero__display">
              Wo Anliegen und passende Expertise
              <span class="living-hero__keep-together">zusammenfinden.</span>
            </p>
            <p class="living-hero__lead">
              Der Competence Hub verbindet Unternehmen und Privatpersonen mit
              ausgewählten Coaches, passenden Formaten und persönlicher Begleitung.
            </p>
          </div>

          <div class="living-hero__space living-hero__space--centered">
            <CompetenceHubMap presentation="living" layout="asymmetric" />
          </div>

          <div class="living-hero__actions living-hero__actions--centered">
            <a class="button" href={url("kontakt")}>Bedarf besprechen</a>
            <a class="button button--ghost" href="#so-funktioniert-der-hub">
              Hub erkunden
            </a>
          </div>
          <div
            class="living-hero__routes living-hero__routes--centered"
            aria-label="Direkte Einstiege"
          >
            <a href={url("unternehmen")}>
              <Icon name="building" size={20} />
              Für Unternehmen
            </a>
            <a href={url("mindforge")}>
              <Icon name="sparkles" size={20} />
              Mindforge · Life Coaching
            </a>
          </div>
        </div>
      )
    )}
  </section>

  <slot name="before-journey" />
  <HubJourney />
  <slot />
</main>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(pointer: fine)");

  const clamp = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  document.querySelectorAll<HTMLElement>("[data-living-hero]").forEach((hero) => {
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;

    const renderPointer = () => {
      const rect = hero.getBoundingClientRect();
      const normalizedX = clamp((pointerX - rect.left) / rect.width, 0, 1) - 0.5;
      const normalizedY = clamp((pointerY - rect.top) / rect.height, 0, 1) - 0.5;

      hero.style.setProperty("--living-tilt-x", `${normalizedX * 3}deg`);
      hero.style.setProperty("--living-tilt-y", `${normalizedY * -3}deg`);
      hero.style.setProperty("--living-shift-x", `${normalizedX * 20}px`);
      hero.style.setProperty("--living-shift-y", `${normalizedY * 20}px`);
      frame = 0;
    };

    const resetPointer = () => {
      hero.style.setProperty("--living-tilt-x", "0deg");
      hero.style.setProperty("--living-tilt-y", "0deg");
      hero.style.setProperty("--living-shift-x", "0px");
      hero.style.setProperty("--living-shift-y", "0px");
    };

    hero.addEventListener("pointermove", (event) => {
      if (reducedMotion.matches || !finePointer.matches) return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!frame) frame = window.requestAnimationFrame(renderPointer);
    });
    hero.addEventListener("pointerleave", resetPointer);
  });
</script>

<style>
  .living-prototype {
    --living-tilt-x: 0deg;
    --living-tilt-y: 0deg;
    --living-shift-x: 0px;
    --living-shift-y: 0px;
    overflow-x: clip;
    padding-top: 18px;
  }

  .living-prototype--production {
    padding-top: 24px;
  }

  .living-prototype--production .living-hero {
    min-height: 0;
    padding-bottom: 44px;
  }

  .prototype-switcher {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .prototype-switcher > span {
    color: var(--color-pantone-deep);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .prototype-switcher > div {
    display: flex;
    gap: 6px;
    align-items: stretch;
  }

  .prototype-switcher a {
    display: flex;
    min-height: 40px;
    gap: 7px;
    align-items: center;
    min-width: 0;
    padding: 7px 10px;
    border: 1px solid var(--color-line);
    background: var(--color-white);
    color: var(--color-dark);
    font-size: 0.74rem;
    font-weight: 800;
  }

  .prototype-switcher a strong {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    background: var(--color-soft);
    color: var(--color-pantone-deep);
  }

  .prototype-switcher a:hover,
  .prototype-switcher a:focus-visible,
  .prototype-switcher a[aria-current="page"] {
    border-color: var(--color-pantone);
    background: var(--color-soft);
  }

  .prototype-switcher a[aria-current="page"] strong {
    background: var(--color-red);
    color: var(--color-dark);
  }

  .prototype-switcher .prototype-switcher__stable {
    border-color: transparent;
    color: var(--color-pantone-deep);
  }

  .living-hero {
    position: relative;
    min-height: min(780px, calc(100svh - 116px));
    overflow: hidden;
    border-top: 8px solid var(--color-pantone);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-soft);
    isolation: isolate;
  }

  .living-hero__depth {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .living-hero__contour {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px dashed var(--color-pantone);
    border-radius: 50%;
    opacity: 0.16;
    transform: translate(
      calc(-50% + var(--living-shift-x)),
      calc(-50% + var(--living-shift-y))
    );
    transition: transform 220ms ease-out;
  }

  .living-hero__contour--outer {
    width: min(940px, 82vw);
    aspect-ratio: 1;
  }

  .living-hero__contour--inner {
    width: min(610px, 56vw);
    aspect-ratio: 1;
    border-style: solid;
    opacity: 0.08;
    transform: translate(
      calc(-50% - var(--living-shift-x)),
      calc(-50% - var(--living-shift-y))
    );
  }

  .living-hero__signal {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 420px;
    max-width: 42vw;
    aspect-ratio: 1;
    border: 2px solid rgba(0, 156, 166, 0.16);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: living-signal 4.8s ease-in-out infinite;
  }

  .living-hero__orientation {
    position: relative;
    z-index: 5;
  }

  .living-hero__orientation--center {
    max-width: 680px;
    margin: 0 auto -44px;
    padding-top: 26px;
    text-align: center;
  }

  .living-hero__orientation p:last-child {
    margin: 5px 0 0;
    color: rgba(51, 49, 50, 0.7);
    font-weight: 750;
  }

  .living-hero__space {
    position: relative;
    z-index: 2;
    min-width: 0;
    transform: perspective(1500px) rotateX(var(--living-tilt-y))
      rotateY(var(--living-tilt-x));
    transform-style: preserve-3d;
    transition: transform 220ms ease-out;
  }

  .living-hero__space :global(.hub-graph--living) {
    height: clamp(650px, calc(100svh - 170px), 760px);
    min-height: 650px;
    overflow: visible;
    border: 0;
    background: transparent;
  }

  .living-hero__space :global(.hub-graph--living::before),
  .living-hero__space :global(.hub-graph--living .hub-graph__guide) {
    display: none;
  }

  .living-hero__space :global(.hub-graph--living .hub-graph__connections) {
    transform: translate3d(
      calc(var(--living-shift-x) * 0.18),
      calc(var(--living-shift-y) * 0.18),
      18px
    );
    transition: transform 220ms ease-out;
  }

  .living-hero__space :global(.hub-graph--living .hub-graph__core) {
    width: 390px;
    height: 390px;
    padding: 52px;
    transform: translate(-50%, -50%) translateZ(42px);
  }

  .living-hero__space
    :global(.hub-graph--living .hub-graph__core h1 em) {
    margin-top: 7px;
  }

  .living-hero__space :global(.hub-graph--living .hub-graph__core:hover),
  .living-hero__space :global(.hub-graph--living .hub-graph__core:focus-visible),
  .living-hero__space
    :global(.hub-graph--living[data-active="core"] .hub-graph__core) {
    transform: translate(-50%, -50%) translateZ(42px) scale(1.035);
  }

  .living-hero__space :global(.hub-graph--living .hub-graph__position) {
    transform: translate(-50%, -50%) translateZ(72px);
  }

  .living-hero__scroll-cue {
    position: absolute;
    right: 28px;
    bottom: 22px;
    z-index: 8;
    display: inline-flex;
    min-height: 44px;
    gap: 10px;
    align-items: center;
    padding: 8px 12px;
    border-bottom: 2px solid var(--color-pantone);
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-dark);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .living-hero__scroll-cue .icon {
    color: var(--color-red-text);
    transform: rotate(90deg);
  }

  .living-hero__scroll-cue:hover,
  .living-hero__scroll-cue:focus-visible {
    border-color: var(--color-red);
    color: var(--color-pantone-deep);
  }

  .living-hero__docked-stage {
    display: grid;
    grid-template-columns: minmax(150px, 0.3fr) minmax(620px, 1fr) minmax(
        150px,
        0.3fr
      );
    align-items: center;
    min-height: 690px;
  }

  .living-dock {
    position: relative;
    z-index: 6;
    padding: 24px 18px;
    border-top: 7px solid var(--color-red);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-white);
    box-shadow: 0 16px 36px rgba(51, 49, 50, 0.1);
  }

  .living-dock--business {
    margin-right: -34px;
  }

  .living-dock--private {
    margin-left: -34px;
    border-top-color: var(--color-pantone);
  }

  .living-dock > span {
    display: block;
    margin-bottom: 6px;
    color: var(--color-red-text);
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .living-dock--private > span {
    color: var(--color-pantone-deep);
  }

  .living-dock > strong {
    display: block;
    color: var(--color-dark);
    font-size: 1.2rem;
  }

  .living-dock p {
    margin: 12px 0 18px;
    color: rgba(51, 49, 50, 0.72);
    font-size: 0.82rem;
    line-height: 1.48;
  }

  .living-dock a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--color-dark);
    font-size: 0.76rem;
    font-weight: 900;
    text-decoration: underline;
    text-decoration-color: var(--color-pantone);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .living-dock a:hover,
  .living-dock a:focus-visible {
    color: var(--color-pantone-deep);
    text-decoration-color: var(--color-red);
  }

  .living-hero__asymmetric-stage {
    display: grid;
    grid-template-columns: minmax(390px, 0.82fr) minmax(600px, 1.18fr);
    gap: 18px;
    align-items: center;
    min-height: 740px;
  }

  .living-hero__centered-stage {
    display: grid;
    width: 100%;
    min-width: 0;
    justify-items: center;
    overflow: hidden;
  }

  .living-hero__copy {
    position: relative;
    z-index: 8;
    padding: 42px 0 42px 34px;
  }

  .living-hero__copy--centered {
    width: min(100%, 1080px);
    min-width: 0;
    box-sizing: border-box;
    padding: 52px 28px 6px;
    text-align: center;
  }

  .living-hero__copy--centered .living-hero__display,
  .living-hero__copy--centered .living-hero__lead {
    margin-inline: auto;
  }

  .living-hero__copy--centered .living-hero__display {
    max-width: 1040px;
  }

  .living-hero__copy--centered .living-hero__lead {
    max-width: 760px;
  }

  .living-hero__display {
    max-width: 520px;
    margin: 16px 0 24px;
    color: var(--color-dark);
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 900;
    hyphens: none;
    line-height: 1.02;
    overflow-wrap: normal;
  }

  .living-hero__keep-together {
    white-space: nowrap;
  }

  .living-hero__lead {
    max-width: 500px;
    color: rgba(51, 49, 50, 0.76);
    font-size: 1.04rem;
    font-weight: 700;
    line-height: 1.55;
  }

  .living-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .living-hero__routes {
    display: grid;
    gap: 8px;
    margin-top: 28px;
  }

  .living-hero__routes a {
    display: flex;
    width: fit-content;
    min-height: 40px;
    gap: 10px;
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--color-dark);
    font-size: 0.86rem;
    font-weight: 850;
  }

  .living-hero__routes a .icon {
    color: var(--color-pantone);
  }

  .living-hero__routes a:hover,
  .living-hero__routes a:focus-visible {
    border-color: var(--color-red);
    color: var(--color-pantone-deep);
  }

  .living-hero__space--asymmetric {
    margin-left: -70px;
  }

  .living-hero__space--centered {
    width: min(100%, 1240px);
    min-width: 0;
    max-width: 100%;
    margin: -28px auto -18px;
    overflow: hidden;
  }

  .living-hero__space--centered :global(.hub-graph--living) {
    width: 100%;
    max-width: 100%;
    height: clamp(610px, 53vw, 690px);
    min-height: 610px;
  }

  .living-hero__actions--centered {
    justify-content: center;
    margin-top: 0;
  }

  .living-hero__routes--centered {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 22px;
  }

  .living-hero + :global(.hub-journey) {
    margin-top: clamp(76px, 9vw, 122px);
  }

  @keyframes living-signal {
    0%,
    100% {
      opacity: 0.42;
      transform: translate(-50%, -50%) scale(0.99);
    }
    50% {
      opacity: 0.18;
      transform: translate(-50%, -50%) scale(1.015);
    }
  }

  @media (max-width: 1100px) {
    .living-hero__docked-stage {
      grid-template-columns: 150px minmax(580px, 1fr) 150px;
    }

    .living-dock {
      padding-inline: 14px;
    }

    .living-hero__asymmetric-stage {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .living-prototype--c .living-hero__copy {
      max-width: 760px;
      padding: 52px 34px 0;
    }

    .living-prototype--c .living-hero__display {
      font-size: 3.4rem;
    }

    .living-hero__space--asymmetric {
      margin: -40px 0 -20px;
    }

    .living-prototype--production .living-hero__copy--centered {
      max-width: 900px;
      padding: 46px 28px 0;
    }

    .living-hero__space--centered {
      margin: -18px 0 -12px;
    }

  }

  @media (max-width: 980px) {
    .prototype-switcher {
      align-items: flex-start;
      flex-direction: column;
    }

    .prototype-switcher > div {
      width: 100%;
      flex-wrap: wrap;
    }

    .living-hero {
      min-height: 0;
    }

    .living-hero__docked-stage {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 68px 18px 28px;
    }

    .living-hero__space--docked {
      grid-column: 1 / -1;
      grid-row: 1;
      margin: -86px -18px -70px;
    }

    .living-dock {
      min-height: 190px;
      margin: 0;
    }

    .living-hero__asymmetric-stage {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .living-hero__copy {
      max-width: 720px;
      padding: 52px 34px 0;
    }

    .living-hero__display {
      font-size: 3.4rem;
    }

    .living-hero__space--asymmetric {
      margin: -40px 0 -20px;
    }

    .living-hero__space--centered {
      margin: -18px 0 -12px;
    }

  }

  @media (max-width: 640px) {
    .living-prototype {
      width: calc(100vw - 40px);
      max-width: 100%;
      margin-inline: auto;
      padding-top: 8px;
    }

    .prototype-switcher > span {
      width: 100%;
    }

    .prototype-switcher > div {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .prototype-switcher a {
      justify-content: center;
      padding: 7px;
    }

    .prototype-switcher a span {
      display: none;
    }

    .prototype-switcher .prototype-switcher__stable {
      grid-column: 1 / -1;
    }

    .living-hero {
      width: 100%;
      max-width: 100%;
      overflow: hidden;
