---
import Icon from "./Icon.astro";

interface Props {
  presentation?: "default" | "living" | "homepage";
  layout?: "default" | "asymmetric";
}

const { presentation = "default", layout = "default" } = Astro.props;
const homepage = presentation === "homepage";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const nodes = [
  {
    id: "unternehmen",
    title: "Für Unternehmen",
    detail: "Anliegen und Ziele",
    href: "unternehmen",
    icon: "building" as const,
    kind: "primary",
    x: 14.2,
    y: 29,
    size: 138,
  },
  {
    id: "coaches",
    title: "Coaches",
    detail: "Ausgewählte Expertise",
    href: "coaches",
    icon: "users" as const,
    kind: "primary",
    x: 85.8,
    y: 29,
    size: 132,
  },
  {
    id: "leistungen",
    title: "Leistungen",
    detail: "Passende Formate",
    href: "leistungen",
    icon: "briefcase" as const,
    kind: "primary",
    x: 81,
    y: 73,
    size: 136,
  },
  {
    id: "recruiting",
    title: "Recruiting",
    detail: "Potenziale verbinden",
    href: "leistungen#recruiting",
    icon: "user-round" as const,
    kind: "primary",
    x: 20,
    y: 75,
    size: 128,
  },
  {
    id: "kontakt",
    title: "Kontakt",
    detail: "Persönlich begleitet",
    href: "kontakt",
    icon: "message-circle" as const,
    kind: "primary",
    x: 42,
    y: 86,
    size: 110,
  },
  {
    id: "mindforge",
    title: "Mindforge",
    detail: "Beratung & Businesscoaching",
    href: "mindforge",
    icon: "sparkles" as const,
    kind: "secondary",
    x: 62,
    y: 11.5,
    size: 112,
  },
  {
    id: "beratung",
    title: "Beratung",
    detail: "Orientierung",
    href: "mindforge#beratung",
    icon: "message-circle" as const,
    kind: "secondary",
    x: 63.5,
    y: 81,
    size: 92,
  },
  {
    id: "gruppenformate",
    title: "Workshops & Vorträge",
    detail: "Gemeinsam lernen",
    href: "leistungen#gruppenformate",
    icon: "compass" as const,
    kind: "secondary",
    x: 35,
    y: 13.5,
    size: 104,
  },
];

const edges = [
  { from: "core", to: "unternehmen", d: "M600 380 Q400 300 170 220" },
  { from: "core", to: "coaches", d: "M600 380 Q800 290 1030 220" },
  { from: "core", to: "leistungen", d: "M600 380 Q820 430 972 555" },
  { from: "core", to: "recruiting", d: "M600 380 Q410 470 240 570" },
  { from: "core", to: "kontakt", d: "M600 380 Q545 515 504 654" },
  { from: "coaches", to: "mindforge", d: "M1030 220 Q880 90 720 88" },
  { from: "coaches", to: "beratung", d: "M1030 220 Q920 500 762 616" },
  { from: "coaches", to: "gruppenformate", d: "M1030 220 Q720 80 420 103" },
  { from: "leistungen", to: "mindforge", d: "M972 555 Q930 255 720 88" },
  { from: "leistungen", to: "beratung", d: "M972 555 Q860 610 762 616" },
  { from: "leistungen", to: "gruppenformate", d: "M972 555 Q660 350 420 103" },
  { from: "unternehmen", to: "recruiting", d: "M170 220 Q155 405 240 570" },
  { from: "unternehmen", to: "gruppenformate", d: "M170 220 Q290 120 420 103" },
  { from: "recruiting", to: "kontakt", d: "M240 570 Q365 635 504 654" },
];

const asymmetricPositions: Record<
  string,
  { x: number; y: number; size?: number }
> = {
  unternehmen: { x: 10.5, y: 31 },
  coaches: { x: 89.5, y: 30 },
  leistungen: { x: 88, y: 75, size: 128 },
  recruiting: { x: 12.5, y: 76, size: 122 },
  kontakt: { x: 39, y: 90, size: 104 },
  mindforge: { x: 66, y: 8.5, size: 106 },
  beratung: { x: 68, y: 89.5, size: 84 },
  gruppenformate: { x: 32, y: 9, size: 94 },
};

// Keep the outer nodes in three bands: the top and bottom pairs move away
// from the core while the larger nodes sit at the sides.
const homepagePositions: typeof asymmetricPositions = {
  unternehmen: { x: 11, y: 38, size: 138 },
  coaches: { x: 89, y: 38, size: 132 },
  leistungen: { x: 87, y: 75, size: 136 },
  recruiting: { x: 13, y: 75, size: 126 },
  kontakt: { x: 28, y: 81, size: 112 },
  mindforge: { x: 73, y: 17, size: 122 },
  beratung: { x: 72, y: 81, size: 104 },
  gruppenformate: { x: 27, y: 17, size: 128 },
};

const positions = homepage ? homepagePositions : layout === "asymmetric" ? asymmetricPositions : undefined;
const renderedNodes = nodes.map((node) => ({ ...node, ...positions?.[node.id] }));

const pointFor = (id: string) => {
  if (id === "core") return { x: 600, y: 380 };
  const node = renderedNodes.find((item) => item.id === id);
  return node
    ? { x: node.x * 12, y: node.y * 7.6 }
    : { x: 600, y: 380 };
};

const renderedEdges =
  positions
    ? edges.map((edge, index) => {
        const from = pointFor(edge.from);
        const to = pointFor(edge.to);
        const dx = to.x - from.x;
        const dy = to.y - from.y;
        const length = Math.max(Math.hypot(dx, dy), 1);
        const bend = (index % 2 === 0 ? 1 : -1) * Math.min(28, length * 0.05);
        const controlX = (from.x + to.x) / 2 - (dy / length) * bend;
        const controlY = (from.y + to.y) / 2 + (dx / length) * bend;

        return {
          ...edge,
          d: `M${from.x} ${from.y} Q${controlX} ${controlY} ${to.x} ${to.y}`,
        };
      })
    : edges;
---

<div
  class:list={[
    "hub-graph",
    {
      "hub-graph--living": presentation === "living",
      "hub-graph--asymmetric": layout === "asymmetric",
      "hub-graph--homepage": homepage,
    },
  ]}
  data-hub-graph
>
  <p class="visually-hidden" id="hub-graph-help">
    {homepage
      ? "Der Kern führt zur Seite Über uns. Die weiteren Links führen direkt zu den Bereichen des Competence Hub."
      : "Der Competence Hub ist der zentrale Startknoten. Fokussieren oder berühren Sie den Kern, um seine Hauptverbindungen anzuzeigen. Der Kern führt zur Seite Über uns, die Außenknoten direkt zu den jeweiligen Bereichen."}
  </p>

  <svg
    class="hub-graph__connections"
    viewBox="0 0 1200 760"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <circle class="hub-graph__orbit" cx="600" cy="380" r="188" />
    <circle class="hub-graph__orbit hub-graph__orbit--outer" cx="600" cy="380" r="310" />
    <circle class="hub-graph__marker" cx="600" cy="192" r="7" />
    {renderedEdges.map((edge) => (
      <path
        d={edge.d}
        data-edge
        data-from={edge.from}
        data-to={edge.to}
        pathLength="1"
      />
    ))}
  </svg>

  <a
    class="hub-graph__core"
    data-node="core"
    href={url("ueber-uns")}
    aria-label="Mehr über den Competence Hub erfahren"
    aria-describedby="hub-graph-help"
  >
    <h1>Competence <em>Hub</em></h1>
    <p>Expertise, die zu Ihrem Anliegen passt.</p>
  </a>

  <nav class="hub-graph__nodes" aria-label="Bereiche des Competence Hub">
    {renderedNodes.map((node) => (
      <span
        class={`hub-graph__position hub-graph__position--${node.kind}`}
        style={__WEBSITE_V2_LOCAL__ ? undefined : `--node-x: ${node.x}%; --node-y: ${node.y}%; --node-size: ${node.size}px;`}
        data-v2-position={__WEBSITE_V2_LOCAL__ ? node.id : undefined}
      >
        <a
          class="hub-graph__node"
          data-node={node.id}
          data-kind={node.kind}
          href={url(node.href)}
          aria-label={`${node.title}: ${node.detail}`}
        >
          <Icon name={node.icon} size={node.kind === "primary" ? 25 : 20} />
          <strong>{node.title}</strong>
          <small>{node.detail}</small>
        </a>
      </span>
    ))}
  </nav>{__WEBSITE_V2_LOCAL__ && <style is:inline set:html={renderedNodes.map((node) =>
    `[data-v2-position="${node.id}"] { --node-x: ${node.x}%; --node-y: ${node.y}%; --node-size: ${node.size}px; }`
  ).join("\n")} />}

  {!homepage && <div class="hub-graph__guide" aria-hidden="true">
    <span></span>
    <strong>Hub oder Knoten berühren</strong>
    <span></span>
  </div>}
</div>

<script>
  const graphs = document.querySelectorAll<HTMLElement>("[data-hub-graph]");

  graphs.forEach((graph) => {
    const core = graph.querySelector<HTMLElement>('[data-node="core"]');
    const nodes = Array.from(
      graph.querySelectorAll<HTMLElement>(".hub-graph__node[data-node]"),
    );
    const edges = Array.from(
      graph.querySelectorAll<SVGPathElement>("[data-edge]"),
    );
    const clear = () => {
      graph.removeAttribute("data-active");
      edges.forEach((edge) => edge.classList.remove("is-active"));
      nodes.forEach((node) => {
        node.classList.remove("is-active", "is-related", "is-muted");
      });
    };

    const activate = (id: string) => {
      clear();
      graph.dataset.active = id;

      const related = new Set<string>();
      edges.forEach((edge) => {
        const from = edge.dataset.from || "";
        const to = edge.dataset.to || "";
        const active =
          id === "core" ? from === "core" : from === id || to === id;

        edge.classList.toggle("is-active", active);
        if (active) {
          related.add(from);
          related.add(to);
        }
      });

      nodes.forEach((node) => {
        const nodeId = node.dataset.node || "";
        node.classList.toggle("is-active", nodeId === id);
        node.classList.toggle("is-related", related.has(nodeId));
        node.classList.toggle(
          "is-muted",
          id !== "core" && nodeId !== id && !related.has(nodeId),
        );
      });
    };

    const release = () => {
      clear();
    };

    core?.addEventListener("mouseenter", () => activate("core"));
    core?.addEventListener("mouseleave", release);
    core?.addEventListener("focus", () => activate("core"));
    core?.addEventListener("blur", release);

    nodes.forEach((node) => {
      const id = node.dataset.node || "";
      node.addEventListener("mouseenter", () => activate(id));
      node.addEventListener("mouseleave", release);
      node.addEventListener("focus", () => activate(id));
      node.addEventListener("blur", release);
    });
  });
</script>

<style>
  .hub-graph--homepage {
    --homepage-core-position: none;
    display: grid;
    height: auto;
    min-height: 0;
    gap: 1.15rem;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
  }

  .hub-graph--homepage::before {
    display: none;
  }

  .hub-graph--homepage .hub-graph__connections {
    display: none;
  }

  .hub-graph--homepage .hub-graph__core {
    position: relative;
    inset: auto;
    width: min(100%, 12rem);
    height: auto;
    max-width: none;
    aspect-ratio: 1;
    justify-items: center;
    margin: 0 auto;
    padding: 0.6rem;
    border: 5px solid var(--color-white);
    background: var(--color-pantone-deep);
    box-shadow: 0 0 0 1px var(--color-pantone-deep), 0 8px 18px rgba(0, 111, 118, 0.14);
    transform: var(--homepage-core-position);
  }

  .hub-graph--homepage .hub-graph__core:is(:hover, :focus-visible),
  .hub-graph--homepage[data-active="core"] .hub-graph__core {
    box-shadow: 0 0 0 4px var(--color-red), 0 8px 18px rgba(0, 111, 118, 0.2);
    transform: var(--homepage-core-position);
  }

  .hub-graph--homepage .hub-graph__core h1 {
    margin: 0 0 0.55rem;
    font-size: 1.5rem;
    font-weight: 850;
    line-height: 1;
    white-space: nowrap;
  }

  .hub-graph--homepage .hub-graph__core h1 em {
    margin-top: 0.2em;
    color: var(--color-white);
  }

  .hub-graph--homepage .hub-graph__core p {
    max-width: 15ch;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .hub-graph--homepage .hub-graph__nodes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .hub-graph--homepage .hub-graph__position {
    position: relative;
    inset: auto;
    width: auto;
    height: auto;
    min-width: 0;
    aspect-ratio: auto;
    transform: none;
    animation: none;
  }

  .hub-graph--homepage .hub-graph__node {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.9rem;
    padding: 0.4rem 0.25rem;
    border: 1px solid var(--color-line);
    border-radius: 5px;
    background: var(--color-white);
    box-shadow: none;
    opacity: 1;
    transform: none;
  }

  .hub-graph--homepage .hub-graph__node::after { content: none; }

  .hub-graph--homepage .hub-graph__node strong {
    font-size: 0.82rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .hub-graph--homepage .hub-graph__node small {
    display: none;
  }

  .hub-graph--homepage .hub-graph__node :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0;
    color: var(--color-pantone-deep);
    flex: none;
  }

  .hub-graph--homepage .hub-graph__node:is(:hover, :focus-visible, .is-active),
  .hub-graph--homepage[data-active="core"] .hub-graph__node {
    opacity: 1;
    transform: none;
  }

  .hub-graph--homepage .hub-graph__node:is(:hover, :focus-visible, .is-active) {
    border-color: var(--color-pantone-deep);
    box-shadow: 0 0 0 2px var(--color-red);
  }

  .hub-graph--homepage .hub-graph__node:focus-visible {
    outline-offset: 2px;
  }

  @media (min-width: 40rem) {
    .hub-graph--homepage .hub-graph__nodes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .hub-graph--homepage {
      --homepage-core-position: translate(-50%, -50%);
      display: block;
      height: 25.5rem;
    }

    .hub-graph--homepage .hub-graph__connections {
      display: block;
    }

    .hub-graph--homepage .hub-graph__connections path {
      stroke-dashoffset: 0;
      opacity: 0.1;
    }

    .hub-graph--homepage .hub-graph__connections path[data-from="core"] {
      opacity: 0.28;
    }

    .hub-graph--homepage .hub-graph__connections path.is-active {
      opacity: 0.8;
    }

    .hub-graph--homepage .hub-graph__core {
      position: absolute;
      inset: 50% auto auto 50%;
      width: 15.5rem;
      padding: 0.9rem;
      border-width: 7px;
    }

    .hub-graph--homepage .hub-graph__core h1 {
      font-size: 1.875rem;
    }

    .hub-graph--homepage .hub-graph__core p {
      font-size: 0.93rem;
    }

    .hub-graph--homepage .hub-graph__nodes {
      position: absolute;
      display: block;
    }

    .hub-graph--homepage .hub-graph__position {
      position: absolute;
      inset: var(--node-y) auto auto var(--node-x);
      width: var(--node-size);
      height: var(--node-size);
      transform: translate(-50%, -50%);
    }

    .hub-graph--homepage .hub-graph__node {
      display: grid;
      gap: 0.25rem;
      padding: 0.65rem;
      border-color: var(--color-pantone);
      border-radius: 50%;
    }

    .hub-graph--homepage .hub-graph__node small {
      display: block;
      max-width: 15ch;
      color: var(--color-dark);
      font-size: 0.68rem;
      font-weight: 550;
      overflow-wrap: anywhere;
    }

    .hub-graph--homepage .hub-graph__node.is-related,
    .hub-graph--homepage[data-active="core"] .hub-graph__position--primary .hub-graph__node {
      border-color: var(--color-pantone-deep);
      background: var(--color-ice);
    }
  }

  @media (max-width: 40rem) {
    .hub-graph--homepage { gap: 0.8rem; }
    .hub-graph--homepage .hub-graph__core { width: min(100%, 11.2rem); }
    .hub-graph--homepage .hub-graph__core h1 { font-size: 1.4rem; }
  }
</style>
