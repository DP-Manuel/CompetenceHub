---
import Icon from "./Icon.astro";

interface Props {
  presentation?: "default" | "living";
  layout?: "default" | "asymmetric";
}

const { presentation = "default", layout = "default" } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const nodes = [
  {
    id: "unternehmen",
    title: "Für Unternehmen",
    detail: "Anliegen und Ziele",
    href: "unternehmen",
    icon: "building" as const,
    kind: "primary",
    x: 14.2,
    y: 29,
    size: 138,
  },
  {
    id: "coaches",
    title: "Coaches",
    detail: "Ausgewählte Expertise",
    href: "coaches",
    icon: "users" as const,
    kind: "primary",
    x: 85.8,
    y: 29,
    size: 132,
  },
  {
    id: "leistungen",
    title: "Leistungen",
    detail: "Passende Formate",
    href: "leistungen",
    icon: "briefcase" as const,
    kind: "primary",
    x: 81,
    y: 73,
    size: 136,
  },
  {
    id: "recruiting",
    title: "Recruiting",
    detail: "Potenziale verbinden",
    href: "leistungen#recruiting",
    icon: "user-round" as const,
    kind: "primary",
    x: 20,
    y: 75,
    size: 128,
  },
  {
    id: "kontakt",
    title: "Kontakt",
    detail: "Persönlich begleitet",
    href: "kontakt",
    icon: "message-circle" as const,
    kind: "primary",
    x: 42,
    y: 86,
    size: 110,
  },
  {
    id: "mindforge",
    title: "Mindforge",
    detail: "Life & Business Coaching",
    href: "mindforge",
    icon: "sparkles" as const,
    kind: "secondary",
    x: 62,
    y: 11.5,
    size: 112,
  },
  {
    id: "gesundheit",
    title: "Gesundheit",
    detail: "Prävention",
    href: "leistungen#gesundheit",
    icon: "heart-pulse" as const,
    kind: "secondary",
    x: 63.5,
    y: 81,
    size: 92,
  },
  {
    id: "gruppenformate",
    title: "Workshops & Vorträge",
    detail: "Gemeinsam lernen",
    href: "leistungen#gruppenformate",
    icon: "compass" as const,
    kind: "secondary",
    x: 35,
    y: 13.5,
    size: 104,
  },
];

const edges = [
  { from: "core", to: "unternehmen", d: "M600 380 Q400 300 170 220" },
  { from: "core", to: "coaches", d: "M600 380 Q800 290 1030 220" },
  { from: "core", to: "leistungen", d: "M600 380 Q820 430 972 555" },
  { from: "core", to: "recruiting", d: "M600 380 Q410 470 240 570" },
  { from: "core", to: "kontakt", d: "M600 380 Q545 515 504 654" },
  { from: "coaches", to: "mindforge", d: "M1030 220 Q880 90 720 88" },
  { from: "coaches", to: "gesundheit", d: "M1030 220 Q920 500 762 616" },
  { from: "coaches", to: "gruppenformate", d: "M1030 220 Q720 80 420 103" },
  { from: "leistungen", to: "mindforge", d: "M972 555 Q930 255 720 88" },
  { from: "leistungen", to: "gesundheit", d: "M972 555 Q860 610 762 616" },
  { from: "leistungen", to: "gruppenformate", d: "M972 555 Q660 350 420 103" },
  { from: "unternehmen", to: "recruiting", d: "M170 220 Q155 405 240 570" },
  { from: "unternehmen", to: "gruppenformate", d: "M170 220 Q290 120 420 103" },
  { from: "recruiting", to: "kontakt", d: "M240 570 Q365 635 504 654" },
];

const asymmetricPositions: Record<
  string,
  { x: number; y: number; size?: number }
> = {
  unternehmen: { x: 18, y: 31 },
  coaches: { x: 89, y: 29 },
  leistungen: { x: 87, y: 76 },
  recruiting: { x: 15.5, y: 77 },
  kontakt: { x: 43, y: 93 },
  mindforge: { x: 66, y: 10.5, size: 110 },
  gesundheit: { x: 70, y: 91, size: 86 },
  gruppenformate: { x: 34, y: 10.5, size: 96 },
};

const renderedNodes =
  layout === "asymmetric"
    ? nodes.map((node) => ({ ...node, ...asymmetricPositions[node.id] }))
    : nodes;

const pointFor = (id: string) => {
  if (id === "core") return { x: 600, y: 380 };
  const node = renderedNodes.find((item) => item.id === id);
  return node
    ? { x: node.x * 12, y: node.y * 7.6 }
    : { x: 600, y: 380 };
};

const renderedEdges =
  layout === "asymmetric"
    ? edges.map((edge, index) => {
        const from = pointFor(edge.from);
        const to = pointFor(edge.to);
        const dx = to.x - from.x;
        const dy = to.y - from.y;
        const length = Math.max(Math.hypot(dx, dy), 1);
        const bend = (index % 2 === 0 ? 1 : -1) * Math.min(28, length * 0.05);
        const controlX = (from.x + to.x) / 2 - (dy / length) * bend;
        const controlY = (from.y + to.y) / 2 + (dx / length) * bend;

        return {
          ...edge,
          d: `M${from.x} ${from.y} Q${controlX} ${controlY} ${to.x} ${to.y}`,
        };
      })
    : edges;
---

<div
  class:list={[
    "hub-graph",
    {
      "hub-graph--living": presentation === "living",
      "hub-graph--asymmetric": layout === "asymmetric",
    },
  ]}
  data-hub-graph
>
  <p class="visually-hidden" id="hub-graph-help">
    Der Competence Hub ist der zentrale Startknoten. Fokussieren oder berühren
    Sie den Kern, um seine Hauptverbindungen anzuzeigen. Der Kern führt zur
    Seite Über uns, die Außenknoten direkt zu den jeweiligen Bereichen.
  </p>

  <svg
    class="hub-graph__connections"
    viewBox="0 0 1200 760"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <circle class="hub-graph__orbit" cx="600" cy="380" r="188" />
    <circle class="hub-graph__orbit hub-graph__orbit--outer" cx="600" cy="380" r="310" />
    <circle class="hub-graph__marker" cx="600" cy="192" r="7" />
    {renderedEdges.map((edge) => (
      <path
        d={edge.d}
        data-edge
        data-from={edge.from}
        data-to={edge.to}
        pathLength="1"
      />
    ))}
  </svg>

  <a
    class="hub-graph__core"
    data-node="core"
    href={url("ueber-uns")}
    aria-label="Mehr über den Competence Hub erfahren"
    aria-describedby="hub-graph-help"
  >
    <h1>Competence <em>Hub</em></h1>
    <p>Expertise, die zu Ihrem Anliegen passt.</p>
  </a>

  <nav class="hub-graph__nodes" aria-label="Bereiche des Competence Hub">
    {renderedNodes.map((node) => (
      <span
        class={`hub-graph__position hub-graph__position--${node.kind}`}
        style={`--node-x: ${node.x}%; --node-y: ${node.y}%; --node-size: ${node.size}px;`}
      >
        <a
          class="hub-graph__node"
          data-node={node.id}
          data-kind={node.kind}
          href={url(node.href)}
          aria-label={`${node.title}: ${node.detail}`}
        >
          <Icon name={node.icon} size={node.kind === "primary" ? 25 : 20} />
          <strong>{node.title}</strong>
          <small>{node.detail}</small>
        </a>
      </span>
    ))}
  </nav>

  <div class="hub-graph__guide" aria-hidden="true">
    <span></span>
    <strong>Hub oder Knoten berühren</strong>
    <span></span>
  </div>
</div>

<script>
  const graphs = document.querySelectorAll<HTMLElement>("[data-hub-graph]");

  graphs.forEach((graph) => {
    const core = graph.querySelector<HTMLElement>('[data-node="core"]');
    const nodes = Array.from(
      graph.querySelectorAll<HTMLElement>(".hub-graph__node[data-node]"),
    );
    const edges = Array.from(
      graph.querySelectorAll<SVGPathElement>("[data-edge]"),
    );
    const clear = () => {
      graph.removeAttribute("data-active");
      edges.forEach((edge) => edge.classList.remove("is-active"));
      nodes.forEach((node) => {
        node.classList.remove("is-active", "is-related", "is-muted");
      });
    };

    const activate = (id: string) => {
      clear();
      graph.dataset.active = id;

      const related = new Set<string>();
      edges.forEach((edge) => {
        const from = edge.dataset.from || "";
        const to = edge.dataset.to || "";
        const active =
          id === "core" ? from === "core" : from === id || to === id;

        edge.classList.toggle("is-active", active);
        if (active) {
          related.add(from);
          related.add(to);
        }
      });

      nodes.forEach((node) => {
        const nodeId = node.dataset.node || "";
        node.classList.toggle("is-active", nodeId === id);
        node.classList.toggle("is-related", related.has(nodeId));
        node.classList.toggle(
          "is-muted",
          id !== "core" && nodeId !== id && !related.has(nodeId),
        );
      });
    };

    const release = () => {
      clear();
    };

    core?.addEventListener("mouseenter", () => activate("core"));
    core?.addEventListener("mouseleave", release);
    core?.addEventListener("focus", () => activate("core"));
    core?.addEventListener("blur", release);

    nodes.forEach((node) => {
      const id = node.dataset.node || "";
      node.addEventListener("mouseenter", () => activate(id));
      node.addEventListener("mouseleave", release);
      node.addEventListener("focus", () => activate(id));
      node.addEventListener("blur", release);
    });
  });
</script>
