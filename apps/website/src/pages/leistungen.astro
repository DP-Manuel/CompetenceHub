---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { workshopDiscoveryPath, workshopProfiles } from "../data/workshop-themes";
import OfferingFinder from "@website-offer-finder";
import DemoOffer from "../v2-local/DemoOffer.astro";
import { finderEntries } from "../preview/offering-finder-data";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const services = [
  {
    eyebrow: "Mindforge",
    title: "Coaching und Beratung",
    text: "Beratungsgespräche für Privatpersonen sowie Businesscoaching und abgestimmte Beratung für Unternehmen.",
    href: "mindforge",
    link: "Mindforge ansehen",
    id: "mindforge",
    shortcut: "Coaching & Beratung",
    icon: "sparkles" as const,
  },
  {
    eyebrow: "Personalvermittlung · Recruiting",
    title: "Passende Fachkräfte finden",
    text: "Wir klären Anforderungsprofil, Unternehmenskontext und Auswahlweg, damit praktische Fähigkeiten und Potenziale zum tatsächlichen Bedarf passen.",
    href: "kontakt",
    link: "Recruiting besprechen",
    id: "recruiting",
    shortcut: "Recruiting",
    icon: "user-round" as const,
  },
  {
    eyebrow: "Personalentwicklung",
    title: "Potenziale erkennen und entwickeln",
    text: "Je nach Anliegen können Coaching, Development Assessment Center oder Supervision die nächsten Schritte unterstützen. Mediation wird nur bei bestätigter Qualifikation und Verfügbarkeit im Netzwerk vermittelt.",
    href: "unternehmen#assessment-center",
    link: "Personalentwicklung ansehen",
    id: "personalentwicklung",
    shortcut: "Personalentwicklung",
    icon: "building" as const,
  },
  {
    eyebrow: "Workshops & Vorträge",
    title: "Gemeinsam lernen",
    text: "Für Wissenstransfer, Lernimpulse und konkrete Themen in Gruppen.",
    href: "leistungen#angebotsfinder",
    link: "Zum Angebotsfinder",
    id: "gruppenformate",
    shortcut: "Workshops & Vorträge",
    icon: "users" as const,
  },
];

const faqs = [
  {
    question: "Wie finde ich die passende Leistung?",
    answer: "Am Anfang stehen Anlass, Zielgruppe und gewünschte Veränderung. Competence Hub ordnet das Anliegen ein und empfiehlt anschließend eine passende Expertise und ein geeignetes Format.",
  },
  {
    question: "Welche Angebote richten sich an Unternehmen?",
    answer: "Unternehmen können unter anderem Recruiting, Personalentwicklung, Businesscoaching, Workshops und Vorträge anfragen. Der konkrete Umfang wird gemeinsam aus dem betrieblichen Bedarf abgeleitet.",
  },
  {
    question: "Was gehört zur Personalentwicklung?",
    answer: "Zur Personalentwicklung können je nach Ziel Coaching, Development Assessment Center oder Supervision gehören. Mediation wird nur bei bestätigter Qualifikation und Verfügbarkeit im Netzwerk vermittelt.",
  },
  {
    question: "Gibt es auch Angebote für Privatpersonen?",
    answer: "Ja. Mindforge bietet Beratungsgespräche für persönliche und berufliche Entwicklung. Auf der Mindforge-Seite finden Privatpersonen einen eigenen Einstieg.",
  },
  {
    question: "Wie startet eine Anfrage?",
    answer: "Über die Kontaktseite werden Anlass, Zielgruppe, gewünschter Schwerpunkt und Zeitraum beschrieben. Danach wird der passende nächste Schritt gemeinsam geklärt.",
  },
  {
    question: "Erbringt Competence Hub die Leistungen selbst?",
    answer: "Competence Hub klärt den Bedarf und vermittelt passende Coaches oder Expertinnen und Experten aus dem Netzwerk. Durchführung, Umfang und Rahmen werden anschließend transparent abgestimmt.",
  },
];
---

<BaseLayout
  title="Leistungen | Competence Hub"
  description="Competence Hub verbindet Privatpersonen und Unternehmen mit Mindforge Coaching und Beratung, Recruiting, Assessment Center, Supervision, Mediation und Gruppenformaten."
>
  <main class="subpage services-page">
    <section class="services-intro" aria-labelledby="services-title">
      <div>
        <p class="eyebrow">Leistungen</p>
        <h1 id="services-title">Das passende Angebot finden</h1>
        <p>Coaching, Beratung und Gruppenformate für Unternehmen und Privatpersonen.</p>
        <a class="button" href="#angebotsfinder">Zum Angebotsfinder</a>
      </div>
      <nav class="services-shortcuts" aria-labelledby="services-title-connections">
        <h2 id="services-title-connections">Leistungsbereiche</h2>
        <ul role="list">
          {services.map((service) => (
            <li><a href={`#${service.id}`}><Icon name={service.icon} size={22} /> <span>{service.shortcut}</span> <Icon name="arrow-right" size={18} /></a></li>
          ))}
        </ul>
      </nav>
    </section>

    <OfferingFinder entries={finderEntries}>
      <Fragment slot="local-demo">{__WEBSITE_V2_LOCAL__ && <DemoOffer />}</Fragment>
    </OfferingFinder>
    <section class="service-index" id="angebote" aria-labelledby="service-index-title">
      <h2 id="service-index-title">Leistungen im Überblick</h2>
      {services.map((service) => (
        <article class="service-row" id={service.id}>
          <div class="service-row__heading">
            <span class="service-row__mark"><Icon name={service.icon} size={28} /></span>
            <div><p class="eyebrow">{service.eyebrow}</p><h3>{service.title}</h3></div>
          </div>
          <div class="service-row__detail">
            <p>{service.text}</p>
            <a class="text-link" href={url(service.href)}>{service.link} <Icon name="arrow-right" size={18} /></a>
            {service.id === "gruppenformate" && workshopProfiles.length > 0 && (
              <p><a class="text-link" href={url(workshopDiscoveryPath)}>Workshop-Themen und Coaches ansehen <Icon name="arrow-right" size={18} /></a></p>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="faq-section" aria-labelledby="services-faq-title">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="services-faq-title">Häufige Fragen zu den Leistungen</h2>
      </div>
      <div class="faq-grid">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="services-contact" aria-labelledby="services-contact-title">
      <div>
        <h2 id="services-contact-title">Noch unsicher?</h2>
        <p>Frau Rappelt hilft Ihnen, Ihr Anliegen einzuordnen und eine passende Leistung zu finden.</p>
      </div>
      <a class="button" href={url("kontakt")}>Bedarf mit Frau Rappelt klären</a>
    </section>
  </main>
</BaseLayout>

<style>
  .services-page :is(h1, h2, h3, a) { overflow-wrap: anywhere; }
  .services-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem 4rem;
    padding-block: 1rem 0;
  }
  .services-intro h1 { max-width: 17ch; font-size: 3.5rem; line-height: 1.1; }
  .services-intro .eyebrow, .services-shortcuts a :global(svg) { color: var(--color-pantone-deep); }
  .services-shortcuts h2 { font-size: 1.25rem; line-height: 1.3; margin-bottom: .65rem; }
  .services-shortcuts ul { list-style: none; margin: 0; padding: 0; }
  .services-shortcuts a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .75rem;
    border-top: 1px solid var(--color-line);
    min-height: 44px;
    padding: .55rem .5rem;
    font-weight: 750;
  }
  .services-shortcuts a:hover { background: var(--color-soft); }
  .services-shortcuts a:hover span { text-decoration: underline; text-underline-offset: .17em; }
  .services-shortcuts a:focus-visible { outline-offset: -3px; }
  .service-index { padding-block: 1.5rem 2.5rem; scroll-margin-top: 9rem; }
  .service-index > h2 { margin: 0 0 22px; }
  .service-index > h2, .services-contact h2 { font-size: 2rem; line-height: 1.22; }
  .service-row {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 12px 40px;
    border-top: 1px solid var(--color-line);
    padding-block: 24px;
    scroll-margin-top: 144px;
  }
  .service-row:last-child { border-bottom: 1px solid var(--color-line); }
  .service-row__heading { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 14px; }
  .service-row__mark { color: var(--color-pantone-deep); padding-top: 4px; }
  .service-row :is(h3, p) { margin: 0; overflow-wrap: anywhere; }
  .service-row h3 { font-size: 1.4rem; line-height: 1.3; }
  .service-row .eyebrow { margin-bottom: 6px; color: var(--color-pantone-deep); }
  .service-row .text-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }
  .service-row .text-link :global(svg) { flex: none; }
  .services-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    border-top: 1px solid var(--color-line);
    padding-block: 1.75rem .75rem;
  }
  .services-contact p { max-width: 55ch; margin: 0; }
  @media (max-width: 54rem) {
    .services-intro { gap: 1.75rem; }
    .services-intro h1 { font-size: 2.65rem; }
  }
  @media (max-width: 42rem) {
    .service-row, .services-intro { grid-template-columns: minmax(0, 1fr); }
    .services-intro { padding-block-start: .25rem; }
    .services-intro h1 { font-size: 2.3rem; }
  }
</style>
