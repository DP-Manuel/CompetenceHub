---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConnectedPageHero from "../components/ConnectedPageHero.astro";
import Icon from "../components/Icon.astro";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const services = [
  {
    eyebrow: "Mindforge",
    title: "Coaching und Beratung bündeln",
    text: "Beratungsgespräche für Privatpersonen sowie Businesscoaching und abgestimmte Beratung für Unternehmen.",
    href: "mindforge",
    id: undefined,
    icon: "sparkles" as const,
  },
  {
    eyebrow: "Recruiting",
    title: "Menschen und Aufgaben passend verbinden",
    text: "Wir klären Anforderungsprofil, Unternehmenskontext und Auswahlweg. So können passende Fachkräfte, Potenziale und praktische Fähigkeiten gezielt zusammengebracht werden.",
    href: "kontakt",
    id: "recruiting",
    icon: "user-round" as const,
  },
  {
    eyebrow: "Personalentwicklung",
    title: "Potenziale erkennen und Entwicklung begleiten",
    text: "Je nach Anliegen können Coaching, Development Assessment Center oder Supervision die nächsten Schritte unterstützen. Mediation wird nur bei bestätigter Qualifikation und Verfügbarkeit im Netzwerk vermittelt.",
    href: "unternehmen#assessment-center",
    id: "personalentwicklung",
    icon: "building" as const,
  },
  {
    eyebrow: "Workshops & Vorträge",
    title: "Wissen gemeinsam weitergeben",
    text: "Für Wissenstransfer, Lernimpulse und konkrete Themen in Gruppen.",
    href: "kontakt",
    id: "gruppenformate",
    icon: "users" as const,
  },
];

const faqs = [
  {
    question: "Wie finde ich die passende Leistung?",
    answer: "Am Anfang stehen Anlass, Zielgruppe und gewünschte Veränderung. Competence Hub ordnet das Anliegen ein und empfiehlt anschließend eine passende Expertise und ein geeignetes Format.",
  },
  {
    question: "Welche Angebote richten sich an Unternehmen?",
    answer: "Unternehmen können unter anderem Recruiting, Personalentwicklung, Businesscoaching, Workshops und Vorträge anfragen. Der konkrete Umfang wird gemeinsam aus dem betrieblichen Bedarf abgeleitet.",
  },
  {
    question: "Was gehört zur Personalentwicklung?",
    answer: "Zur Personalentwicklung können je nach Ziel Coaching, Development Assessment Center oder Supervision gehören. Mediation wird nur bei bestätigter Qualifikation und Verfügbarkeit im Netzwerk vermittelt.",
  },
  {
    question: "Gibt es auch Angebote für Privatpersonen?",
    answer: "Ja. Mindforge bietet Beratungsgespräche für persönliche und berufliche Entwicklung. Auf der Mindforge-Seite finden Privatpersonen einen eigenen Einstieg.",
  },
  {
    question: "Wie startet eine Anfrage?",
    answer: "Über die Kontaktseite werden Anlass, Zielgruppe, gewünschter Schwerpunkt und Zeitraum beschrieben. Danach wird der passende nächste Schritt gemeinsam geklärt.",
  },
  {
    question: "Erbringt Competence Hub die Leistungen selbst?",
    answer: "Competence Hub klärt den Bedarf und vermittelt passende Coaches oder Expertinnen und Experten aus dem Netzwerk. Durchführung, Umfang und Rahmen werden anschließend transparent abgestimmt.",
  },
];
---

<BaseLayout
  title="Leistungen | Competence Hub"
  description="Competence Hub verbindet Privatpersonen und Unternehmen mit Mindforge Coaching und Beratung, Recruiting, Assessment Center, Supervision, Mediation und Gruppenformaten."
>
  <main class="subpage">
    <ConnectedPageHero
      eyebrow="Leistungen"
      title="Das Thema zuerst. Dann die passende Expertise."
      lead="Competence Hub klärt den Bedarf und vermittelt ausgewählte Coaches oder Expertinnen und Experten. So finden Privatpersonen und Unternehmen einen passenden Einstieg, ohne sich zuerst durch einen großen Katalog arbeiten zu müssen."
      centerLabel="Leistungen"
      centerDetail="Passende Formate"
      centerIcon="briefcase"
      titleId="services-title"
      related={[
        {
          label: "Mindforge",
          detail: "Coaching & Beratung",
          href: "mindforge",
          icon: "sparkles",
        },
        {
          label: "Recruiting",
          detail: "Bedarf & Auswahl",
          href: "#recruiting",
          icon: "user-round",
        },
        {
          label: "Personal",
          labelSuffix: "entwicklung",
          detail: "Potenziale & Entwicklung",
          href: "#personalentwicklung",
          icon: "building",
        },
        {
          label: "Workshops & Vorträge",
          detail: "Gemeinsam lernen",
          href: "#gruppenformate",
          icon: "users",
        },
      ]}
    >
      <div slot="actions" class="actions">
        <a class="button" href={url("kontakt")}>Anfrage stellen</a>
        <a class="button button--ghost" href={url("mindforge")}>Mindforge entdecken</a>
        <a class="button button--ghost" href={url("unternehmen")}>Für Unternehmen</a>
      </div>
    </ConnectedPageHero>

    <section class="offer-grid offer-grid--services" id="angebote" aria-label="Angebotsübersicht">
      {services.map((service) => (
        <article class="offer-card" id={service.id}>
          <span class="offer-card__icon"><Icon name={service.icon} size={30} /></span>
          <p class="eyebrow">{service.eyebrow}</p>
          <h2>{service.title}</h2>
          <p>{service.text}</p>
          <a class="text-link" href={url(service.href)}>Mehr erfahren</a>
        </article>
      ))}
    </section>

    <section class="cta-panel">
      <div>
        <p class="eyebrow">Noch unsicher?</p>
        <h2>Wir ordnen Ihr Anliegen gemeinsam ein.</h2>
        <p>Eine kurze Beschreibung reicht für eine erste Empfehlung.</p>
      </div>
      <a class="button" href={url("kontakt")}>Bedarf klären</a>
    </section>

    <section class="faq-section" aria-labelledby="services-faq-title">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="services-faq-title">Häufige Fragen zu den Leistungen</h2>
      </div>
      <div class="faq-grid">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
