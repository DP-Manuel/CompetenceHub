---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConnectedPageHero from "../components/ConnectedPageHero.astro";
import Icon from "../components/Icon.astro";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const services = [
  {
    eyebrow: "Mindforge",
    title: "Coaching und Beratung bündeln",
    text: "Life Coaching und Business Coaching für Selbstzahlende sowie Firmencoaching und abgestimmte Beratung für Unternehmen.",
    href: "mindforge",
    id: undefined,
    icon: "sparkles" as const,
  },
  {
    eyebrow: "Recruiting & Personalentwicklung",
    title: "Potenziale passend verbinden",
    text: "Für Mitarbeitergewinnung, Führung und Entwicklung mit Blick auf praktische Fähigkeiten und Unternehmensbedarf.",
    href: "unternehmen#assessment-center",
    id: "recruiting",
    icon: "building" as const,
  },
  {
    eyebrow: "Workshops & Vorträge",
    title: "Wissen gemeinsam weitergeben",
    text: "Für Wissenstransfer, Lernimpulse und konkrete Themen in Gruppen.",
    href: "kontakt",
    id: "gruppenformate",
    icon: "users" as const,
  },
  {
    eyebrow: "Supervision & Mediation",
    title: "Zusammenarbeit professionell reflektieren",
    text: "Supervision wird passend zum Bedarf vermittelt. Mediation folgt nur nach bestätigter Qualifikation und Verfügbarkeit im Netzwerk.",
    href: "kontakt",
    id: "supervision-mediation",
    icon: "message-circle" as const,
  },
];

const faqs = [
  {
    question: "Welche Angebote bündelt Mindforge?",
    answer: "Mindforge verbindet Life Coaching und Business Coaching für Selbstzahlende mit Firmencoaching und abgestimmter Beratung für Unternehmen. Das konkrete Angebot wird nach Zielgruppe und Anliegen eingeordnet.",
  },
  {
    question: "Können auch Privatpersonen Mindforge nutzen?",
    answer: "Ja. Mindforge bietet freigegebene Life-Coaching-Pakete für Selbstzahlende sowie Angebote für Mitarbeitende und Führungskräfte in Unternehmen.",
  },
  {
    question: "Wie startet eine Anfrage?",
    answer: "Über die Kontaktseite werden Anlass, Zielgruppe, gewünschter Schwerpunkt und Zeitraum beschrieben. Danach wird der passende nächste Schritt gemeinsam geklärt.",
  },
  {
    question: "Erbringt Competence Hub die Leistungen selbst?",
    answer: "Competence Hub klärt den Bedarf und vermittelt passende Coaches oder Expertinnen und Experten aus dem Netzwerk. Durchführung, Umfang und Rahmen werden anschließend transparent abgestimmt.",
  },
  {
    question: "Gehört Recruiting bereits zum Angebot?",
    answer: "Ja. Assessment Center können bei Personalauswahl und interner Personalentwicklung eingesetzt werden. Planung, Konzeption und Full-Service-Durchführung werden passend zum Unternehmensbedarf abgestimmt.",
  },
];
---

<BaseLayout
  title="Leistungen | Competence Hub"
  description="Competence Hub verbindet Privatpersonen und Unternehmen mit Mindforge Coaching und Beratung, Recruiting, Assessment Center, Supervision, Mediation und Gruppenformaten."
>
  <main class="subpage">
    <ConnectedPageHero
      eyebrow="Leistungen"
      title="Das Thema zuerst. Dann die passende Expertise."
      lead="Competence Hub klärt den Bedarf und vermittelt ausgewählte Coaches oder Expertinnen und Experten. So finden Privatpersonen und Unternehmen einen passenden Einstieg, ohne sich zuerst durch einen großen Katalog arbeiten zu müssen."
      centerLabel="Leistungen"
      centerDetail="Passende Formate"
      centerIcon="briefcase"
      titleId="services-title"
      related={[
        {
          label: "Mindforge",
          detail: "Coaching & Beratung",
          href: "mindforge",
          icon: "sparkles",
        },
        {
          label: "Assessment Center",
          detail: "Auswahl & Entwicklung",
          href: "unternehmen#assessment-center",
          icon: "user-round",
        },
        {
          label: "Workshops & Vorträge",
          detail: "Gemeinsam lernen",
          href: "#gruppenformate",
          icon: "users",
        },
      ]}
    >
      <div slot="actions" class="actions">
        <a class="button" href={url("kontakt")}>Anfrage stellen</a>
        <a class="button button--ghost" href={url("mindforge")}>Mindforge entdecken</a>
        <a class="button button--ghost" href={url("unternehmen")}>Für Unternehmen</a>
      </div>
    </ConnectedPageHero>

    <section class="offer-grid offer-grid--services" id="angebote" aria-label="Angebotsübersicht">
      {services.map((service) => (
        <article class="offer-card" id={service.id}>
          <span class="offer-card__icon"><Icon name={service.icon} size={30} /></span>
          <p class="eyebrow">{service.eyebrow}</p>
          <h2>{service.title}</h2>
          <p>{service.text}</p>
          <a class="text-link" href={url(service.href)}>Mehr erfahren</a>
        </article>
      ))}
    </section>

    <section class="cta-panel">
      <div>
        <p class="eyebrow">Noch unsicher?</p>
        <h2>Wir ordnen Ihr Anliegen gemeinsam ein.</h2>
        <p>Eine kurze Beschreibung reicht für eine erste Empfehlung.</p>
      </div>
      <a class="button" href={url("kontakt")}>Bedarf klären</a>
    </section>

    <section class="faq-section" aria-labelledby="services-faq-title">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="services-faq-title">Häufige Fragen zu den Leistungen</h2>
      </div>
      <div class="faq-grid">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
