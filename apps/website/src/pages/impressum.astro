---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Impressum | Competence Hub"
  description="Rechtliche Zuordnung von Competence Hub zu Donner + Partner und Verweis auf das zentrale Impressum."
  noindex
>
  <main class="subpage">
    <section class="page-hero legal-hero">
      <p class="eyebrow">Impressum</p>
      <h1>Impressum für Competence Hub</h1>
      <p>
        Competence Hub ist ein Angebot von Donner + Partner. Verantwortlicher
        Ansprechpartner ist Lars Donner. Die verbindlichen Anbieterangaben
        stehen im zentralen Impressum von Donner + Partner.
      </p>
      <a
        class="button button--ghost"
        href="https://donner-partner.de/dp/impressum/"
      >
        Zentrales Impressum öffnen
      </a>
    </section>

    <section class="notice-panel">
      <div>
        <p class="eyebrow">Rechtlicher Bezug</p>
        <h2>Zentrale Angaben von Donner + Partner</h2>
      </div>
      <p>
        Für Impressum und Allgemeine Geschäftsbedingungen gelten zunächst die
        zentral veröffentlichten Fassungen von Donner + Partner.
      </p>
    </section>
  </main>
</BaseLayout>
