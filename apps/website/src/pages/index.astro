---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import LivingHubPrototype from "../components/LivingHubPrototype.astro";
import { coaches } from "../data/coaches";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const trustPoints = [
  {
    text: "Für Unternehmen & Privatpersonen",
    icon: "building" as const,
  },
  {
    text: "Ausgewählte Coaches",
    icon: "shield-check" as const,
  },
  {
    text: "Persönliche Bedarfsklärung",
    icon: "message-circle" as const,
  },
  {
    text: "Frau Janay Rappelt als Ansprechpartnerin",
    icon: "user-round" as const,
  },
];

const coachPreview = coaches.map((coach) => ({
  name: coach.name,
  role: coach.previewRole,
  href: coach.profilePath,
  image: coach.image,
  imageWidth: coach.imageWidth,
  imageHeight: coach.imageHeight,
  initials: coach.initials,
}));

---

<BaseLayout
  title="Competence Hub | Coaching für Unternehmen und Privatpersonen"
  description="Competence Hub verbindet Unternehmen und Privatpersonen mit Mindforge Coaching und Beratung, Recruiting, Gruppenformaten und ausgewählten Coaches."
  bodyClass="home-page"
>
  <LivingHubPrototype variant="c" prototypeMode={false}>
    <Fragment slot="before-journey">
      <section class="trust-strip" aria-label="Competence Hub auf einen Blick">
        {trustPoints.map((point) => (
          <article>
            <Icon name={point.icon} size={24} />
            <strong>{point.text}</strong>
          </article>
        ))}
      </section>
    </Fragment>

    <section class="coach-preview" aria-labelledby="coach-spotlight-title">
      <div class="coach-preview__heading">
        <div>
          <p class="eyebrow">Kuratiertes Coach-Netzwerk</p>
          <h2 id="coach-spotlight-title">Expertise hat ein Gesicht</h2>
        </div>
        <div class="coach-preview__summary">
          <p>
            Profile mit klaren Schwerpunkten und unterschiedlichen fachlichen
            Zugängen.
          </p>
          <div class="coach-preview__controls" role="group" aria-label="Coach-Profile steuern">
            <button
              class="coach-preview__control"
              type="button"
              aria-label="Vorheriges Coach-Profil"
              title="Vorheriges Coach-Profil"
              data-coach-previous
            >
              <span class="coach-preview__control-icon--previous">
                <Icon name="arrow-right" size={20} />
              </span>
            </button>
            <button
              class="coach-preview__control"
              type="button"
              aria-pressed="false"
              aria-label="Coach-Laufband pausieren"
              title="Coach-Laufband pausieren"
              data-coach-toggle
            >
              <span data-coach-pause-icon><Icon name="pause" size={20} /></span>
              <span data-coach-play-icon hidden><Icon name="play" size={20} /></span>
            </button>
            <button
              class="coach-preview__control"
              type="button"
              aria-label="Nächstes Coach-Profil"
              title="Nächstes Coach-Profil"
              data-coach-next
            >
              <Icon name="arrow-right" size={20} />
            </button>
          </div>
        </div>
      </div>
      <div
        class="coach-preview__carousel"
        data-coach-carousel
      >
        <div class="coach-preview__viewport" data-coach-viewport>
          <div class="coach-preview__track" data-coach-track>
        {coachPreview.map((coach) => (
          <a
            class="coach-preview__card"
            href={url(coach.href)}
          >
            <span class:list={["coach-preview__visual", { "coach-preview__visual--image": coach.image }]}>
              {coach.image ? (
                <img
                  src={url(coach.image)}
                  alt={`Porträt von ${coach.name}`}
                  width={coach.imageWidth ?? 830}
                  height={coach.imageHeight ?? 830}
                  loading="lazy"
                />
              ) : (
                <strong aria-hidden="true">{coach.initials}</strong>
              )}
            </span>
            <span class="coach-preview__copy">
              <strong>{coach.name}</strong>
              <small>{coach.role}</small>
            </span>
          </a>
        ))}
          </div>
        </div>
      </div>
      <a class="text-link" href={url("coaches")}>Alle Coach-Profile ansehen</a>
    </section>

    <section class="contact-lead" id="anfrage" aria-labelledby="contact-lead-title">
      <div class="contact-lead__person">
        <span class="contact-lead__portrait">
          <img
            src={url("images/team/janay-rappelt.jpg")}
            alt="Frau Janay Rappelt"
            width="1066"
            height="1600"
            loading="lazy"
          />
        </span>
        <div>
          <small>Ihre Ansprechpartnerin</small>
          <strong>Frau Janay Rappelt</strong>
          <p>Persönliche Verbindung zwischen Anliegen und passender Expertise</p>
        </div>
      </div>
      <div class="contact-lead__copy">
        <p class="eyebrow">Nächster Schritt</p>
        <h2 id="contact-lead-title">Wobei dürfen wir Sie unterstützen?</h2>
        <p>Eine kurze Beschreibung reicht für die erste Einordnung.</p>
        <a class="button" href={url("kontakt")}>Bedarf besprechen</a>
      </div>
    </section>
  </LivingHubPrototype>
</BaseLayout>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-coach-carousel]");

  carousels.forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-coach-track]");
    const viewport = carousel.querySelector<HTMLElement>("[data-coach-viewport]");
    const cards = Array.from(
      track?.querySelectorAll<HTMLElement>(".coach-preview__card") || [],
    );
    const section = carousel.closest(".coach-preview");
    const toggle = section?.querySelector<HTMLButtonElement>("[data-coach-toggle]");
    const previous = section?.querySelector<HTMLButtonElement>("[data-coach-previous]");
    const next = section?.querySelector<HTMLButtonElement>("[data-coach-next]");
    const pauseIcon = toggle?.querySelector<HTMLElement>("[data-coach-pause-icon]");
    const playIcon = toggle?.querySelector<HTMLElement>("[data-coach-play-icon]");

    if (!track || !viewport || cards.length === 0 || !toggle || !previous || !next) return;

    let currentIndex = 0;
    let autoAdvance: number | undefined;

    const showCard = (target: number) => {
      currentIndex = (target + cards.length) % cards.length;
      viewport.scrollTo({
        left: cards[currentIndex].offsetLeft - track.offsetLeft,
        behavior: "smooth",
      });
    };

    const stopAutoAdvance = () => {
      if (autoAdvance !== undefined) window.clearInterval(autoAdvance);
      autoAdvance = undefined;
    };

    const startAutoAdvance = () => {
      stopAutoAdvance();
      if (carousel.dataset.paused === "true") return;
      autoAdvance = window.setInterval(() => showCard(currentIndex + 1), 6500);
    };

    const setPaused = (paused: boolean) => {
      carousel.dataset.paused = paused ? "true" : "false";
      toggle.setAttribute("aria-pressed", paused ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        paused ? "Coach-Laufband fortsetzen" : "Coach-Laufband pausieren",
      );
      toggle.title = paused
        ? "Coach-Laufband fortsetzen"
        : "Coach-Laufband pausieren";
      if (pauseIcon) pauseIcon.hidden = paused;
      if (playIcon) playIcon.hidden = !paused;
      paused ? stopAutoAdvance() : startAutoAdvance();
    };

    carousel.classList.add("is-ready");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setPaused(true);
    } else {
      setPaused(false);
    }

    toggle.addEventListener("click", () => {
      setPaused(carousel.dataset.paused !== "true");
    });

    previous.addEventListener("click", () => {
      setPaused(true);
      showCard(currentIndex - 1);
    });

    next.addEventListener("click", () => {
      setPaused(true);
      showCard(currentIndex + 1);
    });

    viewport.addEventListener("focusin", stopAutoAdvance);
    viewport.addEventListener("focusout", startAutoAdvance);
  });
</script>
