---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import LivingHubPrototype from "../components/LivingHubPrototype.astro";
import { featuredCoaches } from "../data/coaches";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}/${path}`;
---

<BaseLayout
  title="Competence Hub | Coaching für Unternehmen und Privatpersonen"
  description="Coaching, Beratung und Workshops für Unternehmen und Privatpersonen. Lernen Sie die Coaches und passenden Formate im Competence Hub kennen."
  bodyClass="home-page"
>
  <LivingHubPrototype variant="c" prototypeMode={false}>
    <section class="portrait-section" aria-labelledby="coach-spotlight-title">
      <header class="portrait-section__heading">
        <div>
          <p class="eyebrow">Coach-Netzwerk</p>
          <h2 id="coach-spotlight-title">Die Menschen hinter der Expertise</h2>
        </div>
        <a class="text-link" href={url("coaches")}>Zum Coach-Netzwerk <Icon name="arrow-right" size={20} /></a>
      </header>
      <div class="portrait-pair">
        {featuredCoaches.map((coach) => (
          <article class="portrait-story" data-spotlight-coach={coach.profilePath.split("/").at(-1)}>
            {coach.image && (
              <div class="portrait-story__image">
                <img src={url(coach.image)} alt={`Porträt: ${coach.name}`}
                  width={coach.imageWidth} height={coach.imageHeight} loading="lazy" decoding="async" />
              </div>
            )}
            <div class="portrait-story__copy">
              <p class="eyebrow">{coach.previewRole}</p>
              <h3><a class="portrait-story__name" href={url(coach.profilePath)}>{coach.name}</a></h3>
              <p>{coach.text}</p>
              <a class="text-link" href={url(coach.profilePath)} aria-label={`Zum Profil von ${coach.name}`}>
                Zum Profil <Icon name="arrow-right" size={20} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="home-contact" id="anfrage" aria-labelledby="home-contact-title">
      <div class="home-contact__inner">
        <div class="home-contact__copy">
          <p class="eyebrow">Persönlicher Kontakt</p>
          <h2 id="home-contact-title">Wobei dürfen wir Sie unterstützen?</h2>
          <p>Frau Rappelt hilft Ihnen, das passende Format und die richtige Ansprechperson zu finden.</p>
          <a class="button" href={url("kontakt")}>Bedarf besprechen <Icon name="arrow-right" size={20} /></a>
        </div>
        <figure class="home-contact__person">
          <img src={url("images/team/janay-rappelt.jpg")} alt="Porträt von Frau Rappelt"
            width="1066" height="1600" loading="lazy" decoding="async" />
          <figcaption><strong>Frau Rappelt</strong><span>Ihre Ansprechpartnerin</span></figcaption>
        </figure>
      </div>
    </section>
  </LivingHubPrototype>
</BaseLayout>

<style>
  .portrait-section, .home-contact__inner {
    width: min(100% - 48px, 1200px);
    margin-inline: auto;
  }
  .portrait-section {
    padding-block: 76px 88px;
  }
  .portrait-section__heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 32px;
    margin-bottom: 38px;
  }
  .portrait-section__heading .eyebrow, .portrait-story__copy .eyebrow, .home-contact .eyebrow {
    margin: 0 0 10px;
  }
  .portrait-section .eyebrow { color: var(--color-pantone-deep); }
  .portrait-section__heading h2, .home-contact h2 {
    max-width: 20ch;
    margin: 0;
    font-size: 3rem;
    line-height: 1.12;
    overflow-wrap: anywhere;
  }
  .portrait-pair {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, .88fr);
    gap: 56px;
    align-items: start;
  }
  .portrait-story:nth-child(even) { margin-top: 44px; }
  .portrait-story__image {
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--color-soft);
    border-bottom: 6px solid var(--color-pantone);
  }
  .portrait-story:nth-child(even) .portrait-story__image { border-color: var(--color-red); }
  .portrait-story__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transition: scale 200ms ease;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .portrait-story:hover img, .portrait-story:focus-within img { scale: 1.025; }
  }
  .portrait-story__copy { padding-top: 22px; }
  .portrait-story__copy h3 {
    margin: 0 0 10px;
    font-size: 2rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .portrait-story__copy p:not(.eyebrow) { max-width: 56ch; margin: 0 0 10px; }
  .portrait-story__name { text-decoration: none; }
  .portrait-story__name:hover { text-decoration: underline; }
  .portrait-section .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .portrait-section .text-link :global(svg), .home-contact .button :global(svg) { flex: none; }
  .home-contact {
    background: #00575d;
    color: white;
    padding-block: 56px;
    border-top: 6px solid var(--color-pantone);
    scroll-margin-top: 120px;
  }
  .home-contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .48fr);
    align-items: center;
    gap: 24px 48px;
  }
  .home-contact h2, .home-contact p { color: inherit; }
  .home-contact .eyebrow { color: #ffb758; }
  .home-contact__copy > p:not(.eyebrow) { margin: 14px 0 22px; max-width: 54ch; }
  .home-contact .button { justify-content: center; gap: 10px; }
  .home-contact .button:focus-visible { outline-color: white; }
  .home-contact__person {
    display: grid;
    grid-template-columns: minmax(0, 116px) minmax(0, 1fr);
    align-items: end;
    gap: 16px;
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid #89bbb9;
  }
  .home-contact__person img { display: block; width: 100%; height: auto; }
  .home-contact__person strong, .home-contact__person span { display: block; }
  @media (max-width: 820px) {
    .portrait-section { padding-block: 54px 64px; }
    .portrait-pair { gap: 26px; }
    .portrait-story:nth-child(even) { margin-top: 26px; }
    .portrait-section__heading h2, .home-contact h2 { font-size: 2.375rem; }
    .portrait-story__copy h3 { font-size: 1.65rem; }
  }
  @media (max-width: 580px) {
    .portrait-section, .home-contact__inner { width: calc(100% - 32px); }
    .portrait-section__heading { margin-bottom: 22px; }
    .portrait-pair, .home-contact__inner { grid-template-columns: minmax(0, 1fr); }
    .portrait-pair { gap: 36px; }
    .portrait-story:nth-child(even) { margin-top: 0; }
    .portrait-story__copy { padding-top: 16px; }
    .portrait-section__heading h2, .home-contact h2 { font-size: 2rem; }
    .home-contact { padding-block: 42px; }
  }
</style>
