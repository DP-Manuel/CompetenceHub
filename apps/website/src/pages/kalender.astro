---
import BaseLayout from "../layouts/BaseLayout.astro";
import UpcomingEvents from "../components/UpcomingEvents.astro";
import "../styles/global.css";
import { publicCalendarPath } from "../v2-local/journey.mjs";
const local = __WEBSITE_V2_LOCAL__;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Veranstaltungskalender | Competence Hub"
  description="Workshops und Vorträge im Competence Hub: Entdecken Sie mögliche Formate oder besprechen Sie Ihr Veranstaltungsvorhaben mit Frau Rappelt."
  noindex
>
  <main class="subpage">
    <section class="page-hero page-hero--accent">
      <div>
        <p class="eyebrow">Workshops und Vorträge</p>
        <h1>Veranstaltungskalender</h1>
        <p>Interesse an einem Workshop oder Vortrag? Frau Rappelt klärt mit Ihnen Zielgruppe, Thema und das passende Format.</p>
        <div class="actions">
          <a class="button" href={`${base}/kontakt/?thema=workshop`}>Veranstaltung anfragen</a>
          <a class="button button--ghost" href={`${base}/leistungen/#gruppenformate`}>Workshops &amp; Vorträge</a>
        </div>
      </div>
    </section>
    <UpcomingEvents live={local} calendarHref={publicCalendarPath} />
  </main>
</BaseLayout>
