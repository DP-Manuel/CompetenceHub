---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import RoomPicture from "../../components/RoomPicture.astro";
import RoomGallery from "../../components/RoomGallery.astro";
import { photoFor, previewCities } from "../../data/venues.mjs";
import "../../styles/global.css";

export function getStaticPaths() {
  return import.meta.env.PUBLIC_REVIEW_MODE === "true" && previewCities.length
    ? [{ params: { city: undefined } }] : [];
}

const lead = previewCities[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}/${path}`;
const location = previewCities.length === 1 ? ` in ${lead.name}` : "";
---

<BaseLayout title={`Veranstaltungsorte${location} | Competence Hub`}
  description={`Mögliche Räume für Workshops, Seminare und Unternehmensveranstaltungen${location}. Eindrücke ansehen und die Durchführung mit Frau Rappelt abstimmen.`}
  canonical={false} socialImage={url(`images/venues/${lead.id}/${lead.lead}-960.jpg`)}>
  <main class="venues">
    <header class="venue-hero">
      <RoomPicture photo={photoFor(lead, lead.lead)} city={lead.id} sizes="100vw" priority />
      <div class="venue-hero__label">
        <div class="venue-wrap">
          <p class="eyebrow">{previewCities.length === 1 ? lead.name : "Workshops und Seminare"}</p>
          <h1>Veranstaltungsorte</h1>
          <p>Der passende Raum für neue Perspektiven.</p>
        </div>
      </div>
    </header>

    {previewCities.length > 1 && (
      <nav aria-label="Standorte" class="venue-wrap venue-cities">
        {previewCities.map((city) => <a class="text-link" href={`#${city.id}`}>{city.name}</a>)}
      </nav>
    )}

    {previewCities.map((city) => (
      <section aria-labelledby={`location-${city.id}`} id={city.id}>
        <div class="venue-wrap venue-intro">
          <div>
            <p class="eyebrow">Planung vor Ort</p>
            <h2 id={`location-${city.id}`}>{city.name}</h2>
          </div>
          <p>Ob Workshop, Seminar oder Austausch im kleinen Kreis: Die Bilder geben einen Eindruck möglicher Räume. Welcher Ort und welche Bestuhlung zu Ihrer Veranstaltung passen, stimmen wir persönlich ab.</p>
        </div>
        <RoomGallery {city} />
        <div class="venue-wrap venue-planning">
          <div>
            <p class="eyebrow">Persönliche Veranstaltungsplanung</p>
            <h3>Planen Sie mit Frau Rappelt.</h3>
            <p>Besprechen Sie Thema, Gruppe und Rahmen Ihrer Veranstaltung. Ort und Verfügbarkeit klären wir für Ihre Anfrage individuell.</p>
          </div>
          <div class="venue-links">
            <a class="button" href={url(`kontakt/?ort=${city.id}`)}>Workshop in {city.name} anfragen <Icon name="arrow-right" size={19} /></a>
            <a class="text-link" href={url("leistungen/#gruppenformate")}>Workshops &amp; Vorträge <Icon name="arrow-right" size={17} /></a>
          </div>
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .venues { width: 100%; padding: 0; }
  .venues :global(.venue-wrap) { inline-size: min(calc(100% - 2rem), 73rem); margin-inline: auto; }
  .venue-hero { display: grid; position: relative; isolation: isolate; align-items: end; min-block-size: 28rem; background: #41524e; overflow: hidden; }
  .venue-hero :global(.room-picture) { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .venue-hero :global(.room-picture img) { position: absolute; inset: 0; width: 100%; height: 100% !important; object-fit: cover; object-position: 50% 72%; }
  .venue-hero__label { background: rgba(14, 38, 38, .91); color: white; padding-block: .9rem 1.15rem; border-block-start: 4px solid var(--color-red); }
  .venue-hero__label .eyebrow { color: #d4f3f2; margin: 0 0 .2rem; }
  .venue-hero__label h1 { color: white; font-size: 3.3rem; margin: 0; }
  .venue-hero__label p:last-child { color: white; margin: .25rem 0 0; font-size: 1.1rem; }
  h1, h2, h3 { line-height: 1.16; letter-spacing: 0; hyphens: auto; overflow-wrap: anywhere; }
  h2 { margin: 0; font-size: 2.65rem; }
  h3 { margin: 0; font-size: 1.65rem; }
  .venue-intro, .venue-planning { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); align-items: center; gap: .7rem 2rem; padding-block: 2.65rem; }
  .venue-intro p, .venue-planning p { max-inline-size: 58ch; }
  .venue-intro .eyebrow, .venue-planning .eyebrow { margin-block: 0 .25rem; }
  .venue-links { display: flex; flex-wrap: wrap; gap: .7rem 1rem; align-items: center; }
  .venue-links :is(.button, .text-link) { display: inline-flex; gap: .5rem; align-items: center; min-height: 44px; max-width: 100%; white-space: normal; }
  .venue-links :global(svg) { flex-shrink: 0; }
  .venue-cities { display: flex; gap: 1rem; padding-block: 1rem; }
  @media (max-width: 45rem) {
    .venue-hero { min-block-size: 20rem; }
    .venue-hero__label h1 { font-size: 2rem; }
    .venue-intro, .venue-planning { grid-template-columns: minmax(0, 1fr); padding-block: 1.7rem; }
    h2 { font-size: 2rem; }
    h3 { font-size: 1.35rem; }
  }
</style>
