---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { coaches, coachTopics } from "../data/coaches";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

---

<BaseLayout
  title="Coach-Netzwerk | Competence Hub"
  description="Competence Hub vermittelt ausgewählte Coaches für Unternehmen und Privatpersonen in den Bereichen Führung, Vertrieb, Life Coaching, Recruiting, Psychologie, Gesundheit und Entwicklung."
>
  <main class="subpage">
    <section class="page-hero page-hero--accent coach-list-hero">
      <div>
        <p class="eyebrow">Coach-Netzwerk</p>
        <h1>Ausgewählte Coaches statt endlosem Katalog</h1>
        <p>
          Bei Competence Hub stehen die Coaches und ihre Leistungen im
          Mittelpunkt. Wir verbinden Unternehmen und Privatpersonen mit
          Menschen, deren Erfahrung, Schwerpunkt und Arbeitsweise zum konkreten
          Anliegen passen.
        </p>
        <div class="actions">
          <a class="button" href={url("kontakt")}>Coaching-Bedarf besprechen</a>
          <a class="button button--ghost" href={url("kontakt")}>Als Coach vorstellen</a>
        </div>
      </div>
      <aside class="coach-list-hero__note" aria-label="Netzwerkanspruch">
        <span>Netzwerkanspruch</span>
        <strong>Passend.<br />Erfahren.<br />Verlässlich.</strong>
      </aside>
    </section>

    <section
      class="coach-topic-explorer"
      aria-labelledby="coach-topic-title"
      data-coach-topic-explorer
    >
      <div class="coach-topic-explorer__heading">
        <div>
          <p class="eyebrow">Nach Thema orientieren</p>
          <h2 id="coach-topic-title">Ein Thema kann mehrere Perspektiven brauchen.</h2>
        </div>
        <p>
          Wählen Sie einen Schwerpunkt. Passende Profile werden gemeinsam
          sichtbar, auch wenn sich fachliche Zugänge überschneiden.
        </p>
      </div>
      <div
        class="coach-topic-filter"
        role="group"
        aria-label="Coach-Profile nach Themenschwerpunkt filtern"
      >
        <button
          type="button"
          class="coach-topic-filter__option is-active"
          data-coach-topic="all"
          aria-pressed="true"
          aria-controls="coach-profile-grid"
        >
          <Icon name="compass" size={22} />
          <span>Alle Themen</span>
        </button>
        {coachTopics.map((topic) => (
          <button
            type="button"
            class="coach-topic-filter__option"
            data-coach-topic={topic.id}
            aria-pressed="false"
            aria-controls="coach-profile-grid"
            title={topic.detail}
          >
            <Icon name={topic.icon} size={22} />
            <span>{topic.label}</span>
          </button>
        ))}
      </div>
      <p
        class="coach-topic-status"
        aria-live="polite"
        data-coach-topic-status
      >
        Alle Coach-Profile werden angezeigt.
      </p>
    </section>

    <section
      class="coach-grid"
      id="coach-profile-grid"
      aria-label="Vorhandene Coach-Profile"
      data-coach-profile-grid
    >
      {coaches.map((coach) => (
        <article
          class="coach-card coach-card--featured"
          data-coach-card
          data-coach-topics={coach.topics.join(" ")}
        >
          <div class="coach-card__media">
            {coach.image ? (
              <img
                src={url(coach.image)}
                alt={`Porträt: ${coach.name}`}
                width={coach.imageWidth ?? 830}
                height={coach.imageHeight ?? 830}
                loading="lazy"
              />
            ) : (
              <span class="coach-card__monogram" aria-hidden="true">{coach.initials}</span>
            )}
          </div>
          <div>
            <p class="eyebrow">Coach-Profil</p>
            <h2>{coach.name}</h2>
            <strong>{coach.role}</strong>
            <ul class="tag-list" aria-label="Themenschwerpunkte">
              {coach.focus.map((topic) => <li>{topic}</li>)}
            </ul>
            <p>{coach.text}</p>
            <a class="button button--ghost" href={url(coach.profilePath)}>
              Profil ansehen
            </a>
          </div>
        </article>
      ))}
    </section>

    <p class="coach-topic-empty" data-coach-topic-empty hidden>
      Für diesen Themenbereich ist aktuell noch kein ausdrücklich
      qualifiziertes und freigegebenes Coach-Profil veröffentlicht.
    </p>

    <section class="network-growth-note" aria-labelledby="network-growth-title">
      <p class="eyebrow">Netzwerk im Aufbau</p>
      <h2 id="network-growth-title">Das Netzwerk wächst bewusst</h2>
      <p>
        Die veröffentlichten Profile zeigen unterschiedliche fachliche
        Zugänge. Weitere Coaches ergänzen wir erst, wenn Schwerpunkte,
        Qualifikationen, Texte und Bildfreigaben abgestimmt sind.
      </p>
    </section>

    <section class="cta-panel">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h2>Coach-Profil oder Unternehmensbedarf besprechen</h2>
      </div>
      <a class="button" href={url("kontakt")}>Bedarf besprechen</a>
    </section>
  </main>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-coach-topic-explorer]")
    .forEach((explorer) => {
      const buttons = Array.from(
        explorer.querySelectorAll<HTMLButtonElement>("[data-coach-topic]"),
      );
      const grid = document.querySelector<HTMLElement>(
        "[data-coach-profile-grid]",
      );
      const cards = Array.from(
        grid?.querySelectorAll<HTMLElement>("[data-coach-card]") || [],
      );
      const status = explorer.querySelector<HTMLElement>(
        "[data-coach-topic-status]",
      );
      const emptyState = document.querySelector<HTMLElement>(
        "[data-coach-topic-empty]",
      );
      const labels = new Map(
        buttons.map((button) => [
          button.dataset.coachTopic || "all",
          button.textContent?.trim() || "Alle Themen",
        ]),
      );

      explorer.classList.add("is-enhanced");

      const applyTopic = (topic: string, updateUrl = true) => {
        const selected = labels.has(topic) ? topic : "all";

        buttons.forEach((button) => {
          const active = button.dataset.coachTopic === selected;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", String(active));
        });

        let visibleCount = 0;
        cards.forEach((card) => {
          const topics = (card.dataset.coachTopics || "").split(" ");
          const visible = selected === "all" || topics.includes(selected);
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (status) {
          status.textContent =
            selected === "all"
              ? `Alle ${visibleCount} Coach-Profile werden angezeigt.`
              : visibleCount > 0
                ? `${labels.get(selected)}: ${visibleCount} passende Coach-Profile.`
                : `${labels.get(selected)}: Noch kein freigegebenes Coach-Profil.`;
        }

        if (emptyState) emptyState.hidden = visibleCount > 0;

        if (updateUrl) {
          const nextUrl = new URL(window.location.href);
          nextUrl.hash = selected === "all" ? "" : `thema-${selected}`;
          history.replaceState(null, "", nextUrl);
        }
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          applyTopic(button.dataset.coachTopic || "all");
          const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          status?.scrollIntoView({
            behavior: reduceMotion ? "auto" : "smooth",
            block: "start",
          });
        });
      });

      const topicFromHash = () =>
        window.location.hash.startsWith("#thema-")
          ? window.location.hash.replace("#thema-", "")
          : "all";

      applyTopic(topicFromHash(), false);
      window.addEventListener("hashchange", () => {
        applyTopic(topicFromHash(), false);
      });
    });
</script>
