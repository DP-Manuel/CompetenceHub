---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;
---

<BaseLayout
  title="Life Coaching heißt jetzt Mindforge | Competence Hub"
  description="Der bisherige Coaching-Bereich wird im Competence Hub unter dem Namen Mindforge Life Coaching weitergeführt."
>
  <main class="subpage">
    <section class="page-hero page-hero--accent">
      <p class="eyebrow">Hinweis zur Bezeichnung</p>
      <h1>Life Coaching ist Teil von Mindforge.</h1>
      <p>
        Der bisher als Livecoaching bezeichnete Bereich wird fachlich korrekt
        als Life Coaching weitergeführt. Mindforge bündelt persönliche
        Entwicklung, Resilienz und Mindset für Privatpersonen und Unternehmen.
      </p>
      <div class="actions">
        <a class="button" href={url("mindforge")}>Mindforge entdecken</a>
        <a class="button button--ghost" href={url("lifecoaching")}>Life Coaching im Detail</a>
      </div>
    </section>
  </main>
</BaseLayout>
