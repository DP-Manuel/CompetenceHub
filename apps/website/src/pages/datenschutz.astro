---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Datenschutz | Competence Hub"
  description="Datenschutzhinweise fuer Competence Hub mit Verweis auf die zentrale Datenschutzerklaerung von Donner + Partner."
  noindex
>
  <main class="subpage">
    <section class="page-hero legal-hero">
      <p class="eyebrow">Datenschutz</p>
      <h1>Datenschutzhinweise für Competence Hub</h1>
      <p>
        Für Competence Hub gelten zunächst die zentral veröffentlichten
        Datenschutzhinweise von Donner + Partner.
      </p>
      <a
        class="button button--ghost"
        href="https://donner-partner.de/dp/datenschutz/"
      >
        Zentrale Datenschutzhinweise öffnen
      </a>
    </section>

    <section class="notice-panel">
      <div>
        <p class="eyebrow">Datensparsame Kontaktaufnahme</p>
        <h2>Die Website versendet keine Formulardaten</h2>
      </div>
      <p>
        Die Kontaktseite öffnet über einen E-Mail-Link das lokal eingerichtete
        E-Mail-Programm. Die Competence-Hub-Website selbst speichert oder
        versendet dabei keine Formulardaten.
      </p>
    </section>
  </main>
</BaseLayout>
