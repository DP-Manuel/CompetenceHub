---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { customerFeedbacks } from "../data/customerFeedbacks";
import "../styles/global.css";

const publishedCustomerFeedbacks = customerFeedbacks.filter(
  (feedback) => feedback.approvedForPublication,
);

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const companyPaths = [
  { title: "Firmencoaching", detail: "Führung und Teams", href: "mindforge#unternehmen", icon: "leadership" },
  { title: "Recruiting", detail: "Personalbedarf und Auswahl", href: "leistungen#recruiting", icon: "user-round" },
  { title: "Personalentwicklung", detail: "Potenziale und Qualifizierung", href: "leistungen#personalentwicklung", icon: "building" },
  { title: "Workshops & Vorträge", detail: "Formate und Themen entdecken", href: "leistungen#angebotsfinder", icon: "users" },
] as const;

const occasions = [
  {
    title: "Führung und Zusammenarbeit",
    text: "Wenn Rollen, Verantwortung, Erwartungen oder Abstimmung im Team klarer werden sollen.",
    icon: "leadership" as const,
  },
  {
    title: "Kommunikation",
    text: "Wenn Gespräche, Feedback, Kundenkontakt oder interne Abstimmung professioneller laufen sollen.",
    icon: "message-circle" as const,
  },
  {
    title: "Veränderung und Entwicklung",
    text: "Wenn neue Aufgaben, Wachstum, Umstrukturierung oder berufliche Entwicklung begleitet werden sollen.",
    icon: "compass" as const,
  },
  {
    title: "Belastung und Orientierung",
    text: "Wenn Teams Orientierung, Konfliktprävention und einen gesunden Umgang mit beruflicher Belastung brauchen.",
    icon: "heart-pulse" as const,
  },
  {
    title: "Qualifizierung als Baustein",
    text: "Wenn Coaching und Qualifizierung als Teil einer nachhaltigen Personal- und Kompetenzentwicklung gedacht werden.",
    icon: "users" as const,
  },
  {
    title: "Recruiting und Potenziale",
    text: "Wenn praktische Fähigkeiten, Entwicklungsmöglichkeiten und der tatsächliche Personalbedarf stärker zusammengebracht werden sollen.",
    icon: "building" as const,
  },
];

const collaboration = [
  { title: "Bedarf klären", text: "Mit Frau Rappelt besprechen Sie Anlass, Zielgruppe und Dringlichkeit." },
  { title: "Expertise auswählen", text: "Wir empfehlen Coaches oder Fachleute, die zu Ihrem Thema und Unternehmen passen." },
  { title: "Rahmen abstimmen", text: "Ziele, Format, Umfang und Ablauf besprechen Sie gemeinsam vor dem Start." },
];

const caseStories = [
  {
    id: "fuehrung-neue-rolle",
    eyebrow: "Use Case 01 · Beispielhafter Ablauf",
    title: "Eine neue Führungskraft findet in ihre Rolle",
    lead:
      "Das Szenario zeigt einen möglichen Weg durch den Competence Hub. Es ist ein Beispiel und keine Kundenreferenz oder Ergebniszusage.",
    tone: "example",
    steps: [
      {
        label: "Ausgangslage",
        title: "Fachliche Stärke trifft auf eine neue Rolle",
        text: "Ein langjähriger Fachexperte übernimmt erstmals Führungsverantwortung. Delegation, Arbeitslast und Unruhe im Team werden zum Thema.",
      },
      {
        label: "Bedarf klären",
        title: "Anliegen und gewünschte Wirkung werden greifbar",
        text: "Im Erstgespräch werden Rollenklärung, Aufgabenverteilung, Kommunikation und Konfliktprävention gemeinsam eingeordnet.",
      },
      {
        label: "Expertise verbinden",
        title: "Passende Coaches werden ausgewählt",
        text: "Fachlicher Schwerpunkt, Zielgruppe, Unternehmenskontext, gewünschtes Format und Verfügbarkeit bestimmen die Auswahl.",
      },
      {
        label: "Rahmen abstimmen",
        title: "Unternehmen, Coachee und Coach starten gemeinsam",
        text: "Im Kick-off entsteht ein gemeinsames Verständnis von Auftrag, Zielrichtung, Zusammenarbeit und vertraulichem Rahmen.",
      },
      {
        label: "Transfer begleiten",
        title: "Erkenntnisse werden in den Alltag übersetzt",
        text: "Der vereinbarte Prozess bleibt anpassbar. Zum Abschluss werden Erfahrungen, nächste Schritte und Feedback strukturiert zusammengeführt.",
      },
    ],
  },
  {
    id: "concept-clean-kommunikation",
    eyebrow: "Use Case 02 · Aus der Praxis",
    title: "Kommunikation, die zum Arbeitsalltag passt",
    lead:
      "Concept Clean beschreibt einen Kommunikationskurs für Mitarbeitende, bei dem Matching, Inhalte und Zeiten auf den betrieblichen Kontext abgestimmt wurden.",
    tone: "customer",
    steps: [
      {
        label: "Anfrage",
        title: "Ein Kommunikationskurs wird gebucht",
        text: "Der Ausgangspunkt ist ein konkreter Entwicklungsbedarf für Mitarbeitende im Unternehmen.",
      },
      {
        label: "Matching",
        title: "Der passende Dozent wird verbunden",
        text: "Concept Clean hebt besonders hervor, dass das Matching flexibel und nicht nach einem starren Standard erfolgte.",
      },
      {
        label: "Ausrichtung",
        title: "Fachsprache und Teamalltag geben den Fokus vor",
        text: "Die branchenspezifische Fachsprache und die tägliche Kommunikation im Team wurden zum Kern der Einheiten.",
      },
      {
        label: "Durchführung",
        title: "Die Termine passen zu den Arbeitszeiten",
        text: "Die Einheiten ließen sich gut mit den Arbeitszeiten der Mitarbeitenden vereinbaren.",
      },
      {
        label: "Rückmeldung",
        title: "Der Weg wird als reibungslos erlebt",
        text: "Von der ersten Anfrage bis zur Durchführung bewertet Concept Clean den Ablauf durchgehend positiv.",
      },
    ],
  },
] as const;

const assessmentApplications = [
  {
    title: "Recruiting & Personalauswahl",
    text: "Externe Bewerbende oder interne Kandidatinnen und Kandidaten anhand eines abgestimmten Anforderungsprofils strukturiert und vergleichbar beurteilen.",
    icon: "user-round" as const,
  },
  {
    title: "Personalentwicklung",
    text: "Stärken und Entwicklungsfelder sichtbar machen und die Ergebnisse als fundierten Ausgangspunkt für Mindforge-Coachings nutzen.",
    icon: "sparkles" as const,
  },
];

const assessmentLevels = [
  {
    title: "Planung & Konzeption",
    text: "Anforderungsprofil, Übungsdesign, Beobachtungs- und Bewertungsbögen, internes Briefing sowie Regie- und Ablaufplan.",
    price: "2.500–3.800 €",
    unit: "zzgl. MwSt. · pauschal",
  },
  {
    title: "Full-Service",
    text: "Zusätzlich Moderation, neutrale Beobachtung, Auswertung, Gutachten und strukturierte Feedbackgespräche.",
    price: "4.500–7.500 €",
    unit: "zzgl. MwSt. · pro Assessment-Center-Tag",
  },
];

const faqs = [
  {
    question: "Für welche Unternehmen eignet sich Competence Hub?",
    answer: "Für Unternehmen, die Führung, Zusammenarbeit, Kommunikation, Gesundheit oder berufliche Entwicklung gezielt begleiten möchten. Der erste Schritt ist eine Klärung von Zielgruppe, Anlass und gewünschtem Format.",
  },
  {
    question: "Ist das Angebot nur für Führungskräfte gedacht?",
    answer: "Nein. Führungskräfte sind eine wichtige Zielgruppe, aber auch Teams und Mitarbeitende in Veränderungs- oder Entwicklungssituationen können einbezogen werden.",
  },
  {
    question: "Gibt es garantierte Ergebnisse?",
    answer: "Nein. Coaching kann Reflexion, Orientierung und professionelle Entwicklung unterstützen, ersetzt aber keine unternehmerische Entscheidung und keine medizinische oder therapeutische Beratung.",
  },
  {
    question: "Können Assessment Center auch der Personalentwicklung dienen?",
    answer: "Ja. Neben der Personalauswahl können Development Assessment Center Potenziale und Entwicklungsfelder sichtbar machen. Die Ergebnisse lassen sich anschließend in Mindforge-Coachings gezielt weiterbearbeiten.",
  },
];
---

<BaseLayout
  title="Coaching für Unternehmen | Competence Hub"
  description="Competence Hub verbindet Unternehmen mit ausgewählten Coaches und Expertise für Führung, Zusammenarbeit, Recruiting, Gesundheit und Veränderung."
>
  <main class="subpage company-page">
    <section class="company-intro" aria-labelledby="company-title">
      <div>
        <p class="eyebrow">Für Unternehmen</p>
        <h1 id="company-title">Passende Expertise für Ihr Unternehmen</h1>
        <p>Ob Führungswechsel, Zusammenarbeit oder Personalauswahl: Wir klären Ihren Bedarf und vermitteln die passenden Coaches oder Fachleute.</p>
        <a class="button" href="#unternehmenskontakt">Mit Frau Rappelt sprechen</a>
      </div>
      <nav class="company-paths" aria-labelledby="company-title-connections">
        <h2 id="company-title-connections">Leistungen für Unternehmen</h2>
        <ul role="list">
          {companyPaths.map((path) => (
            <li>
              <a href={url(path.href)}>
                <Icon name={path.icon} size={22} />
                <span><strong>{path.title}</strong><small>{path.detail}</small></span>
                <Icon name="arrow-right" size={18} />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>

    <section class="company-occasions" id="anlaesse" aria-labelledby="company-occasions-title">
      <h2 id="company-occasions-title">Typische Anlässe</h2>
      <ul role="list">
        {occasions.map((occasion) => (
          <li>
            <Icon name={occasion.icon} size={22} />
            <div><h3>{occasion.title}</h3><p>{occasion.text}</p></div>
          </li>
        ))}
      </ul>
    </section>

    <section class="company-process" id="zusammenarbeit" aria-labelledby="company-process-title">
      <h2 id="company-process-title">So arbeiten wir zusammen</h2>
      <ol>
        {collaboration.map((step) => (
          <li><h3>{step.title}</h3><p>{step.text}</p></li>
        ))}
      </ol>
      <a class="text-link" href={url("coaches")}>Coach-Netzwerk kennenlernen <Icon name="arrow-right" size={18} /></a>
    </section>

    <section class="company-assessment" id="assessment-center" aria-labelledby="assessment-title">
      <header class="company-assessment__heading">
        <h2 id="assessment-title">Assessment Center für Auswahl und Entwicklung</h2>
        <p>
          Präsenz, digital oder hybrid. Umfang und Beobachtungsaufwand werden
          passend zur Zielgruppe und zur konkreten Entscheidung geplant.
        </p>
      </header>

      <div class="company-assessment__applications">
        {assessmentApplications.map((application) => (
          <article>
            <Icon name={application.icon} size={28} />
            <div>
              <h3>{application.title}</h3>
              <p>{application.text}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="company-assessment__levels" aria-label="Leistungsstufen und Preise">
        {assessmentLevels.map((level) => (
          <article>
            <div>
              <h3>{level.title}</h3>
              <p>{level.text}</p>
            </div>
            <p class="company-assessment__price"><strong>{level.price}</strong> <small>{level.unit}</small></p>
          </article>
        ))}
      </div>

      <div class="company-assessment__links">
        <a class="button" href={url("kontakt")}>Assessment Center anfragen</a>
        <a class="text-link" href={url("mindforge#unternehmen")}>
          Mindforge für Unternehmen
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </section>

    {publishedCustomerFeedbacks.length > 0 && (
      <section
        class="customer-feedback-section"
        aria-labelledby="customer-feedback-title"
      >
      <header class="customer-feedback__heading">
        <div>
          <p class="eyebrow">Kundenfeedback</p>
          <h2 id="customer-feedback-title">
            Das waren die Eindrücke von unseren Kunden
          </h2>
        </div>
        <p>
          Hier sammeln wir Rückmeldungen dazu, wie Unternehmen Matching,
          Inhalte und Zusammenarbeit erlebt haben.
        </p>
        {publishedCustomerFeedbacks.length > 1 && (
          <div
            class="customer-feedback__controls"
            role="group"
            aria-label="Kundenstimmen steuern"
          >
            <button
              class="customer-feedback__control"
              type="button"
              aria-label="Vorherige Kundenstimme"
              title="Vorherige Kundenstimme"
              data-feedback-previous
            >
              <span class="customer-feedback__control-icon--previous">
                <Icon name="arrow-right" size={20} />
              </span>
            </button>
            <button
              class="customer-feedback__control"
              type="button"
              aria-pressed="false"
              aria-label="Kundenstimmen pausieren"
              title="Kundenstimmen pausieren"
              data-feedback-toggle
            >
              <span data-feedback-pause-icon><Icon name="pause" size={20} /></span>
              <span data-feedback-play-icon hidden><Icon name="play" size={20} /></span>
            </button>
            <button
              class="customer-feedback__control"
              type="button"
              aria-label="Nächste Kundenstimme"
              title="Nächste Kundenstimme"
              data-feedback-next
            >
              <Icon name="arrow-right" size={20} />
            </button>
          </div>
        )}
      </header>

      <div class="customer-feedback__carousel" data-feedback-carousel>
        <div class="customer-feedback__viewport" data-feedback-viewport>
          <div
            class:list={[
              "customer-feedback__track",
              {
                "customer-feedback__track--single":
                  publishedCustomerFeedbacks.length === 1,
              },
            ]}
            data-feedback-track
          >
            {publishedCustomerFeedbacks.map((feedback) => (
              <article class="customer-feedback__card" id={`feedback-${feedback.id}`}>
                <div class="customer-feedback__logo">
                  <img
                    src={url(feedback.logo)}
                    alt={feedback.logoAlt}
                    width="500"
                    height="500"
                    loading="lazy"
                  />
                </div>
                <div class="customer-feedback__content">
                  <div class="customer-feedback__topic">
                    <small>Thema der Zusammenarbeit</small>
                    <strong>{feedback.topic}</strong>
                  </div>
                  <blockquote class="customer-feedback__quote">
                    <p>{`„${feedback.quote}“`}</p>
                  </blockquote>
                  <footer>
                    <cite>{feedback.company}</cite>
                    <a class="text-link" href={feedback.detailHref}>
                      Praxisweg ansehen <Icon name="arrow-right" size={18} />
                    </a>
                  </footer>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
      </section>
    )}

    <section class="use-case-section" aria-labelledby="use-case-title">
      <div class="section-heading use-case-section__heading">
        <p class="eyebrow">Vom Anliegen zur Umsetzung</p>
        <h2 id="use-case-title">Zwei Wege durch den Competence Hub</h2>
        <p>
          Der genaue Verlauf richtet sich nach Anlass, Zielgruppe und Format.
          Die folgenden Geschichten machen sichtbar, wie die einzelnen Ebenen
          zusammenspielen können.
        </p>
      </div>

      <div class="case-story-browser" data-case-story-browser>
        <div class="case-story-picker" role="group" aria-label="Use Cases auswählen">
          {caseStories.map((story) => (
            <button
              class:list={[
                "case-story-trigger",
                `case-story-trigger--${story.tone}`,
              ]}
              id={`use-case-trigger-${story.id}`}
              type="button"
              aria-expanded="false"
              aria-controls={story.id}
              data-case-story-trigger
            >
              <span class="case-story-trigger__copy">
                <span class="eyebrow">{story.eyebrow}</span>
                <strong class="case-story-trigger__title">{story.title}</strong>
                <span class="case-story-trigger__lead">{story.lead}</span>
              </span>
              <span class="case-story-trigger__action">
                <span data-case-story-label>Ablauf ansehen</span>
                <span class="case-story-trigger__symbol" data-case-story-symbol aria-hidden="true">+</span>
              </span>
            </button>
          ))}
        </div>

        <div class="case-story-panels">
          {caseStories.map((story) => (
            <article
              class:list={[
                "case-story",
                `case-story--${story.tone}`,
              ]}
              id={story.id}
              aria-labelledby={`use-case-trigger-${story.id}`}
              data-case-story-panel
            >
              <h3 class="visually-hidden">{story.title}</h3>
              <div class="case-story__route">
                <svg
                  class="case-story__curve"
                  viewBox="0 0 100 100"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M50 0 C88 6 88 19 50 25 C12 31 12 44 50 50 C88 56 88 69 50 75 C12 81 12 94 50 100" />
                </svg>
                <ol class="case-story__steps">
                  {story.steps.map((step, index) => (
                    <li class="case-story__step">
                      <div class="case-story__step-copy">
                        <small>{step.label}</small>
                        <h4>{step.title}</h4>
                        <p>{step.text}</p>
                      </div>
                      <span class="case-story__marker" aria-hidden="true">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="company-faq-title">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="company-faq-title">Fragen von Unternehmen</h2>
      </div>
      <div class="faq-grid">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="company-contact" id="unternehmenskontakt" aria-labelledby="company-contact-title">
      <img src={url("images/team/janay-rappelt.jpg")} alt="" width="1066" height="1600" loading="lazy" />
      <div>
        <p class="eyebrow">Ihre Ansprechpartnerin</p>
        <h2 id="company-contact-title">Frau Rappelt</h2>
        <p>Schildern Sie kurz Ihr Anliegen. Frau Rappelt hilft Ihnen, das passende Format und die richtige Ansprechperson zu finden.</p>
        <a class="button" href={url("kontakt")}>Bedarf besprechen</a>
        <a class="text-link" href="tel:+491726799972">0172 6799972 anrufen</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .company-page { overflow-wrap: anywhere; }
  .company-page :is(h1, h2, h3, .button) { overflow-wrap: anywhere; }
  .company-page :is(h2, h3) { line-height: 1.22; }
  .company-page :is(.company-occasions, .company-process, .company-assessment, .company-contact) {
    scroll-margin-top: 9rem;
  }
  .company-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem 4rem;
    padding-block: 1rem 3rem;
  }
  .company-intro h1 { font-size: 3.5rem; line-height: 1.1; max-width: 17ch; }
  .company-intro p:not(.eyebrow), .company-contact p:not(.eyebrow) { max-width: 51ch; }
  .company-page .eyebrow, .company-paths small { color: var(--color-pantone-deep); }
  .company-paths h2 { font-size: 1.25rem; margin-bottom: .65rem; }
  .company-paths ul, .company-occasions ul { list-style: none; margin: 0; padding: 0; }
  .company-paths a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: .75rem;
    align-items: center;
    border-top: 1px solid var(--color-line);
    min-height: 3.5rem;
    padding: .55rem .5rem;
  }
  .company-paths a:hover { background: var(--color-soft); }
  .company-paths a:hover strong { text-decoration: underline; text-underline-offset: .17em; }
  .company-paths a:focus-visible { outline-offset: -3px; }
  .company-paths a :global(svg), .company-occasions li > :global(svg),
  .company-assessment__applications article > :global(svg) { color: var(--color-pantone-deep); }
  .company-paths small { display: block; font-size: .9rem; }
  .company-occasions, .company-process, .company-assessment { padding-block: 2rem; border-top: 1px solid var(--color-line); }
  .company-page :is(.company-occasions, .company-process, .company-assessment, .company-contact) h2 { font-size: 2rem; }
  .company-occasions ul, .company-process ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem 2rem;
  }
  .company-occasions li, .company-assessment__applications article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: .75rem;
  }
  .company-occasions li > :global(svg), .company-assessment__applications article > :global(svg) { margin-top: .15rem; }
  .company-occasions h3, .company-process h3, .company-assessment h3 { font-size: 1.12rem; margin-bottom: .35rem; }
  .company-occasions p, .company-process p, .company-assessment p { margin-bottom: 0; }
  .company-process ol { padding-left: 1.7rem; margin-block: 1.2rem .65rem; column-gap: 2.75rem; }
  .company-process li::marker { color: var(--color-pantone-deep); font-weight: 800; }
  .company-page :is(.company-process, .company-assessment__links, .company-contact) .text-link {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 44px;
  }
  .company-assessment { margin-bottom: 2rem; }
  .company-assessment__heading { margin-bottom: 1.4rem; }
  .company-assessment__heading h2 { max-width: 30ch; }
  .company-assessment__applications, .company-assessment__levels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-line);
  }
  .company-assessment__price { margin-top: .7rem; }
  .company-assessment__price strong { color: var(--color-pantone-deep); }
  .company-assessment__links { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem 1.25rem; }
  .company-contact {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    align-items: center;
    gap: 1.2rem 2rem;
    padding-block: 2rem .75rem;
    border-top: 1px solid var(--color-line);
  }
  .company-contact img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 24%; }
  .company-contact .text-link { margin-inline-start: .8rem; }
  @media (max-width: 54rem) {
    .company-intro { gap: 1.75rem; }
    .company-intro h1 { font-size: 2.65rem; }
    .company-occasions ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 42rem) {
    .company-intro, .company-occasions ul, .company-process ol,
    .company-assessment__applications, .company-assessment__levels { grid-template-columns: minmax(0, 1fr); }
    .company-intro { padding-block: .25rem 2rem; }
    .company-intro h1 { font-size: 2.3rem; }
    .company-contact { grid-template-columns: minmax(0, 1fr); }
    .company-contact img { width: min(100%, 8.5rem); }
    .company-contact .text-link { display: flex; width: fit-content; margin: .5rem 0 0; }
  }
</style>

<script>
  const caseStoryBrowsers = document.querySelectorAll<HTMLElement>(
    "[data-case-story-browser]",
  );

  caseStoryBrowsers.forEach((browser) => {
    const triggers = Array.from(
      browser.querySelectorAll<HTMLButtonElement>("[data-case-story-trigger]"),
    );
    const panels = Array.from(
      browser.querySelectorAll<HTMLElement>("[data-case-story-panel]"),
    );

    const setOpenStory = (selected: HTMLButtonElement | null) => {
      triggers.forEach((trigger) => {
        const isOpen = trigger === selected;
        const panelId = trigger.getAttribute("aria-controls");
        const panel = panels.find((candidate) => candidate.id === panelId);
        const label = trigger.querySelector<HTMLElement>("[data-case-story-label]");
        const symbol = trigger.querySelector<HTMLElement>("[data-case-story-symbol]");

        trigger.setAttribute("aria-expanded", String(isOpen));
        trigger.classList.toggle("is-open", isOpen);
        if (panel) {
          panel.hidden = !isOpen;
          panel.classList.toggle("is-open", isOpen);
        }
        if (label) label.textContent = isOpen ? "Ablauf schließen" : "Ablauf ansehen";
        if (symbol) symbol.textContent = isOpen ? "−" : "+";
      });
    };

    browser.classList.add("is-enhanced");
    const triggerForHash = () => triggers.find(
      (trigger) => `#${trigger.getAttribute("aria-controls")}` === window.location.hash,
    );
    const initialTrigger = triggerForHash() || null;
    setOpenStory(initialTrigger);
    if (initialTrigger) {
      window.requestAnimationFrame(() =>
        initialTrigger.scrollIntoView({ block: "start" }),
      );
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const wasOpen = trigger.getAttribute("aria-expanded") === "true";
        setOpenStory(wasOpen ? null : trigger);
      });
    });

    window.addEventListener("hashchange", () => {
      const selected = triggerForHash();
      if (!selected) return;
      setOpenStory(selected);
      window.requestAnimationFrame(() => selected.scrollIntoView({ block: "start" }));
    });
  });

  const feedbackCarousels = document.querySelectorAll<HTMLElement>(
    "[data-feedback-carousel]",
  );

  feedbackCarousels.forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-feedback-track]");
    const viewport = carousel.querySelector<HTMLElement>("[data-feedback-viewport]");
    const cards = Array.from(
      track?.querySelectorAll<HTMLElement>(".customer-feedback__card") || [],
    );
    const section = carousel.closest(".customer-feedback-section");
    const toggle = section?.querySelector<HTMLButtonElement>("[data-feedback-toggle]");
    const previous = section?.querySelector<HTMLButtonElement>("[data-feedback-previous]");
    const next = section?.querySelector<HTMLButtonElement>("[data-feedback-next]");
    const pauseIcon = toggle?.querySelector<HTMLElement>("[data-feedback-pause-icon]");
    const playIcon = toggle?.querySelector<HTMLElement>("[data-feedback-play-icon]");

    if (
      !track ||
      !viewport ||
      cards.length < 2 ||
      !toggle ||
      !previous ||
      !next
    ) return;

    let currentIndex = 0;
    let autoAdvance: number | undefined;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const showCard = (target: number) => {
      currentIndex = (target + cards.length) % cards.length;
      viewport.scrollTo({
        left: cards[currentIndex].offsetLeft - track.offsetLeft,
        behavior: reducedMotion.matches ? "auto" : "smooth",
      });
    };

    const stopAutoAdvance = () => {
      if (autoAdvance !== undefined) window.clearInterval(autoAdvance);
      autoAdvance = undefined;
    };

    const startAutoAdvance = () => {
      stopAutoAdvance();
      if (carousel.dataset.paused === "true") return;
      autoAdvance = window.setInterval(() => showCard(currentIndex + 1), 7500);
    };

    const setPaused = (paused: boolean) => {
      carousel.dataset.paused = paused ? "true" : "false";
      toggle.setAttribute("aria-pressed", paused ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        paused ? "Kundenstimmen fortsetzen" : "Kundenstimmen pausieren",
      );
      toggle.title = paused
        ? "Kundenstimmen fortsetzen"
        : "Kundenstimmen pausieren";
      if (pauseIcon) pauseIcon.hidden = paused;
      if (playIcon) playIcon.hidden = !paused;
      paused ? stopAutoAdvance() : startAutoAdvance();
    };

    carousel.classList.add("is-ready");
    setPaused(reducedMotion.matches);

    toggle.addEventListener("click", () => {
      setPaused(carousel.dataset.paused !== "true");
    });
    previous.addEventListener("click", () => {
      setPaused(true);
      showCard(currentIndex - 1);
    });
    next.addEventListener("click", () => {
      setPaused(true);
      showCard(currentIndex + 1);
    });
    viewport.addEventListener("focusin", stopAutoAdvance);
    viewport.addEventListener("focusout", startAutoAdvance);
  });
</script>
