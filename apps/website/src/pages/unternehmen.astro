---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SolutionGuide from "../components/SolutionGuide.astro";
import CompassRecommendations from "../components/CompassRecommendations.astro";
import { customerFeedbacks } from "../data/customerFeedbacks";
import "../styles/global.css";
import "../styles/company-experience.css";

const publishedCustomerFeedbacks = customerFeedbacks.filter(
  (feedback) => feedback.approvedForPublication,
);
const review = import.meta.env.PUBLIC_REVIEW_MODE === "true";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const topics = [
  {
    id: "fuehrung", icon: "leadership", title: "Führung",
    heading: "In Führung hineinwachsen",
    text: "Eine neue Rolle übernehmen, Verantwortung klären oder Mitarbeitergespräche besser führen: Der passende Einstieg richtet sich nach der konkreten Führungssituation.",
    links: [
      ["Businesscoaching für Unternehmen", "mindforge#unternehmen"],
      ["Workshops und Vorträge", "leistungen#gruppenformate"],
    ],
  },
  {
    id: "teams", icon: "users", title: "Teams und Zusammenarbeit",
    heading: "Zusammenarbeit gezielt verbessern",
    text: "Wenn Absprachen nicht greifen oder Konflikte den Alltag bestimmen, hilft es, Kommunikation und Zusammenarbeit gemeinsam in den Blick zu nehmen.",
    links: [
      ["Mindforge für Unternehmen", "mindforge#unternehmen"],
      ["Workshops und Vorträge", "leistungen#gruppenformate"],
      ["Praxisbeispiel zur Kommunikation", "#concept-clean-kommunikation"],
    ],
  },
  {
    id: "recruiting", icon: "user-round", title: "Recruiting und Personal",
    heading: "Passende Mitarbeitende finden",
    text: "Was muss jemand für die Rolle mitbringen? Ein klares Anforderungsprofil hilft, Bewerbende zu vergleichen und Potenziale zu erkennen.",
    links: [
      ["Recruiting für Unternehmen", "leistungen#recruiting"],
      ["Assessment Center zur Auswahl", "#assessment-center"],
    ],
  },
  {
    id: "entwicklung", icon: "sparkles", title: "Personalentwicklung",
    heading: "Stärken erkennen und weiterentwickeln",
    text: "Mitarbeitende auf neue Aufgaben vorbereiten oder Kompetenzen gezielt ausbauen: Anlass, Zielgruppe und Lernziel geben die Richtung vor.",
    links: [
      ["Personalentwicklung im Überblick", "leistungen#personalentwicklung"],
      ["Entwicklungspotenziale einschätzen", "#assessment-center"],
      ["Angebote nach Thema finden", "leistungen#angebotsfinder"],
    ],
  },
  {
    id: "veraenderung", icon: "compass", title: "Veränderung und Transformation",
    heading: "Orientierung im Wandel schaffen",
    text: "Ob neue Strukturen oder neue Arbeitsweisen: Führungskräfte und Teams brauchen Klarheit darüber, was sich ändert und wie sie damit umgehen können.",
    links: [
      ["Businesscoaching im Wandel", "mindforge#unternehmen"],
      ["Beratung und Coaching einordnen", "leistungen#mindforge"],
      ["Workshops und Vorträge", "leistungen#gruppenformate"],
    ],
  },
  {
    id: "gesundheit", icon: "heart-pulse", title: "Gesundheit und Prävention",
    heading: "Belastung im Arbeitsalltag ansprechen",
    text: "Berufliche Belastung, Selbstmanagement oder Konfliktprävention können Anlass für ein Coaching sein. Welche Begleitung passt, klären wir gemeinsam.",
    links: [
      ["Coaching für Unternehmen", "mindforge#unternehmen"],
      ["Passende Themen im Angebotsfinder", "leistungen#angebotsfinder"],
    ],
  },
] as const;

const serviceWorlds = [
  {
    title: "Führung & Zusammenarbeit", icon: "leadership",
    text: "Führung stärken, Teams entwickeln, Kommunikation verbessern und Konflikte professionell bearbeiten.",
    links: [["Mindforge für Unternehmen", "mindforge#unternehmen"]],
  },
  {
    title: "Personalgewinnung & Potenziale", icon: "user-round",
    text: "Geeignete Mitarbeitende finden, Kompetenzen erkennen und Auswahlprozesse fundiert gestalten.",
    links: [["Recruiting entdecken", "leistungen#recruiting"], ["Zum Assessment Center", "#assessment-center"]],
  },
  {
    title: "Qualifizierung & Veränderung", icon: "compass",
    text: "Mitarbeitende weiterentwickeln, berufliche Kompetenzen stärken und Veränderungsprozesse begleiten.",
    links: [["Personalentwicklung", "leistungen#personalentwicklung"], ["Workshops & Vorträge", "leistungen#gruppenformate"]],
  },
] as const;

const collaboration = [
  { title: "Anliegen klären", text: "Mit Frau Rappelt besprechen Sie Anlass, Zielgruppe und Ziel." },
  { title: "Expertise finden", text: "Wir empfehlen Coaches oder Fachleute für Ihr konkretes Thema." },
  { title: "Zusammenarbeit gestalten", text: "Format, Umfang und Ablauf stimmen Sie vor dem Start gemeinsam ab." },
];

const destination = (href: string) => href.startsWith("#") ? href : url(href);

const caseStories = [
  {
    id: "fuehrung-neue-rolle",
    eyebrow: "Use Case 01 · Beispielhafter Ablauf",
    title: "Eine neue Führungskraft findet in ihre Rolle",
    lead:
      "Das Szenario zeigt einen möglichen Weg durch den Competence Hub. Es ist ein Beispiel und keine Kundenreferenz oder Ergebniszusage.",
    steps: [
      {
        label: "Ausgangslage",
        title: "Fachliche Stärke trifft auf eine neue Rolle",
        text: "Ein langjähriger Fachexperte übernimmt erstmals Führungsverantwortung. Delegation, Arbeitslast und Unruhe im Team werden zum Thema.",
      },
      {
        label: "Bedarf klären",
        title: "Anliegen und gewünschte Wirkung werden greifbar",
        text: "Im Erstgespräch werden Rollenklärung, Aufgabenverteilung, Kommunikation und Konfliktprävention gemeinsam eingeordnet.",
      },
      {
        label: "Expertise verbinden",
        title: "Passende Coaches werden ausgewählt",
        text: "Fachlicher Schwerpunkt, Zielgruppe, Unternehmenskontext, gewünschtes Format und Verfügbarkeit bestimmen die Auswahl.",
      },
      {
        label: "Rahmen abstimmen",
        title: "Unternehmen, Coachee und Coach starten gemeinsam",
        text: "Im Kick-off entsteht ein gemeinsames Verständnis von Auftrag, Zielrichtung, Zusammenarbeit und vertraulichem Rahmen.",
      },
      {
        label: "Transfer begleiten",
        title: "Erkenntnisse werden in den Alltag übersetzt",
        text: "Der vereinbarte Prozess bleibt anpassbar. Zum Abschluss werden Erfahrungen, nächste Schritte und Feedback strukturiert zusammengeführt.",
      },
    ],
  },
  {
    id: "concept-clean-kommunikation",
    eyebrow: "Use Case 02 · Aus der Praxis",
    title: "Kommunikation, die zum Arbeitsalltag passt",
    lead:
      "Concept Clean beschreibt einen Kommunikationskurs für Mitarbeitende, bei dem Matching, Inhalte und Zeiten auf den betrieblichen Kontext abgestimmt wurden.",
    steps: [
      {
        label: "Anfrage",
        title: "Ein Kommunikationskurs wird gebucht",
        text: "Der Ausgangspunkt ist ein konkreter Entwicklungsbedarf für Mitarbeitende im Unternehmen.",
      },
      {
        label: "Matching",
        title: "Der passende Dozent wird verbunden",
        text: "Concept Clean hebt besonders hervor, dass das Matching flexibel und nicht nach einem starren Standard erfolgte.",
      },
      {
        label: "Ausrichtung",
        title: "Fachsprache und Teamalltag geben den Fokus vor",
        text: "Die branchenspezifische Fachsprache und die tägliche Kommunikation im Team wurden zum Kern der Einheiten.",
      },
      {
        label: "Durchführung",
        title: "Die Termine passen zu den Arbeitszeiten",
        text: "Die Einheiten ließen sich gut mit den Arbeitszeiten der Mitarbeitenden vereinbaren.",
      },
      {
        label: "Rückmeldung",
        title: "Der Weg wird als reibungslos erlebt",
        text: "Von der ersten Anfrage bis zur Durchführung bewertet Concept Clean den Ablauf durchgehend positiv.",
      },
    ],
  },
] as const;

const assessmentApplications = [
  {
    title: "Recruiting & Personalauswahl",
    text: "Externe Bewerbende oder interne Kandidatinnen und Kandidaten anhand eines abgestimmten Anforderungsprofils strukturiert und vergleichbar beurteilen.",
    icon: "user-round" as const,
  },
  {
    title: "Personalentwicklung",
    text: "Stärken und Entwicklungsfelder sichtbar machen und die Ergebnisse als fundierten Ausgangspunkt für Mindforge-Coachings nutzen.",
    icon: "sparkles" as const,
  },
];

const assessmentLevels = [
  {
    title: "Planung & Konzeption",
    text: "Anforderungsprofil, Übungsdesign, Beobachtungs- und Bewertungsbögen, internes Briefing sowie Regie- und Ablaufplan.",
    price: "2.500–3.800 €",
    unit: "zzgl. MwSt. · pauschal",
  },
  {
    title: "Full-Service",
    text: "Zusätzlich Moderation, neutrale Beobachtung, Auswertung, Gutachten und strukturierte Feedbackgespräche.",
    price: "4.500–7.500 €",
    unit: "zzgl. MwSt. · pro Assessment-Center-Tag",
  },
];

const faqs = [
  {
    question: "Für welche Unternehmen eignet sich Competence Hub?",
    answer: "Für Unternehmen, die Führung, Zusammenarbeit, Kommunikation, Gesundheit oder berufliche Entwicklung gezielt begleiten möchten. Der erste Schritt ist eine Klärung von Zielgruppe, Anlass und gewünschtem Format.",
  },
  {
    question: "Ist das Angebot nur für Führungskräfte gedacht?",
    answer: "Nein. Führungskräfte sind eine wichtige Zielgruppe, aber auch Teams und Mitarbeitende in Veränderungs- oder Entwicklungssituationen können einbezogen werden.",
  },
  {
    question: "Gibt es garantierte Ergebnisse?",
    answer: "Nein. Coaching kann Reflexion, Orientierung und professionelle Entwicklung unterstützen, ersetzt aber keine unternehmerische Entscheidung und keine medizinische oder therapeutische Beratung.",
  },
  {
    question: "Können Assessment Center auch der Personalentwicklung dienen?",
    answer: "Ja. Neben der Personalauswahl können Development Assessment Center Potenziale und Entwicklungsfelder sichtbar machen. Die Ergebnisse lassen sich anschließend in Mindforge-Coachings gezielt weiterbearbeiten.",
  },
];
---

<BaseLayout
  title="Für Unternehmen | Competence Hub"
  description="Welches Anliegen beschäftigt Ihr Unternehmen? Entdecken Sie passende Wege für Führung, Teams, Recruiting, Personalentwicklung, Veränderung und Gesundheit."
>
  <main class="company-business">
    <section class="business-hero business-wrap" aria-labelledby="company-title">
      <p class="eyebrow">Für Unternehmen</p>
      <h1 id="company-title">Was möchten Sie in Ihrem Unternehmen bewegen?</h1>
      <p class="business-lead">Ob Sie Mitarbeitende entwickeln, Führung stärken, neue Fachkräfte gewinnen oder Veränderungen gestalten möchten – wir verbinden Sie mit der passenden Expertise.</p>
      <div class="business-actions">
        <a class="button" href="#anlaesse">Möglichkeiten entdecken <Icon name="arrow-right" size={18} /></a>
        <a class="text-link" href="#unternehmenskontakt">Persönlich beraten lassen</a>
      </div>
    </section>

    <section class="business-compass" id="anlaesse" aria-labelledby="compass-title" data-company-compass data-unified-compass={review || undefined}>
      <div class="business-wrap">
        <div class="compass-heading">
          <p class="eyebrow"><Icon name="compass" size={21} /> Unternehmens-Kompass</p>
          <h2 id="compass-title">Was beschäftigt Sie gerade?</h2>
        </div>
        <div class="compass-options" data-compass-options>
          {topics.map((topic) => (
            <a class="compass-option" id={`kompass-wahl-${topic.id}`} href={`#kompass-${topic.id}`} data-compass-tab data-topic={topic.id}>
              <Icon name={topic.icon} size={26} strokeWidth={1.7} />
              <span>{topic.id === "entwicklung" ? <>Personal<wbr />entwicklung</> : topic.title}</span>
            </a>
          ))}
        </div>
        <div class="compass-panels">
          {topics.map((topic) => (
            <section class="compass-panel" id={`kompass-${topic.id}`} data-compass-panel>
              <div>
                <h3>{topic.heading}</h3>
                <p>{topic.text}</p>
              </div>
              {review ? <CompassRecommendations topic={topic.id} {url} /> : <ul class="business-link-list" role="list">
                {topic.links.map(([label, href]) => (
                  <li><a href={destination(href)}>{label}<Icon name="arrow-right" size={17} /></a></li>
                ))}
              </ul>}
            </section>
          ))}
        </div>
        {!review && <SolutionGuide />}
      </div>
    </section>

    <section class="business-worlds business-wrap" aria-labelledby="business-worlds-title">
      <p class="eyebrow">Leistungswelten</p>
      <h2 id="business-worlds-title">Drei Wege für Ihr Unternehmen</h2>
      <div>
        {serviceWorlds.map((world, index) => (
          <article class="business-world">
            <div class="world-mark" aria-hidden="true">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <Icon name={world.icon} size={52} strokeWidth={1.2} />
            </div>
            <div>
              <h3>{world.title}</h3>
              <p>{world.text}</p>
              <div class="business-actions">
                {world.links.map(([label, href]) => (
                  <a class="text-link" href={destination(href)}>{label} <Icon name="arrow-right" size={16} /></a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="business-process" id="zusammenarbeit" aria-labelledby="company-process-title">
      <div class="business-wrap">
        <h2 id="company-process-title">So arbeiten wir zusammen</h2>
        <ol role="list">
          {collaboration.map((step, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <a class="text-link" href={url("coaches")}>Coach-Netzwerk kennenlernen <Icon name="arrow-right" size={18} /></a>
      </div>
    </section>

    <section class="business-assessment business-wrap" id="assessment-center" aria-labelledby="assessment-title">
      <p class="eyebrow">Auswahl & Entwicklung</p>
      <h2 id="assessment-title">Assessment Center für Unternehmen</h2>
      <p class="business-lead">Bewerbende strukturiert beurteilen oder Stärken und Entwicklungsfelder im Team sichtbar machen. Das Format stimmen wir auf Ihre Fragestellung ab: in Präsenz, digital oder hybrid.</p>
      <details class="business-disclosure">
        <summary>Leistungsstufen und Preise</summary>
        <div class="assessment-detail">
          <div class="assessment-grid">
            {assessmentApplications.map((application) => (
              <div><Icon name={application.icon} size={24} /><h3>{application.title}</h3><p>{application.text}</p></div>
            ))}
          </div>
          <div class="assessment-grid">
            {assessmentLevels.map((level) => (
              <div>
                <h3>{level.title}</h3><p>{level.text}</p>
                <p class="assessment-price"><strong>{level.price}</strong> <small>{level.unit}</small></p>
              </div>
            ))}
          </div>
          <a class="text-link" href={url("mindforge#unternehmen")}>Mindforge für Unternehmen <Icon name="arrow-right" size={16} /></a>
        </div>
      </details>
      <a class="text-link assessment-cta" href={url(review ? "kontakt/?thema=assessment" : "kontakt")}>Assessment Center anfragen <Icon name="arrow-right" size={18} /></a>
    </section>

    {publishedCustomerFeedbacks.length > 0 && (
      <section class="business-feedback" aria-labelledby="customer-feedback-title">
        <div class="business-wrap">
          <p class="eyebrow">Kundenfeedback</p>
          <h2 id="customer-feedback-title">Das waren die Eindrücke von unseren Kunden</h2>
          {publishedCustomerFeedbacks.map((feedback) => (
            <article class="business-quote" id={`feedback-${feedback.id}`}>
              <img src={url(feedback.logo)} alt={feedback.logoAlt} width="500" height="500" loading="lazy" />
              <div>
                <blockquote><p>{`„${feedback.quote}“`}</p></blockquote>
                <footer class="business-quote-byline">
                  <strong>{feedback.company}</strong><span>{feedback.topic}</span>
                </footer>
                <a class="text-link" href={feedback.detailHref}>Praxisweg ansehen <Icon name="arrow-right" size={16} /></a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="business-stories business-wrap" aria-labelledby="use-case-title">
      <p class="eyebrow">Vom Anliegen zur Umsetzung</p>
      <h2 id="use-case-title">Zwei Wege durch den Competence Hub</h2>
      {caseStories.map((story) => (
        <details class:list={["business-disclosure", {"case-story--customer": story.id === "concept-clean-kommunikation"}]} data-business-story>
          <summary id={`use-case-trigger-${story.id}`}>
            <span>
              <span class="story-label">{story.eyebrow}</span>
              <strong>{story.title}</strong>
            </span>
          </summary>
          <p id={story.id}>{story.lead}</p>
          <div class="case-story__route">
            <svg class="case-story__curve" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d="M50 0 C88 6 88 19 50 25 C12 31 12 44 50 50 C88 56 88 69 50 75 C12 81 12 94 50 100" />
            </svg>
            <ol class="case-story__steps" role="list">
              {story.steps.map((step, index) => (
                <li class="case-story__step">
                  <div class="case-story__step-copy">
                    <small>{step.label}</small><h3>{step.title}</h3><p>{step.text}</p>
                  </div>
                  <span class="case-story__marker" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                </li>
              ))}
            </ol>
          </div>
        </details>
      ))}
    </section>

    <section class="business-faq business-wrap" aria-labelledby="company-faq-title">
      <h2 id="company-faq-title">Fragen von Unternehmen</h2>
      {faqs.slice(0, 2).map((faq) => (
        <details class="business-disclosure"><summary>{faq.question}</summary><p>{faq.answer}</p></details>
      ))}
      <details class="business-disclosure">
        <summary>Weitere Fragen</summary>
        <dl>
          {faqs.slice(2).map((faq) => <><dt>{faq.question}</dt><dd>{faq.answer}</dd></>)}
        </dl>
      </details>
    </section>

    <section class="business-contact" id="unternehmenskontakt" aria-labelledby="company-contact-title">
      <div class="business-wrap">
        <div>
          <p class="eyebrow">Ihre Ansprechpartnerin</p>
          <h2 id="company-contact-title">Sie müssen die passende Lösung nicht selbst finden.</h2>
          <p class="business-lead"><strong>Frau Rappelt</strong> hilft Ihnen, Ihr Anliegen einzuordnen und passende Coaches, Fachleute oder Formate zu finden.</p>
          <div class="business-actions">
            <a class="button" href={url("kontakt")}>Bedarf besprechen <Icon name="arrow-right" size={18} /></a>
            <a class="text-link" href="tel:+491726799972">0172 6799972 anrufen</a>
          </div>
        </div>
        <img src={url("images/team/janay-rappelt.jpg")} alt="Frau Rappelt" width="1066" height="1600" loading="lazy" />
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  for (const compass of document.querySelectorAll("[data-company-compass]")) {
    const options = compass.querySelector("[data-compass-options]");
    const tabs = [...compass.querySelectorAll<HTMLAnchorElement>("[data-compass-tab]")];
    const panels = [...compass.querySelectorAll<HTMLElement>("[data-compass-panel]")];
    if (!options || !tabs.length || tabs.length !== panels.length) continue;

    options.setAttribute("role", "tablist");
    options.setAttribute("aria-labelledby", "compass-title");
    const select = (index: number, focus = false) => {
      for (const [i, tab] of tabs.entries()) {
        const active = i === index;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].inert = !active;
        panels[i].dataset.active = String(active);
      }
      if (focus) tabs[index].focus();
      compass.dispatchEvent(new Event("company-compass:change"));
    };
    const selectHash = () => {
      const index = tabs.findIndex((tab) => tab.hash === location.hash);
      if (index >= 0) {
        select(index);
        return true;
      }
      return false;
    };

    for (const [index, tab] of tabs.entries()) {
      const panel = panels[index];
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", panel.id);
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tab.id);
      panel.tabIndex = 0;
      tab.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        select(index);
      });
      tab.addEventListener("keydown", (event) => {
        let next: number;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else if (event.key === " ") next = index;
        else return;
        event.preventDefault();
        select(next, true);
      });
    }

    if (!selectHash()) select(0);
    compass.setAttribute("data-enhanced", "");
    window.addEventListener("hashchange", selectHash);
  }

  const openLinkedStory = () => {
    for (const story of document.querySelectorAll<HTMLDetailsElement>("[data-business-story]")) {
      if (story.querySelector("p[id]")?.id === location.hash.slice(1)) story.open = true;
    }
  };
  openLinkedStory();
  window.addEventListener("hashchange", openLinkedStory);
</script>
