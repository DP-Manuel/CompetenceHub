---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConnectedPageHero from "../components/ConnectedPageHero.astro";
import Icon from "../components/Icon.astro";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const occasions = [
  {
    title: "Führung und Zusammenarbeit",
    text: "Wenn Rollen, Verantwortung, Erwartungen oder Abstimmung im Team klarer werden sollen.",
    icon: "leadership" as const,
  },
  {
    title: "Kommunikation",
    text: "Wenn Gespräche, Feedback, Kundenkontakt oder interne Abstimmung professioneller laufen sollen.",
    icon: "message-circle" as const,
  },
  {
    title: "Veränderung und Entwicklung",
    text: "Wenn neue Aufgaben, Wachstum, Umstrukturierung oder berufliche Entwicklung begleitet werden sollen.",
    icon: "compass" as const,
  },
  {
    title: "Belastung und Orientierung",
    text: "Wenn Teams Orientierung, Konfliktprävention und einen gesunden Umgang mit beruflicher Belastung brauchen.",
    icon: "heart-pulse" as const,
  },
  {
    title: "Qualifizierung als Baustein",
    text: "Wenn Coaching und Qualifizierung als Teil einer nachhaltigen Personal- und Kompetenzentwicklung gedacht werden.",
    icon: "users" as const,
  },
  {
    title: "Recruiting und Potenziale",
    text: "Wenn praktische Fähigkeiten, Entwicklungsmöglichkeiten und der tatsächliche Personalbedarf stärker zusammengebracht werden sollen.",
    icon: "building" as const,
  },
];

const benefits = [
  "klare Einordnung des Anliegens",
  "passendes Coaching-Format statt Standardpaket",
  "kuratierte Auswahl statt unübersichtlichem Katalog",
  "passende Expertise für Thema und Unternehmenskontext",
];

const caseStories = [
  {
    id: "fuehrung-neue-rolle",
    eyebrow: "Use Case 01 · Beispielhafter Ablauf",
    title: "Eine neue Führungskraft findet in ihre Rolle",
    lead:
      "Das Szenario zeigt einen möglichen Weg durch den Competence Hub. Es ist ein Beispiel und keine Kundenreferenz oder Ergebniszusage.",
    tone: "example",
    steps: [
      {
        label: "Ausgangslage",
        title: "Fachliche Stärke trifft auf eine neue Rolle",
        text: "Ein langjähriger Fachexperte übernimmt erstmals Führungsverantwortung. Delegation, Arbeitslast und Unruhe im Team werden zum Thema.",
      },
      {
        label: "Bedarf klären",
        title: "Anliegen und gewünschte Wirkung werden greifbar",
        text: "Im Erstgespräch werden Rollenklärung, Aufgabenverteilung, Kommunikation und Konfliktprävention gemeinsam eingeordnet.",
      },
      {
        label: "Expertise verbinden",
        title: "Passende Coaches werden ausgewählt",
        text: "Fachlicher Schwerpunkt, Zielgruppe, Unternehmenskontext, gewünschtes Format und Verfügbarkeit bestimmen die Auswahl.",
      },
      {
        label: "Rahmen abstimmen",
        title: "Unternehmen, Coachee und Coach starten gemeinsam",
        text: "Im Kick-off entsteht ein gemeinsames Verständnis von Auftrag, Zielrichtung, Zusammenarbeit und vertraulichem Rahmen.",
      },
      {
        label: "Transfer begleiten",
        title: "Erkenntnisse werden in den Alltag übersetzt",
        text: "Der vereinbarte Prozess bleibt anpassbar. Zum Abschluss werden Erfahrungen, nächste Schritte und Feedback strukturiert zusammengeführt.",
      },
    ],
  },
  {
    id: "concept-clean-kommunikation",
    eyebrow: "Use Case 02 · Aus der Praxis",
    title: "Kommunikation, die zum Arbeitsalltag passt",
    lead:
      "Concept Clean beschreibt einen Kommunikationskurs für Mitarbeitende, bei dem Matching, Inhalte und Zeiten auf den betrieblichen Kontext abgestimmt wurden.",
    tone: "customer",
    steps: [
      {
        label: "Anfrage",
        title: "Ein Kommunikationskurs wird gebucht",
        text: "Der Ausgangspunkt ist ein konkreter Entwicklungsbedarf für Mitarbeitende im Unternehmen.",
      },
      {
        label: "Matching",
        title: "Der passende Dozent wird verbunden",
        text: "Concept Clean hebt besonders hervor, dass das Matching flexibel und nicht nach einem starren Standard erfolgte.",
      },
      {
        label: "Ausrichtung",
        title: "Fachsprache und Teamalltag geben den Fokus vor",
        text: "Die branchenspezifische Fachsprache und die tägliche Kommunikation im Team wurden zum Kern der Einheiten.",
      },
      {
        label: "Durchführung",
        title: "Die Termine passen zu den Arbeitszeiten",
        text: "Die Einheiten ließen sich gut mit den Arbeitszeiten der Mitarbeitenden vereinbaren.",
      },
      {
        label: "Rückmeldung",
        title: "Der Weg wird als reibungslos erlebt",
        text: "Von der ersten Anfrage bis zur Durchführung bewertet Concept Clean den Ablauf durchgehend positiv.",
      },
    ],
  },
] as const;

const customerFeedback = {
  quote:
    "Wir haben über Donner und Partner einen Kommunikationskurs für unsere Mitarbeiter gebucht. Von der ersten Anfrage bis zur Durchführung lief alles absolut reibungslos. Besonders begeistert hat uns das flexible Matching: Der Dozent hat nicht einfach den Standard unterrichtet, sondern den Fokus genau auf unsere branchenspezifische Fachsprache und die tägliche Kommunikation im Team gelegt. Die Einheiten ließen sich super mit den Arbeitszeiten unserer Mitarbeiter vereinbaren.",
  source: "Concept Clean",
  context: "Kommunikationskurs für Mitarbeitende",
} as const;

const assessmentApplications = [
  {
    title: "Recruiting & Personalauswahl",
    text: "Externe Bewerbende oder interne Kandidatinnen und Kandidaten anhand eines abgestimmten Anforderungsprofils strukturiert und vergleichbar beurteilen.",
    icon: "user-round" as const,
  },
  {
    title: "Personalentwicklung",
    text: "Stärken und Entwicklungsfelder sichtbar machen und die Ergebnisse als fundierten Ausgangspunkt für Mindforge-Coachings nutzen.",
    icon: "sparkles" as const,
  },
];

const assessmentLevels = [
  {
    title: "Planung & Konzeption",
    text: "Anforderungsprofil, Übungsdesign, Beobachtungs- und Bewertungsbögen, internes Briefing sowie Regie- und Ablaufplan.",
    price: "2.500–3.800 €",
    unit: "zzgl. MwSt. · pauschal",
  },
  {
    title: "Full-Service",
    text: "Zusätzlich Moderation, neutrale Beobachtung, Auswertung, Gutachten und strukturierte Feedbackgespräche.",
    price: "4.500–7.500 €",
    unit: "zzgl. MwSt. · pro Assessment-Center-Tag",
  },
];

const faqs = [
  {
    question: "Für welche Unternehmen eignet sich Competence Hub?",
    answer: "Für Unternehmen, die Führung, Zusammenarbeit, Kommunikation, Gesundheit oder berufliche Entwicklung gezielt begleiten möchten. Der erste Schritt ist eine Klärung von Zielgruppe, Anlass und gewünschtem Format.",
  },
  {
    question: "Ist das Angebot nur für Führungskräfte gedacht?",
    answer: "Nein. Führungskräfte sind eine wichtige Zielgruppe, aber auch Teams und Mitarbeitende in Veränderungs- oder Entwicklungssituationen können einbezogen werden.",
  },
  {
    question: "Gibt es garantierte Ergebnisse?",
    answer: "Nein. Coaching kann Reflexion, Orientierung und professionelle Entwicklung unterstützen, ersetzt aber keine unternehmerische Entscheidung und keine medizinische oder therapeutische Beratung.",
  },
  {
    question: "Können Assessment Center auch der Personalentwicklung dienen?",
    answer: "Ja. Neben der Personalauswahl können Development Assessment Center Potenziale und Entwicklungsfelder sichtbar machen. Die Ergebnisse lassen sich anschließend in Mindforge-Coachings gezielt weiterbearbeiten.",
  },
];
---

<BaseLayout
  title="Coaching für Unternehmen | Competence Hub"
  description="Competence Hub verbindet Unternehmen mit ausgewählten Coaches und Expertise für Führung, Zusammenarbeit, Recruiting, Gesundheit und Veränderung."
>
  <main class="subpage">
    <ConnectedPageHero
      eyebrow="Für Unternehmen"
      title="Passende Coaches für echte Themen im Unternehmen"
      lead="Competence Hub hilft Unternehmen, ihren Bedarf klar zu formulieren und vermittelt ausgewählte Coaches für das konkrete Thema, die Zielgruppe und den gewünschten Rahmen."
      centerLabel="Unternehmen"
      centerDetail="Anliegen und Ziele"
      centerIcon="building"
      titleId="company-title"
      related={[
        {
          label: "Firmencoaching",
          detail: "Führung & Teams",
          href: "mindforge#unternehmen",
          icon: "leadership",
        },
        {
          label: "Assessment Center",
          detail: "Auswahl & Entwicklung",
          href: "#assessment-center",
          icon: "user-round",
        },
        {
          label: "Coaches",
          detail: "Expertise wählen",
          href: "coaches",
          icon: "users",
        },
      ]}
    >
      <div slot="actions" class="actions">
        <a class="button" href={url("kontakt")}>Bedarf besprechen</a>
        <a class="button button--ghost" href={url("leistungen")}>Angebote vergleichen</a>
      </div>
    </ConnectedPageHero>

    <section
      class="feature-grid feature-grid--company"
      id="anlaesse"
      aria-label="Typische Anlässe für Unternehmen"
    >
      {occasions.map((occasion) => (
        <article class="feature-card">
          <span class="feature-card__icon"><Icon name={occasion.icon} size={28} /></span>
          <h2>{occasion.title}</h2>
          <p>{occasion.text}</p>
        </article>
      ))}
    </section>

    <section class="assessment-section" id="assessment-center" aria-labelledby="assessment-title">
      <div class="assessment-section__heading">
        <div>
          <p class="eyebrow">Kompakter Spezialbereich</p>
          <h2 id="assessment-title">Assessment Center für Auswahl und Entwicklung</h2>
        </div>
        <p>
          Präsenz, digital oder hybrid. Umfang und Beobachtungsaufwand werden
          passend zur Zielgruppe und zur konkreten Entscheidung geplant.
        </p>
      </div>

      <div class="assessment-applications">
        {assessmentApplications.map((application) => (
          <article>
            <Icon name={application.icon} size={28} />
            <div>
              <h3>{application.title}</h3>
              <p>{application.text}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="assessment-levels" aria-label="Leistungsstufen und Preise">
        {assessmentLevels.map((level) => (
          <article>
            <div>
              <h3>{level.title}</h3>
              <p>{level.text}</p>
            </div>
            <strong>{level.price}</strong>
            <small>{level.unit}</small>
          </article>
        ))}
      </div>

      <div class="assessment-section__links">
        <a class="button" href={url("kontakt")}>Assessment Center anfragen</a>
        <a class="text-link" href={url("mindforge#unternehmen")}>
          Mindforge für Unternehmen
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </section>

    <section class="split-panel">
      <div>
        <p class="eyebrow">Nutzen</p>
        <h2>Vom ersten Anliegen zur passenden Person</h2>
        <p>
          Unternehmen müssen nicht sofort wissen, welches Format richtig ist.
          Im ersten Schritt werden Anlass, Zielgruppe, Dringlichkeit und
          mögliche Formate sortiert und passende Expertise ausgewählt.
        </p>
      </div>
      <div class="benefit-grid">
        {benefits.map((benefit) => <span>{benefit}</span>)}
      </div>
    </section>

    <section
      class="customer-feedback-section"
      aria-labelledby="customer-feedback-title"
    >
      <div class="customer-feedback__intro">
        <p class="eyebrow">Kundenfeedback</p>
        <h2 id="customer-feedback-title">
          So hat Concept Clean die Zusammenarbeit erlebt
        </h2>
        <p>
          Die Rückmeldung bezieht sich auf einen Kommunikationskurs für
          Mitarbeitende, der an Fachsprache, Teamalltag und Arbeitszeiten
          angepasst wurde.
        </p>
      </div>

      <blockquote class="customer-feedback__quote">
        <span class="customer-feedback__quote-mark" aria-hidden="true">„</span>
        <p>{customerFeedback.quote}</p>
        <footer>
          <cite>{customerFeedback.source}</cite>
          <span>{customerFeedback.context}</span>
        </footer>
      </blockquote>
    </section>

    <section class="use-case-section" aria-labelledby="use-case-title">
      <div class="section-heading use-case-section__heading">
        <p class="eyebrow">Vom Anliegen zur Umsetzung</p>
        <h2 id="use-case-title">Zwei Wege durch den Competence Hub</h2>
        <p>
          Der genaue Verlauf richtet sich nach Anlass, Zielgruppe und Format.
          Die folgenden Geschichten machen sichtbar, wie die einzelnen Ebenen
          zusammenspielen können.
        </p>
      </div>

      <div class="case-story-list">
        {caseStories.map((story) => (
          <article
            class:list={[
              "case-story",
              `case-story--${story.tone}`,
            ]}
            id={story.id}
          >
            <header class="case-story__header">
              <div>
                <p class="eyebrow">{story.eyebrow}</p>
                <h3>{story.title}</h3>
              </div>
              <p>{story.lead}</p>
            </header>

            <div class="case-story__route">
              <svg
                class="case-story__curve"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M50 0 C88 6 88 19 50 25 C12 31 12 44 50 50 C88 56 88 69 50 75 C12 81 12 94 50 100" />
              </svg>
              <ol class="case-story__steps">
                {story.steps.map((step, index) => (
                  <li class="case-story__step">
                    <div class="case-story__step-copy">
                      <small>{step.label}</small>
                      <h4>{step.title}</h4>
                      <p>{step.text}</p>
                    </div>
                    <span class="case-story__marker" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </li>
                ))}
              </ol>
            </div>

          </article>
        ))}
      </div>
    </section>

    <section class="faq-section" aria-labelledby="company-faq-title">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="company-faq-title">Fragen von Unternehmen</h2>
      </div>
      <div class="faq-grid">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="cta-panel">
      <div>
        <p class="eyebrow">Nächster Schritt</p>
        <h2>Coaching-Bedarf kurz beschreiben</h2>
      </div>
      <a class="button" href={url("kontakt")}>Bedarf besprechen</a>
    </section>
  </main>
</BaseLayout>
