---
import type { GetStaticPaths } from "astro";
import Icon from "../../../../components/Icon.astro";
import { workshopDiscoveryPath, workshopProfiles, type WorkshopProfile, type WorkshopTheme } from "../../../../data/workshop-themes";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { coachRequestMailto } from "../../../../preview/request-links";
import "../../../../styles/global.css";

export const getStaticPaths = (() => workshopProfiles.flatMap(({ coach, copy, slug, themes }) =>
  themes.map((theme) => ({ params: { slug, thema: theme.id }, props: { coach, copy, theme } }))
)) satisfies GetStaticPaths;

interface Props {
  coach: WorkshopProfile["coach"];
  copy: WorkshopProfile["copy"];
  theme: WorkshopTheme;
}

const { coach, copy, theme } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}/${path}`;
---

<BaseLayout title={`${theme.title} | Competence Hub`} description={theme.text} canonical={false}>
  <main class="workshop-detail">
    <header class="workshop-masthead">
      <div class="workshop-wrap">
        <a class="text-link workshop-back" href={url(workshopDiscoveryPath)}><Icon name="arrow-right" size={16} /> Alle Workshop-Themen</a>
        <div class="workshop-layout">
          <div>
            <p class="eyebrow">Gruppenformate für Unternehmen</p>
            <h1>{theme.title}</h1>
            <p class="workshop-lede">{theme.text}</p>
          </div>
          <div class="workshop-coach">
            {coach.image && (
              <img src={url(coach.image)} alt={copy.portraitAlt} width={coach.imageWidth} height={coach.imageHeight} />
            )}
            <div>
              <a class="text-link" href={url(`${coach.profilePath}/`)}>{coach.name} <Icon name="arrow-right" size={16} /></a>
              <p>{coach.role}</p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="workshop-wrap">
      <section class="workshop-row" aria-labelledby="workshop-audience">
        <h2 id="workshop-audience">Für wen?</h2>
        <p>{theme.fit}</p>
      </section>
      <section class="workshop-row" aria-labelledby="workshop-content">
        <h2 id="workshop-content">Darum geht es</h2>
        <ul class="workshop-focus" role="list">
          {theme.focus.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section class="workshop-row" aria-labelledby="workshop-takeaway">
        <h2 id="workshop-takeaway">Was Sie mitnehmen können</h2>
        <p>{theme.takeaway}</p>
      </section>
      <section class="workshop-row" aria-labelledby="workshop-request">
        <h2 id="workshop-request">Passendes Format besprechen</h2>
        <div>
          <p>Ob ein Workshop, ein Vortrag oder ein anderes Format passt, klären Sie mit Frau Rappelt.</p>
          <div class="workshop-actions">
            <a class="button" href={url(`kontakt/?workshop=${theme.id}`)}><Icon name="message-circle" size={19} /> Thema mit Frau Rappelt besprechen</a>
            <a class="text-link" href={coachRequestMailto(coach.name, theme.title)}>Direkt per E-Mail anfragen <Icon name="arrow-right" size={18} /></a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .workshop-detail { overflow-wrap: anywhere; }
  .workshop-wrap { inline-size: min(100% - 2rem, 72rem); margin-inline: auto; }
  .workshop-masthead { background: var(--color-soft); border-block-end: 1px solid var(--color-line); padding-block: 1.5rem 2.75rem; }
  .workshop-back { margin-block-end: 1.25rem; }
  .workshop-back :global(svg) { transform: rotate(180deg); }
  .workshop-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .52fr); gap: 1.5rem 3.5rem; align-items: center; }
  .eyebrow { margin: 0 0 .5rem; color: var(--color-pantone-deep); }
  h1, h2 { margin: 0; letter-spacing: 0; overflow-wrap: anywhere; hyphens: auto; }
  h1 { font-size: 3rem; line-height: 1.1; text-wrap: balance; }
  h2 { font-size: 1.5rem; line-height: 1.24; }
  p { margin: 0; }
  .workshop-lede { max-inline-size: 60ch; margin-block-start: .85rem; font-size: 1.15rem; }
  .workshop-coach { display: flex; align-items: center; gap: .9rem; }
  .workshop-coach img { inline-size: 6rem; block-size: 6rem; object-fit: cover; border-radius: 4px; flex: none; }
  .workshop-coach p { font-size: .95rem; }
  .workshop-row { display: grid; grid-template-columns: minmax(0, .6fr) minmax(0, 1fr); gap: .65rem 2rem; padding-block: 1.75rem; }
  .workshop-row + .workshop-row { border-block-start: 1px solid var(--color-line); }
  .workshop-row p { max-inline-size: 65ch; }
  .workshop-focus { display: grid; gap: .35rem; padding-inline-start: 1.1rem; margin: 0; }
  .workshop-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem 1.25rem; margin-block-start: 1.15rem; }
  .workshop-detail :is(.text-link, .button) { display: inline-flex; align-items: center; min-block-size: 44px; max-inline-size: 100%; gap: .5rem; white-space: normal; }
  .workshop-detail a:focus-visible { outline: 3px solid var(--color-pantone-deep); outline-offset: 3px; }
  .workshop-detail :global(svg) { flex: none; }

  @media (max-width: 50rem) {
    .workshop-layout, .workshop-row { grid-template-columns: minmax(0, 1fr); }
    h1 { font-size: 2rem; }
    h2 { font-size: 1.3rem; }
    .workshop-coach img { inline-size: 4.75rem; block-size: 4.75rem; }
  }
</style>
