---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;

const topics = [
  {
    title: "Technologien und Prozesse sinnvoll einführen",
    text: "Investitionen, Abläufe und wirtschaftlichen Nutzen vor dem Start einordnen und neue Werkzeuge schrittweise in den betrieblichen Alltag integrieren.",
  },
  {
    title: "Menschen in Veränderung beteiligen",
    text: "Unsicherheiten ernst nehmen, Prozesswissen nutzen und Mitarbeitende so einbinden, dass Modernisierung, Digitalisierung und neue Arbeitsweisen gemeinsam getragen werden.",
  },
  {
    title: "Führung und Potenziale stärken",
    text: "Verantwortung, Teamarbeit und praktische Fähigkeiten sichtbar machen und bei Führung, Fachkräftesicherung sowie Integration konsequent mitdenken.",
  },
];
---

<BaseLayout
  title="Herr T. Wegner-Ney | Coaches | Competence Hub"
  description="Herr T. Wegner-Ney begleitet mittelständische Unternehmen bei Technologie- und Prozessveränderung, Qualitätsmanagement, Führung und Fachkräftesicherung."
>
  <main class="subpage">
    <section class="coach-profile-hero">
      <div>
        <p class="eyebrow">Unternehmensberatung, Workshops & Vorträge</p>
        <h1>Herr T. Wegner-Ney</h1>
        <p class="coach-profile-lead">
          Unternehmensberater, Speaker, Workshop-Leiter und Coach für
          mittelständische Unternehmen, die neue Technologien, Prozesse und
          Zusammenarbeit praxisnah weiterentwickeln möchten.
        </p>
        <p>
          Herr T. Wegner-Ney betrachtet Unternehmen als Ganzes. Er verbindet
          Industrie- und Führungserfahrung mit Qualitätsmanagement,
          Prozessoptimierung und einer verständlichen Begleitung von
          Veränderungen. KI kann dabei als konkrete Technologie vorkommen,
          steht aber nicht im Zentrum seines Angebots.
        </p>
        <div class="coach-profile-actions">
          <a class="button" href={url("kontakt")}>Format anfragen</a>
          <a class="button button--ghost" href={url("coaches")}>Alle Coaches</a>
        </div>
      </div>
      <figure class="coach-profile-portrait">
        <img
          src={url("images/coaches/wegner-ney.jpg")}
          alt="Porträt von Herrn T. Wegner-Ney"
          width="1030"
          height="1545"
        />
        <figcaption>
          <strong>Herr T. Wegner-Ney</strong>
          <span>Veränderung · Prozesse · Führung</span>
        </figcaption>
      </figure>
    </section>

    <section class="coach-profile-section">
      <div class="section-heading coach-section-heading">
        <div>
          <p class="eyebrow">Themenschwerpunkte</p>
          <h2>Erst verstehen. Dann verändern.</h2>
        </div>
        <p>
          Die Angebote richten sich an Unternehmerinnen und Unternehmer,
          Führungskräfte sowie Mitarbeitende, die Veränderung wirtschaftlich,
          verständlich und gemeinsam gestalten möchten.
        </p>
      </div>

      <div class="coach-topic-grid">
        {topics.map((topic) => (
          <article>
            <h3>{topic.title}</h3>
            <p>{topic.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="coach-credentials">
      <div>
        <p class="eyebrow">Profil</p>
        <h2>Praxis vom Produktionsalltag bis zur Geschäftsleitung</h2>
        <p>
          Herr T. Wegner-Ney spricht unterschiedliche Unternehmenssprachen und
          verbindet technisches Verständnis, Qualitätsarbeit, Projekt- und
          Führungserfahrung mit anschaulicher Vermittlung.
        </p>
      </div>
      <ul>
        <li>Staatlich geprüfter Techniker Druck- und Medientechnik</li>
        <li>Zertifizierter Qualitätsbeauftragter</li>
        <li>Ausbilder nach AEVO</li>
        <li>Qualitätsmanagement und Prozessoptimierung</li>
        <li>Projektleitung und Führungskräfteentwicklung</li>
        <li>Konzeption von Workshops und Fachvorträgen</li>
      </ul>
    </section>

    <section class="coach-format-band" aria-labelledby="wegner-formats-title">
      <div>
        <p class="eyebrow">Mögliche Formate</p>
        <h2 id="wegner-formats-title">Vortrag oder Workshop passend zum Bedarf</h2>
      </div>
      <p>
        Themen können von Technologie- und Prozessveränderung über
        Qualitätsmanagement und Mitarbeiterbeteiligung bis zu Führung,
        Fachkräftesicherung und Integration reichen. Zielgruppe, Ausgangslage
        und gewünschter Nutzen bestimmen den konkreten Zuschnitt.
      </p>
    </section>

    <section class="showcase-strip coach-profile-cta">
      <div>
        <p class="eyebrow">Persönlich verbunden</p>
        <h2>Passt diese Expertise zu Ihrem Vorhaben?</h2>
      </div>
      <div>
        <p>
          Frau Janay Rappelt unterstützt bei der Einordnung und stellt den
          Kontakt zwischen Unternehmen und Coach her.
        </p>
        <a class="button" href={url("kontakt")}>Bedarf besprechen</a>
      </div>
    </section>
  </main>
</BaseLayout>
