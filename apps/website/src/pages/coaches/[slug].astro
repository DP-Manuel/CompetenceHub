---
import type { GetStaticPaths } from "astro";
import { coachProfilesFor } from "../../../config/active-coach-publication.mjs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CoachEditorialProfile from "../../components/CoachEditorialProfile.astro";
import { editorialProfileCopy } from "../../components/editorial-profile-copy";
import { coaches } from "../../preview/coaches";
import { finderEntries } from "../../preview/offering-finder-data";
import type { Coach } from "../../data/coaches";
import "../../styles/global.css";

export const getStaticPaths = (() => {
  const mode = import.meta.env.PUBLIC_REVIEW_MODE === "true" ? "preview" : "production";
  const editorialRoutes = new Map(coachProfilesFor(mode)
    .filter(({ injected }) => !injected)
    .map(({ slug }) => [`coaches/${slug}`, slug]));

  return coaches.flatMap((coach) => {
    const slug = editorialRoutes.get(coach.profilePath);
    return slug && coach.kind === "approved" ? [{ params: { slug }, props: { coach } }] : [];
  });
}) satisfies GetStaticPaths;

interface Props {
  coach: Coach;
}

const { coach } = Astro.props;
const copy = editorialProfileCopy.get(coach.profilePath);
const offerTitles = finderEntries
  .filter((entry) => entry.coach.profilePath === coach.profilePath)
  .map(({ title }) => title);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const profileUrl = (path: string) => `${base}/${path.replace(/^\//, "")}`;
---

<BaseLayout
  title={`${coach.name} | Coaches | Competence Hub`}
  description={copy?.description ?? coach.text}
  editorialProfile
>
  <CoachEditorialProfile {coach} {copy} {offerTitles} url={profileUrl} />
</BaseLayout>
