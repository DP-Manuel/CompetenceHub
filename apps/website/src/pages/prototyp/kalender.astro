---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Veranstaltungskalender | Competence Hub"
  description="Zum öffentlichen Veranstaltungskalender des Competence Hub."
  noindex
>
  <main class="subpage">
    <section class="page-hero page-hero--accent">
      <div>
        <h1>Veranstaltungskalender</h1>
        <a class="button" href={`${base}/kalender/`}>Zu den aktuellen Terminen</a>
      </div>
    </section>
  </main>
</BaseLayout>
