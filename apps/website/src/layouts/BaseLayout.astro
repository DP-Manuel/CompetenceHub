---
import Icon from "../components/Icon.astro";
import HubClearance from "../preview/HubClearance.astro";
import { finderEntries } from "../preview/offering-finder-data";
import { activeCoaches } from "../data/coaches";
import PortalLogin from "../components/PortalLogin.astro";
import UpcomingEvents from "../components/UpcomingEvents.astro";
import { portalLoginConfiguration } from "../../config/environment.mjs";
import { demoOfferPath, portalPath, publicCalendarPath } from "../v2-local/journey.mjs";
import { previewCities, venuePath } from "../data/venues.mjs";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  noindex?: boolean;
  canonical?: boolean;
  editorialProfile?: boolean;
  socialImage?: string;
}

const {
  title,
  description = "Competence Hub verbindet Unternehmen und Privatpersonen mit ausgewählten Coaches, passenden Formaten und persönlicher Begleitung.",
  bodyClass = "",
  noindex = false,
  canonical = true,
  editorialProfile = false,
  socialImage,
} = Astro.props;

const reviewMode = import.meta.env.PUBLIC_REVIEW_MODE === "true";
const v2Local = __WEBSITE_V2_LOCAL__;
const portalLogin = v2Local
  ? { href: portalPath, visible: true }
  : portalLoginConfiguration(undefined, { development: import.meta.env.DEV });
const canonicalSite = new URL("https://competencehub.donner-partner.de");

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;
const navHref = (path: string) => v2Local && path === "kalender" ? publicCalendarPath : url(path);
const reviewBase = base === "/" ? "/" : base.slice(0, -1);
const canonicalPath = (reviewMode || v2Local) && Astro.url.pathname.startsWith(reviewBase)
  ? Astro.url.pathname.slice(reviewBase.length) || "/"
  : Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, canonicalSite).toString();

const navigation = [
  { label: "Start", href: "" },
  { label: "Für Unternehmen", href: "unternehmen" },
  { label: "Coaches", href: "coaches" },
  { label: "Kalender", href: "kalender" },
];

const serviceNavigation = [
  { label: "Alle Leistungen", href: "leistungen", icon: "compass" as const },
  { label: "Angebotsfinder", href: "leistungen#angebotsfinder", icon: "compass" as const },
  { label: "Mindforge · Coaching & Beratung", href: "mindforge", icon: "sparkles" as const },
  { label: "Recruiting", href: "leistungen#recruiting", icon: "user-round" as const },
  { label: "Personalentwicklung", href: "leistungen#personalentwicklung", icon: "users" as const },
  { label: "Workshops & Vorträge", href: "leistungen#gruppenformate", icon: "users" as const },
];

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const isCurrent = (path = "") =>
  normalizePath(Astro.url.pathname) === normalizePath(url(path));
const isServicePage = ["leistungen", "mindforge", "lifecoaching", "livecoaching", "businesscoaching"].some(
  (path) => isCurrent(path),
);
const profilePath = canonicalPath.replace(/^\//, "").replace(/\/$/, "");
const publicProfile = activeCoaches.find((coach) => coach.profilePath === profilePath);
const approvedProfile = Boolean(publicProfile);
const shareImage = socialImage && Astro.site ? new URL(socialImage, Astro.site).href
  : publicProfile?.image ? new URL(publicProfile.image, canonicalSite).href : "";
const localDemoProfile = v2Local && profilePath === "coaches/v2-demo-coach";
const showUpcoming = approvedProfile || localDemoProfile || (v2Local && isCurrent());
const profileUpcoming = approvedProfile || localDemoProfile ? `/${profilePath}/` : "";
const upcomingCalendarHref = profileUpcoming
  ? `${publicCalendarPath}?coach=${encodeURIComponent(profilePath.split("/")[1])}` : publicCalendarPath;
const profileHasOffers = approvedProfile && finderEntries.some((entry) => entry.coach.profilePath === profilePath);
const currentNav = (path: string) => isCurrent(path) ? "page" : path === "coaches" && approvedProfile ? "location" : undefined;
const journeyVisible = (reviewMode && /^coaches\/[^/]+$/.test(profilePath)) || approvedProfile || isCurrent("kalender");
const finderHref = profileHasOffers
  ? url(`leistungen?coach=${encodeURIComponent(profilePath.split("/")[1])}#angebotsfinder`)
  : url("leistungen#angebotsfinder");
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Competence Hub" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!v2Local && shareImage && <meta property="og:image" content={shareImage} />}
    {canonical && !v2Local && <meta property="og:url" content={canonicalUrl} />}
    {canonical && !v2Local && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    {(reviewMode || noindex || v2Local) && (
      <meta name="robots" content="noindex, nofollow, noarchive" />
    )}
    <title>{title}</title>
    {reviewMode && <HubClearance />}
  </head>
  <body class={bodyClass}>
    {reviewMode && (
      <div class="review-banner" role="status">
        Entwicklungs-/Vorschauversion
      </div>
    )}{v2Local && (
      <div class="review-banner">
        Lokaler V2-Pilot · Synthetische Kalenderdaten · <a href={url(demoOfferPath)}>Demo-Angebot</a>
        <style is:inline>.review-banner a { text-decoration: underline; }</style>
      </div>
    )}
    <header class="site-header">
      <a class="brand" href={url()} aria-label="Competence Hub Startseite">
        <span class="brand__mark">Competence <em>Hub</em></span>
        <span class="brand__line">Passende Expertise. Persönlich verbunden.</span>
      </a>
      <nav class="nav nav--desktop" aria-label="Hauptnavigation">
        <a href={url()} aria-current={isCurrent() ? "page" : undefined}>Start</a>
        <details class="services-menu">
          <summary aria-current={isServicePage ? "location" : undefined} class:list={{ "is-current": isServicePage }}>Leistungen</summary>
          <div class="services-menu__panel">
            <strong>Leistungen im Überblick</strong>
            {serviceNavigation.map((item) => (
              <a href={url(item.href)}>
                <Icon name={item.icon} size={20} />
                <span>{item.label}</span>
                <Icon name="arrow-right" size={17} />
              </a>
            ))}
          </div>
        </details>
        {navigation.slice(1).map((item) => (
          <a
            href={navHref(item.href)}
            aria-current={currentNav(item.href)}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <details class="nav-menu">
        <summary>Menü</summary>
        <nav class="nav" aria-label="Mobile Hauptnavigation">{portalLogin.visible && <PortalLogin href={portalLogin.href} placement="mobile" />}
          <a href={url()} aria-current={isCurrent() ? "page" : undefined}>Start</a>
          {serviceNavigation.map((item) => (
            <a
            href={url(item.href)}
              aria-current={currentNav(item.href)}
            >
              {item.label}
            </a>
          ))}
          {navigation.slice(1).map((item) => (
            <a
            href={navHref(item.href)}
              aria-current={currentNav(item.href)}
            >
              {item.label}
            </a>
          ))}
          <a href={url("kontakt")} aria-current={currentNav("kontakt")}>Kontakt</a>
        </nav>
      </details>
      <div class="header-actions">
        <a class="button" href={url("kontakt")}>Bedarf besprechen</a>{portalLogin.visible && <PortalLogin href={portalLogin.href} placement="desktop" />}
      </div>
    </header>
    {journeyVisible && !editorialProfile && <Fragment>
      <nav class="preview-journey-links" aria-label="Passendes Angebot und nächster Schritt">
        <a href={finderHref}>{profileHasOffers ? "Angebote dieses Coaches" : "Angebotsfinder"}</a>
        {showUpcoming && <a href="#aktuelle-termine">Nächste Veranstaltungen</a>}
        {isCurrent("kalender") ? <a href={url("coaches")}>Coachprofile ansehen</a> : <a href={navHref("kalender")}>Veranstaltungskalender</a>}
        <a href={url("kontakt")}>Bedarf besprechen</a>
      </nav>
      <style is:inline>
        .preview-journey-links { display:flex; flex-wrap:wrap; gap:8px 28px; max-width:1440px; margin:0 auto; padding:16px 24px; border-bottom:1px solid var(--color-line); }
        .preview-journey-links a { display:inline-flex; align-items:center; min-height:44px; color:var(--color-pantone-deep); font-weight:750; overflow-wrap:anywhere; }
        .preview-journey-links a:focus-visible { outline:3px solid var(--color-dark); outline-offset:4px; }
      </style>
    </Fragment>}<slot />
    {showUpcoming && !editorialProfile && <UpcomingEvents live={v2Local} coachPath={profileUpcoming} calendarHref={upcomingCalendarHref} />}
    <footer class="site-footer">
      <div>
        <strong>Competence Hub</strong>
        <span>Ein Angebot von Donner + Partner</span>
        <a class="site-footer__contact" href="mailto:competencehub@donner-partner.de">
          competencehub@donner-partner.de
        </a>
      </div>
      <nav aria-label="Footer">
        <a href={url("leistungen")}>Leistungen</a>
        <a href={url("mindforge")}>Mindforge</a>
        <a href={url("unternehmen")}>Für Unternehmen</a>
        <a href={url("coaches")}>Coaches</a>
        <a href={navHref("kalender")}>Kalender</a>
        {reviewMode && previewCities.length > 0 && <a href={url(venuePath)}>Veranstaltungsorte</a>}
        <a href={url("ueber-uns")}>Über uns</a>
        <a href={url("kontakt")}>Kontakt</a>
        <a href="https://donner-partner.de/dp/impressum/">Impressum</a>
        <a href="https://donner-partner.de/dp/datenschutz/">Datenschutz</a>
        <a href="https://donner-partner.de/dp/agb/">AGB</a>
      </nav>
    </footer>
  </body>
</html>
