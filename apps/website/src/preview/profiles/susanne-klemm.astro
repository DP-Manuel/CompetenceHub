---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { susanneKlemm as coach, qualifications, workshops } from "../susanne-klemm";
import "../../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const url = (path = "") => `${base}${path.replace(/^\//, "")}`;
---
<BaseLayout canonical={false} title="Frau Susanne Klemm | Coaches | Competence Hub" description={coach.text}>
  <main class="subpage">
    <section class="coach-profile-hero">
      <div>
        <p class="eyebrow">{coach.role}</p>
        <h1>{coach.name}</h1>
        <p class="coach-profile-lead">{coach.text}</p>
        <p>Fragetechniken, Feedback und Körpersprache, der Wechsel in eine Führungsrolle und klare Grenzen im Alltag bilden die Schwerpunkte ihrer Workshopangebote. Praktische Übungen und Selbstreflexion unterstützen den Transfer in den Berufsalltag.</p>
        <div class="coach-profile-actions"><a class="button" href={url("kontakt")}>Passung und Anfrage besprechen</a></div>
      </div>
      <figure class="coach-profile-portrait">
        <img src={url(coach.image!)} alt="Porträt von Frau Susanne Klemm" width={coach.imageWidth} height={coach.imageHeight} />
        <figcaption><strong>{coach.name}</strong><span>{coach.previewRole}</span></figcaption>
      </figure>
    </section>
    <section class="coach-profile-section">
      <div class="section-heading coach-section-heading"><div><p class="eyebrow">Themenschwerpunkte</p><h2>Gespräche bewusst gestalten und klar führen</h2></div></div>
      <div class="coach-topic-grid">
        <article><h3>Kommunikation und Wahrnehmung</h3><p>Gezielt fragen, Feedback nutzen, Körpersprache wahrnehmen und schwierige Themen respektvoll ansprechen.</p></article>
        <article><h3>Führung und Rollenbewusstsein</h3><p>Den Rollenwechsel zur Führungskraft gestalten, Verantwortung abgeben und die eigene Führungshaltung reflektieren.</p></article>
        <article><h3>Stress und Abgrenzung</h3><p>Eigene Verantwortung von fremden Erwartungen unterscheiden und im Umgang mit Anspannung handlungsfähig bleiben.</p></article>
      </div>
    </section>
    <section class="coach-credentials">
      <div><p class="eyebrow">Qualifikationen</p><h2>Ausbildungen und Weiterbildungen</h2><p>Die fachlichen Grundlagen umfassen Coaching, Resilienztraining und Kommunikation sowie eine kompakte Weiterbildung in systemischer Supervision.</p></div>
      <ul>{qualifications.map((qualification) => <li>{qualification}</li>)}</ul>
    </section>
    <section class="coach-profile-section">
      <div class="section-heading coach-section-heading"><div><p class="eyebrow">Angebote</p><h2>Workshops für den Berufsalltag</h2></div><p>Die Themen richten sich unter anderem an Führungskräfte und Mitarbeitende. Einzelne Angebote greifen ausdrücklich den Führungsalltag in der Pflege auf.</p></div>
      <ul class="workshops">{workshops.map((workshop) => <li>{workshop}</li>)}</ul>
    </section>
    <section class="showcase-strip coach-profile-cta">
      <div><p class="eyebrow">Passung klären</p><h2>Ihr Anliegen mit uns besprechen</h2></div>
      <div><p>Janay Rappelt unterstützt bei der Einordnung und stellt den Kontakt her.</p><a class="button" href={url("kontakt")}>Bedarf besprechen</a></div>
    </section>
  </main>
</BaseLayout>
<style>
  .workshops { padding-left: 24px; max-width: 80ch; }
  .workshops li { margin-block: 18px; overflow-wrap: anywhere; }
</style>
