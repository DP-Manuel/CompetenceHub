---
import Icon from "../components/Icon.astro";
import { guelcanOfferFamilies } from "./guelcan-offers";
import { coachRequestMailto } from "./request-links";
---
<section class="guelcan-offers" aria-labelledby="guelcan-offers-title">
  <header>
    <p class="eyebrow">Angebote von Gülcan Elmas-Brandes</p>
    <h2 id="guelcan-offers-title">Drei Themenfelder, ein passender Rahmen</h2>
    <p>Termine, Durchführung und Passung werden persönlich abgestimmt.</p>
  </header>
  <div class="guelcan-offer-grid">
    {guelcanOfferFamilies.map((family) => (
      <article class="guelcan-offer" data-offer-family={family.key}>
        <h3>{family.title}</h3>
        <p>{family.audience}</p>
        <ul class="guelcan-formats">
          {family.formats.map((format) => (
            <li data-offer-format={format.key}>
              <h4>{format.title}</h4>
              <p>{format.detail}</p>
              <a class="text-link" href={coachRequestMailto("Frau Gülcan Elmas-Brandes", `${family.title} · ${format.title}`)}
                aria-label={`${format.title} aus ${family.title} per E-Mail anfragen`}>
                E-Mail-Anfrage <Icon name="arrow-right" size={20} />
              </a>
            </li>
          ))}
        </ul>
        {family.options.length > 0 && <details>
          <summary>Ergänzende Möglichkeiten</summary>
          <ul>{family.options.map((option) => <li>{option}</li>)}</ul>
        </details>}
        <p class="guelcan-boundary"><strong>Leistungsrahmen</strong>{family.boundary}</p>
      </article>
    ))}
  </div>
</section>
<style>
  .guelcan-offers { margin-block: 48px 70px; padding-top: 32px; border-top: 8px solid var(--color-pantone); }
  header { max-width: 70ch; margin-bottom: 28px; }
  h2 { font-size: 2rem; line-height: 1.2; margin-bottom: 18px; }
  .guelcan-offer-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: 32px; }
  .guelcan-offer { min-width: 0; border-top: 2px solid var(--color-line); padding-top: 22px; }
  h3 { font-size: 1.35rem; line-height: 1.3; margin-bottom: 16px; overflow-wrap: anywhere; }
  h4 { font-size: 1.1rem; line-height: 1.4; margin-bottom: 10px; }
  p, li, a { overflow-wrap: anywhere; }
  .text-link { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; }
  .guelcan-formats { list-style: none; padding: 0; margin: 24px 0; }
  .guelcan-formats > li { padding-block: 18px; border-top: 1px solid var(--color-line); }
  .guelcan-formats p { margin-bottom: 10px; }
  details { margin-block: 20px; }
  summary { cursor: pointer; font-weight: 750; padding: 10px 0; }
  summary:focus-visible { outline: 3px solid var(--color-dark); outline-offset: 4px; }
  details ul { padding-left: 22px; }
  details li { margin-block: 12px; }
  .guelcan-boundary { font-size: 0.95rem; border-left: 3px solid var(--color-pantone); padding-left: 14px; }
  .guelcan-boundary strong { display: block; margin-bottom: 8px; }
  @media (max-width: 960px) { .guelcan-offer-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
