---
import Icon from "../components/Icon.astro";
import { categories, topics } from "./topics";
import { finderAudiences, finderFormats, finderDuration, type FinderEntry } from "./offering-finder-model";
import { coachRequestMailto } from "./request-links";
interface Props { entries: readonly FinderEntry[] }
const { entries } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}/${path}`;
---
<section class="offering-finder" id="angebotsfinder" aria-labelledby="finder-title" data-offering-finder>
  <header class="finder-heading">
    <div><p class="eyebrow">Angebotsfinder</p><h2 id="finder-title">Was möchten Sie bewegen?</h2></div>
    <p>Coaching, Workshops und Impulse für Ihren nächsten Schritt. Termine und Durchführung stimmen wir persönlich ab.</p>
  </header>
  <form class="finder-filters" aria-label="Angebote filtern" data-finder-form hidden>
    <div class="finder-filter-row">
      <div><label for="finder-query">Angebot oder Coach</label><input id="finder-query" type="search" name="query" maxlength="80" autocomplete="off" placeholder="Zum Beispiel Stress oder Führung" aria-controls="finder-results" /></div>
      <div><label for="finder-audience">Zielgruppe</label><select id="finder-audience" name="audience" aria-controls="finder-results"><option value="all">Alle Zielgruppen</option>{finderAudiences.map((audience) => <option value={audience.id}>{audience.label}</option>)}</select></div>
      <div><label for="finder-format">Format</label><select id="finder-format" name="format" aria-controls="finder-results"><option value="all">Alle Formate</option>{finderFormats.map((format) => <option value={format.id}>{format.label}</option>)}</select></div>
    </div>
    <div class="finder-filter-actions">
      <details class="finder-topics">
        <summary>Themen und Kategorien</summary>
        <div class="finder-topic-options">
          <label for="finder-category">Kategorie</label><select id="finder-category" name="category"><option value="all">Alle Kategorien</option>{categories.map((category) => <option value={category.id}>{category.label}</option>)}</select>
          <fieldset><legend>Themenschwerpunkte</legend>
            <div class="finder-topic-checks">{topics.map((topic) => <label><input type="checkbox" name="topic" value={topic.id} /><span>{topic.label}</span></label>)}</div>
          </fieldset>
        </div>
      </details>
      <button class="finder-reset" type="reset">Filter zurücksetzen</button>
    </div>
  </form>
  <div class="finder-result-heading"><p data-finder-status role="status" aria-live="polite" aria-atomic="true">{entries.length} Angebote</p><a href={url("coaches")}>Zum Coach-Netzwerk <Icon name="arrow-right" size={18} /></a></div>
  <ul class="finder-results" id="finder-results">
    {entries.map((entry) => (
      <li data-finder-entry={entry.id}>
        <article>
          <details class="finder-offer">
            <summary>
              <span class="finder-offer-summary"><strong>{entry.title}</strong><span data-finder-format-label>{[...new Set(entry.formats.map((format) => finderFormats.find((kind) => kind.id === format.kind)!.label))].join(" · ")}</span></span>
              <span class="finder-coach">{entry.coach.image && <img src={url(entry.coach.image)} alt="" width="40" height="40" loading="lazy" />}<span>{entry.coach.name}</span></span>
            </summary>
            <div class="finder-offer-detail">
              <h3>{entry.title}</h3>
              <p>{entry.description ?? "Inhalt und Rahmen werden im persönlichen Gespräch konkretisiert."}</p>
              <ul class="finder-formats">
                {entry.formats.map((format) => (
                  <li data-finder-format={format.id}>
                    {entry.formats.length > 1 && <h4>{format.title}</h4>}
                    {format.description && <p>{format.description}</p>}
                    <dl>
                      <div><dt>Zielgruppe</dt><dd>{format.audiences.map((id) => finderAudiences.find((audience) => audience.id === id)!.label).join(" · ")}</dd></div>
                      <div><dt>Format</dt><dd>{finderFormats.find((kind) => kind.id === format.kind)!.label}</dd></div>
                      <div><dt>Dauer</dt><dd>{finderDuration(format.duration)}</dd></div>
                    </dl>
                    <a class="text-link" href={coachRequestMailto(entry.coach.name, entry.formats.length > 1 ? `${entry.title} · ${format.title}` : entry.title)} aria-label={`${entry.title}${entry.formats.length > 1 ? ` · ${format.title}` : ""} bei ${entry.coach.name} per E-Mail anfragen`}>Unverbindlich anfragen <Icon name="arrow-right" size={18} /></a>
                  </li>
                ))}
              </ul>
              {entry.options.length > 0 && <p class="finder-options"><strong>Optionale Ergänzungen:</strong> {entry.options.join(" · ")}</p>}
              {entry.boundaries.map((boundary) => <p class="finder-boundary">{boundary}</p>)}
              <a class="text-link" href={url(entry.coach.profilePath)} data-finder-profile>Coachprofil ansehen <Icon name="arrow-right" size={18} /></a>
            </div>
          </details>
        </article>
      </li>
    ))}
  </ul>
  <div class="finder-empty" data-finder-empty hidden><h3>Für diese Auswahl ist noch kein Angebot aufgeführt.</h3><p>Wir klären gern, welche Begleitung zu Ihrem Anliegen passt.</p><a class="text-link" href={url("kontakt")}>Bedarf mit Janay besprechen <Icon name="arrow-right" size={18} /></a><a class="text-link" href={url("mindforge")}>Persönliche Begleitung bei Mindforge <Icon name="arrow-right" size={18} /></a></div>
  <button class="button button--ghost finder-more" type="button" data-finder-more hidden>Weitere Angebote anzeigen</button>
  <script is:inline type="application/json" data-finder-data set:html={JSON.stringify(entries).replace(/</g, "\\u003c")} />
</section>
<style is:inline>
  .offering-finder { margin-block: 48px 64px; border-top: 8px solid var(--color-pantone); padding-top: 28px; scroll-margin-top: 180px; }
  .offering-finder [hidden] { display: none !important; }
  .finder-heading { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 24px; margin-bottom: 28px; }
  .finder-heading h2 { font-size: 2rem; line-height: 1.25; margin: 10px 0 0; }
  .finder-heading p { margin-bottom: 0; }
  .finder-filters { background: var(--color-soft); padding: 24px; border-block: 1px solid var(--color-line); }
  .finder-filter-row { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 20px; }
  .finder-filters label { display: block; font-weight: 750; min-width: 0; }
  .finder-filters input[type="search"], .finder-filters select { display: block; width: 100%; min-width: 0; min-height: 48px; margin-top: 8px; border: 2px solid var(--color-line); background: white; color: var(--color-dark); padding: 10px 12px; border-radius: 4px; font: inherit; font-weight: 400; }
  .finder-filter-actions { display: flex; justify-content: space-between; align-items: start; gap: 24px; margin-top: 18px; }
  .finder-topics { flex: 1; min-width: 0; }
  .finder-topics summary { padding-block: 10px; cursor: pointer; font-weight: 750; min-height: 44px; }
  .finder-topic-options { padding-block: 16px; max-width: 800px; }
  .finder-topic-options fieldset { border: 0; padding: 20px 0 0; margin: 0; min-width: 0; }
  .finder-topic-options legend { font-weight: 750; padding-top: 20px; }
  .finder-topic-checks { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 20px; }
  .finder-topic-checks label { display: flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 400; cursor: pointer; }
  .finder-topic-checks input { width: 20px; height: 20px; flex-shrink: 0; accent-color: var(--color-pantone-deep); }
  .finder-reset { border: 0; background: transparent; color: var(--color-pantone-deep); font: inherit; font-weight: 750; text-decoration: underline; padding: 10px 0; min-height: 44px; cursor: pointer; }
  .finder-result-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; align-items: center; padding-block: 24px 16px; }
  .finder-result-heading p { font-weight: 750; margin: 0; }
  .finder-result-heading a, .offering-finder .text-link { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; }
  .finder-results { list-style: none; padding: 0; margin: 0; }
  .finder-results > li { border-top: 1px solid var(--color-line); }
  .finder-offer > summary { display: grid; grid-template-columns: minmax(0,1fr) minmax(200px,280px) 24px; align-items: center; gap: 24px; padding: 20px 0; cursor: pointer; list-style: none; }
  .finder-offer > summary::-webkit-details-marker { display: none; }
  .finder-offer > summary::after { content: "+"; font-size: 1.6rem; text-align: center; color: var(--color-pantone-deep); }
  .finder-offer[open] > summary::after { content: "−"; }
  .finder-offer-summary strong { display: block; font-size: 1.1rem; line-height: 1.45; }
  .finder-offer-summary > span { display: block; margin-top: 8px; color: var(--color-dark); font-size: .95rem; }
  .finder-coach { display: flex; align-items: center; gap: 12px; font-size: .95rem; }
  .finder-coach img { object-fit: cover; width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%; }
  .finder-offer-detail { padding: 0 0 28px; max-width: 900px; }
  .finder-offer-detail h3 { font-size: 1.3rem; line-height: 1.4; margin-bottom: 16px; }
  .finder-offer-detail h4 { font-size: 1.1rem; line-height: 1.4; }
  .finder-formats { padding: 0; list-style: none; }
  .finder-formats > li { border-top: 1px solid var(--color-line); padding-block: 20px; }
  .finder-formats dl { margin: 12px 0; }
  .finder-formats dl > div { display: grid; grid-template-columns: 120px minmax(0,1fr); gap: 16px; margin-block: 8px; }
  .finder-formats dt { font-weight: 750; }
  .finder-formats dd { margin: 0; }
  .finder-boundary { border-left: 3px solid var(--color-pantone); padding-left: 16px; font-size: .95rem; }
  .finder-empty { border-top: 1px solid var(--color-line); padding-block: 24px; }
  .finder-empty h3 { font-size: 1.3rem; line-height: 1.4; }
  .finder-empty a { margin-right: 24px; }
  .finder-more { margin-top: 20px; }
  .offering-finder :is(p,span,strong,h2,h3,h4,dd,a) { overflow-wrap: anywhere; min-width: 0; }
  .offering-finder :is(input,select,summary,button,a):focus-visible { outline: 3px solid var(--color-dark); outline-offset: 4px; }
  @media (max-width: 900px) { .finder-heading, .finder-filter-row { grid-template-columns: minmax(0,1fr); } .finder-offer > summary { grid-template-columns: minmax(0,1fr) 24px; gap: 12px 16px; } .finder-coach { grid-row: 2; } .finder-offer > summary::after { grid-column: 2; grid-row: 1 / span 2; } }
  @media (max-width: 520px) { .finder-filters { padding: 18px 14px; } .finder-filter-actions { flex-direction: column; gap: 8px; } .finder-topics { width: 100%; } .finder-topic-checks { grid-template-columns: minmax(0,1fr); } .finder-formats dl > div { grid-template-columns: minmax(0,1fr); gap: 2px; } }
</style>
<script>
  import { filterFinder, finderFormats, emptyFinderSelection, type FinderEntry, type FinderSelection } from "./offering-finder-model";
  document.querySelectorAll<HTMLElement>("[data-offering-finder]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-finder-form]")!;
    const entries: FinderEntry[] = JSON.parse(root.querySelector("[data-finder-data]")!.textContent!);
    const rows = [...root.querySelectorAll<HTMLElement>("[data-finder-entry]")];
    const more = root.querySelector<HTMLButtonElement>("[data-finder-more]")!;
    const status = root.querySelector<HTMLElement>("[data-finder-status]")!;
    let limit = 8;
    function render() {
      const values = new FormData(form);
      const selection: FinderSelection = { ...emptyFinderSelection(), query: String(values.get("query") ?? ""),
        audience: String(values.get("audience")), format: String(values.get("format")),
        category: values.get("category") as FinderSelection["category"], topics: values.getAll("topic").map(String) };
      const matches = filterFinder(entries, selection);
      const visible = new Map(matches.slice(0, limit).map((match) => [match.entry.id, match.formats.map((format) => format.id)]));
      rows.forEach((row) => {
        const ids = visible.get(row.dataset.finderEntry!);
        row.hidden = !ids;
        if (!ids) row.querySelector("details")!.open = false;
        const match = matches.find((item) => item.entry.id === row.dataset.finderEntry);
        if (match) row.querySelector("[data-finder-format-label]")!.textContent = [...new Set(match.formats.map((format) => finderFormats.find((kind) => kind.id === format.kind)!.label))].join(" · ");
        row.querySelectorAll<HTMLElement>("[data-finder-format]").forEach((item) => { item.hidden = !ids?.includes(item.dataset.finderFormat!); });
      });
      root.querySelector<HTMLElement>("[data-finder-empty]")!.hidden = matches.length !== 0;
      status.textContent = `${matches.length} passende Angebote${matches.length > limit ? ` · ${limit} angezeigt` : ""}`;
      more.hidden = matches.length <= limit;
    }
    form.addEventListener("submit", (event) => event.preventDefault());
    form.addEventListener("input", () => { limit = 8; render(); });
    form.addEventListener("reset", (event) => {
      event.preventDefault();
      form.querySelector<HTMLInputElement>('input[type="search"]')!.value = "";
      form.querySelectorAll<HTMLSelectElement>("select").forEach((select) => { select.value = "all"; });
      form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((input) => { input.checked = false; });
      form.querySelector("details")!.open = false;
      limit = 8; render();
    });
    more.addEventListener("click", () => {
      const count = rows.filter((row) => !row.hidden).length;
      limit += 8; render();
      rows.filter((row) => !row.hidden)[count]?.querySelector("summary")?.focus();
    });
    form.hidden = false;
    render();
  });
</script>
