# Install only after DNS, TLS paths, internal port and production approval are set.
server {
    listen 80;
    listen [::]:80;
    server_name __APP_HOSTNAME__;
    return 301 https://__APP_HOSTNAME__$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __APP_HOSTNAME__;
    server_tokens off;

    ssl_certificate __TLS_FULLCHAIN_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 32k;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
